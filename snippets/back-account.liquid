{%- capture membership_tier -%}{%- render 'customer-membership-tier' -%}{%- endcapture -%}
{%- assign membership_tier = membership_tier | strip -%}

<div
  class="
    back-account wb-grid pb-1 pt-8
    {% if request.path contains 'apps/retextion' %} stay-ai grid-flow-col auto-cols-[minmax(1rem,1fr)_minmax(0px,1200px)_minmax(1rem,1fr)] bg-[#fbf2ec]{% endif %}
    {% if request.path contains 'community/membership' %} membership-account bg-[#f2f2f3] [&~.inveterate.inveterate\_\_loading]:bg-[#f2f2f3]{% endif %}
  "
>
  {% if request.path contains 'apps/retextion' %}<span></span>{% endif %}

  <div class="back-account__container [container:Stay-root/inline-size]{% if request.path contains 'community/membership' %} w-full max-w-[1436px] px-[130px] mx-auto{% endif %}">
    <a href="{{ routes.account_url }}" class="back-account__link inline-flex items-center gap-1.5 font-bold text-espresso! hover:text-gold! transition-colors duration-300" title="{{ 'customer.order.back_to_account' | t }}">
      <span class="back-account__icon inline-block rotate-180 size-4">
        {{- 'icon-arrow.svg' | inline_asset_content -}}
      </span>
      <span>{{ 'customer.order.back_to_account' | t }}</span>
    </a>
  </div>

  {% if request.path contains 'apps/retextion' %}<span></span>{% endif %}
</div>

{% stylesheet %}
  .back-account:has(~ .inveterate__tiers .inveterate__hero) {
    background-color: #fbf2ec;
  }
{% endstylesheet %}

{%- if request.path contains 'community/membership' -%}
  {%- comment -%}
    Deep-link support: opening the portal with #change-plan jumps straight to the
    "Change plan" (tier-selection) view. Inveterate has no native URL for this, so we
    flip its reactive view state once the app has finished loading. See also the
    #change-plan links in customer-dashboard.liquid.
  {%- endcomment -%}
  <script>
    (function () {
      function ready() {
        return window.inveterate
          && window.inveterate.scriptsFinished
          && window.inveterate.member
          && window.inveterate.member.viewController;
      }
      function openChangePlan() {
        if (location.hash !== '#change-plan') return;
        var tries = 0;
        (function poll() {
          if (ready()) {
            window.inveterate.member.viewController.currentView = 'tier-selection';
          } else if (tries++ < 200) {
            setTimeout(poll, 150);
          }
        })();
      }
      openChangePlan();
      document.addEventListener('DOMContentLoaded', openChangePlan);
      window.addEventListener('load', openChangePlan);
      window.addEventListener('hashchange', openChangePlan);
    })();
  </script>
{%- endif -%}

{%- if customer -%}
  {%- if membership_tier == 'VIP' or membership_tier == 'ELITE' -%}
    {% style %}
      .inveterate .inveterate__hero__caption {
        display: none;
      }

      .inveterate .inveterate__pricing.program-tiers .inveterate__pricing__blocks .inveterate__pricing__block:first-child .inveterate__pricing__block__footer {
        display: none;
      }
    {% endstyle %}
  {%- endif -%}
{%- endif -%}
