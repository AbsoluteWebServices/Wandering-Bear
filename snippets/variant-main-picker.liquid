{%- doc -%}
  Renders a default variant picker, used to display the variant picker in the variants block.

  @param {object} product_resource - The product object.
  @param {object} [block] - The block object
  @param {object} section - The section object.
  @param {object} product - The current product object (used to determine selected variant state).
{%- enddoc -%}

{% assign block_settings = block.settings %}

{% unless product_resource.has_only_default_variant %}
  {% liquid
    assign button_background_brightness = section.settings.color_scheme.settings.foreground | color_brightness
    if button_background_brightness < 105
      assign strikethrough_color_mix = '#000'
    else
      assign strikethrough_color_mix = '#fff'
    endif
  %}
  <variant-picker
    class="variant-picker spacing-style variant-picker--{{ block_settings.alignment }}
    {% if block_settings.variant_style == 'dropdowns' %} !pb-5.5 {% endif %}"
    style="--color-strikethrough-mix: {{ strikethrough_color_mix }}; {% render 'spacing-style', settings: block_settings %}"
    data-section-id="{{ section.id }}"
    data-product-id="{{ product_resource.id }}"
    data-block-id="{{ block.id }}"
    data-product-url="{{ product_resource.url }}"
    data-native-wiring="true"
    ref="mainVariantPicker"
    {% if product.id == product_resource.id %}
      data-template-product-match="true"
    {% endif %}
    {{ block.shopify_attributes }}
    {% if request.visual_preview_mode %}
      data-shopify-visual-preview
    {% endif %}
  >
    <form class="variant-picker__form">
      {%- for product_option in product_resource.options_with_values -%}
        {%- liquid
          assign swatch_count = product_option.values | map: 'swatch' | compact | size
          assign variant_style = block_settings.variant_style

          if swatch_count > 0 and block_settings.show_swatches
            if block_settings.variant_style == 'dropdown'
              assign variant_style = 'swatch_dropdown'
            else
              assign variant_style = 'swatch'
            endif
          endif

          if variant_style == 'buttons' and settings.variant_button_width == 'equal-width-buttons'
            assign fieldset_id = section.id | append: '-' | append: product_resource.id | append: '-' | append: product_option.name | handleize
            assign option_id_attribute = 'data-option-id="' | append: fieldset_id | append: '"'
            assign longest_value = 0
          endif
        -%}

        {%- if product_option.values.size == 1 and variant_style != 'swatch' -%}
          <div
            class="variant-option"
            data-testid="variant-option-single"
          >
            {{- product_option.name | escape -}}
            <span
              class="variant-option__swatch-value"
              data-testid="variant-option-single-value"
            >
              {{- product_option.selected_value -}}
            </span>
          </div>
        {%- elsif variant_style == 'swatch' or block_settings.variant_style == 'buttons' -%}
          {%- assign fieldset_index = forloop.index0 -%}
          <fieldset
            class="variant-option variant-option--buttons{% if variant_style == 'swatch' %} variant-option--swatches{% else %} variant-option--{{ settings.variant_button_width }}{% endif %}"
            data-fieldset-index="{{ fieldset_index }}"
            ref="fieldsets[]"
            {{ option_id_attribute }}
          >
            <legend>
              {{ product_option.name | escape -}}
              {%- if variant_style == 'swatch' -%}
                <span class="variant-option__swatch-value">{{ product_option.selected_value }}</span>
              {%- endif %}
            </legend>
            {%- for product_option_value in product_option.values -%}
              {% if product_option_value.size > longest_value and option_id_attribute %}
                {% assign longest_value = product_option_value.size %}
              {% endif %}
              <label
                class="variant-option__button-label{% if variant_style == 'swatch' %} variant-option__button-label--has-swatch{% endif %}"
              >
                <input
                  type="radio"
                  name="{{ product_option.name | escape }}-{{ block.id }}-{{ product_resource.id }}"
                  value="{{ product_option_value | escape }}"
                  aria-label="{{ product_option_value.name | escape }}{% if product_option_value.available == false %} - {{ 'products.product.sold_out' | t }}{% endif %}"
                  {% if product_option_value.available == false %}
                    aria-disabled="true"
                  {% endif %}
                  data-previous-checked="false"
                  data-fieldset-index="{{ fieldset_index }}"
                  data-input-index="{{ forloop.index0 }}"
                  data-input-id="{{ product_option.position }}-{{ forloop.index0 }}"
                  data-option-value-id="{{ product_option_value.id }}"
                  data-option-available="{{ product_option_value.available }}"
                  data-connected-product-url="{{ product_option_value.product_url }}"
                  {% if product_option_value.variant.id %}
                    data-variant-id="{{ product_option_value.variant.id }}"
                  {% endif %}
                  {% if product_option_value.variant.featured_media.position %}
                    data-featured-media-position="{{ product_option_value.variant.featured_media.position }}"
                  {% endif %}
                  {% if product_option_value.selected %}
                    data-current-checked="true"
                    checked
                  {% else %}
                    data-current-checked="false"
                  {% endif %}
                >
                {% if variant_style == 'swatch' %}
                  {% liquid
                    assign featured_media = product_option_value.variant.featured_media

                    # If the variant has no featured media, and we have a combined listing product, then fall back to
                    # using the featured media of the child product that is linked to this option value.
                    if featured_media == blank and product_option_value.product_url
                      assign featured_media = product_option_value.variant.product.featured_media
                    endif
                  %}

                  {% render 'swatch',
                    swatch: product_option_value.swatch,
                    variant_image: featured_media,
                    mode: 'unscaled'
                  %}
                {% else %}
                  {% if product_option_value.available == true %}
                    <span
                      class="variant-option__button-label__pill"
                      data-key="variant-option-pill"
                    ></span>
                  {% endif %}
                  <span
                    class="variant-option__button-label__text"
                    data-key="variant-option-text"
                  >
                    {{- product_option_value | escape -}}
                  </span>
                {% endif %}
                {% render 'strikethrough-variant', product_option: product_option_value %}
              </label>
            {%- endfor -%}
            {% if option_id_attribute %}
              {% style %}
                [data-option-id="{{ fieldset_id }}"] {
                  --variant-ch: {{ longest_value | times: 0.65 }}em;
                }
              {% endstyle %}
            {% endif %}
          </fieldset>
        {%- elsif block_settings.variant_style == 'dropdowns' -%}
          {%- comment -%}
            Accessible custom dropdown (WAI-ARIA listbox). The visible trigger + role="listbox"
            options are driven by hidden radio inputs that carry the same data attributes as the
            "buttons" style, so the native <variant-picker> change wiring (variant-picker.js)
            handles the actual variant update. Behaviour is enhanced by assets/variant-select.js.
          {%- endcomment -%}
          {%- assign fieldset_index = forloop.index0 -%}
          {%- assign vs_base = 'VariantSelect-' | append: block.id | append: '-' | append: forloop.index0 -%}

          <div class="variant-option variant-option--dropdowns">
            <span
              class="variant-option__label font-gothic__condensed text-bear-black text-base uppercase"
              id="{{ vs_base }}-label"
            >
            {% if product_option.name == 'Size' or product_option.name == 'Color' or product_option.name == 'Value' %}
              Select
            {% endif %}
              {{- product_option.name | escape -}}
            </span>
 
            <div
              class="variant-select"
              data-variant-select
            >
              <button
                type="button"
                class="variant-select__trigger"
                id="{{ vs_base }}-trigger"
                aria-haspopup="listbox"
                aria-expanded="false"
                aria-controls="{{ vs_base }}-listbox"
                aria-labelledby="{{ vs_base }}-label {{ vs_base }}-value"
                data-variant-select-trigger
              >
                <span
                  class="variant-select__value"
                  id="{{ vs_base }}-value"
                  data-variant-select-value
                >
                  {{- product_option.selected_value -}}
                </span>
                  {%- render 'icons', icon: 'chevron-down', class: 'dropdown-indicator transition-transform duration-200' -%}
              </button>
              <fieldset
                class="variant-select__listbox"
                id="{{ vs_base }}-listbox"
                role="listbox"
                aria-labelledby="{{ vs_base }}-label"
                ref="fieldsets[]"
                data-fieldset-index="{{ fieldset_index }}"
                data-variant-select-listbox
              >
                <legend class="visually-hidden" aria-hidden="true">{{ product_option.name | escape }}</legend>
                {%- for product_option_value in product_option.values -%}
                  <label
                    class="variant-select__option{% if product_option_value.available == false %} variant-select__option--unavailable{% endif %}"
                    id="{{ vs_base }}-opt-{{ forloop.index0 }}"
                    role="option"
                    aria-selected="{% if product_option_value.selected %}true{% else %}false{% endif %}"
                    tabindex="{% if product_option_value.selected %}0{% else %}-1{% endif %}"
                    data-variant-select-option
                    data-value-text="{{ product_option_value | escape }}"
                  >
                    <input
                      type="radio"
                      class="variant-select__input visually-hidden"
                      aria-hidden="true"
                      tabindex="-1"
                      name="{{ product_option.name | escape }}-{{ block.id }}-{{ product_resource.id }}"
                      value="{{ product_option_value | escape }}"
                      data-previous-checked="false"
                      data-fieldset-index="{{ fieldset_index }}"
                      data-input-index="{{ forloop.index0 }}"
                      data-input-id="{{ product_option.position }}-{{ forloop.index0 }}"
                      data-option-value-id="{{ product_option_value.id }}"
                      data-option-available="{{ product_option_value.available }}"
                      data-connected-product-url="{{ product_option_value.product_url }}"
                      {% if product_option_value.variant.id %}
                        data-variant-id="{{ product_option_value.variant.id }}"
                      {% endif %}
                      {% if product_option_value.variant.featured_media.position %}
                        data-featured-media-position="{{ product_option_value.variant.featured_media.position }}"
                      {% endif %}
                      {% if product_option_value.selected %}
                        data-current-checked="true"
                        checked
                      {% else %}
                        data-current-checked="false"
                      {% endif %}
                    >
                    <span class="variant-select__option-text">{{- product_option_value | escape -}}</span>
                  </label>
                {%- endfor -%}
              </fieldset>
            </div>
          </div>
        {%- endif -%}
      {%- endfor -%}

      <script type="application/json">
        {{ product_resource.selected_or_first_available_variant | json }}
      </script>
    </form>
  </variant-picker>
  <script src="{{ 'variant-media-bridge.js' | asset_url }}" type="module" fetchpriority="low"></script>
{% endunless %}

{% stylesheet %}
  /* Custom accessible dropdown (listbox) */
  .variant-option--dropdowns {
    display: flex;
    flex-direction: column;
    gap: var(--margin-2xs);
  }

  .variant-option__label {
    display: block;
    font-family: var(--font-gothic__condensed, 'Gothic Condensed');
    font-weight: 800;
  }

  .variant-select {
    position: relative;
    width: 100%;
  }

  .variant-select__input.visually-hidden {
    appearance: none !important;
    position: absolute !important;
    left: 0 !important;
    top: 0 !important;
    width: 100% !important;
    height: 100% !important;
    opacity: 0 !important;
    z-index: -1 !important;
  }

  .variant-select__trigger {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--gap-sm);
    width: 100%;
    margin: 0;
    padding: var(--padding-md) var(--padding-lg);
    font: inherit;
    text-align: start;
    color: var(--color-foreground);
    background-color: var(--color-background);
    border: var(--style-border-width-inputs) solid #CFBDB1;
    border-radius: var(--style-border-radius-inputs);
    cursor: pointer;
  }

  .variant-select__trigger:focus-visible {
    outline: var(--focus-outline-width) solid currentcolor;
    outline-offset: var(--focus-outline-offset);
  }

  .variant-select__value {
    font-family: var(--font-gothic__condensed, 'Gothic Condensed');
    font-weight: 800;
    color: var(--color-bear-black);
    font-size: 16px;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    text-transform: uppercase;
  }

  /* Gift card: no amount chosen yet — show the placeholder muted until the shopper picks. */
  .variant-select__value--placeholder {
    color: rgb(var(--color-foreground-rgb) / var(--opacity-subdued-text, 0.6));
  }

  .variant-select__caret {
    flex-shrink: 0;
    width: var(--icon-size-2xs);
    height: var(--icon-size-2xs);
    transition: transform var(--animation-speed, 0.2s) var(--animation-easing, ease);
  }

  .variant-select__trigger[aria-expanded='true'] .variant-select__caret {
    transform: rotate(180deg);
  }

  .variant-select__listbox {
    /* reset <fieldset> defaults */
    margin: 0;
    border: 0;
    min-inline-size: 0;

    position: absolute;
    top: calc(100% - 4px);
    left: 0;
    right: 0;
    z-index: 5;
    display: flex;
    flex-direction: column;
    max-height: 320px;
    overflow-y: auto;
    color: var(--color-foreground);
    background-color: var(--color-background);
    border: 1px solid #CFBDB1;
    border-radius: 0px 0px 5px 5px;
    opacity: 0;
    visibility: hidden;
    transform: translateY(-4px);
    transition: opacity var(--animation-speed, 0.2s) var(--animation-easing, ease),
      transform var(--animation-speed, 0.2s) var(--animation-easing, ease),
      visibility var(--animation-speed, 0.2s) var(--animation-easing, ease);
  }

  .variant-select--open .dropdown-indicator {
    transform: rotate(180deg);
  }

  .variant-select--open .variant-select__listbox {
    opacity: 1;
    visibility: visible;
    transform: none;
  }

  .variant-select__option {
    display: flex;
    align-items: center;
    gap: var(--gap-sm);
    padding: var(--padding-sm) var(--padding-md);
    cursor: pointer;
     
    &:not(:last-of-type) {
      border-bottom: 1px solid #CFBDB1;
    }
  }

  .variant-select__option:hover {
    background-color: rgb(var(--color-foreground-rgb) / var(--opacity-8, 0.08));
  }

  .variant-select__option:focus-visible {
    outline: var(--focus-outline-width) solid currentcolor;
    outline-offset: calc(var(--focus-outline-offset) * -1);
  }

  .variant-select__option[aria-selected='true'] {
    font-weight: 500;
  }

  .variant-select__option-text {
    flex: 1 1 auto;
    font-family: var(--font-gothic__condensed, 'Gothic Condensed');
    font-weight: 800;
    color: var(--color-bear-black);
    font-size: 16px;
    text-transform: uppercase;
  }

  .variant-select__option-status {
    flex-shrink: 0;
    color: var(--color-foreground-muted, rgb(var(--color-foreground-rgb) / var(--opacity-subdued-text, 0.6)));
    font-size: var(--font-paragraph-small--size);
  }

  .variant-select__option--unavailable .variant-select__option-text {
    opacity: 0.6;
  }

  .variant-select__check {
    flex-shrink: 0;
    width: var(--icon-size-2xs);
    height: var(--icon-size-2xs);
    visibility: hidden;
  }

  .variant-select__option[aria-selected='true'] .variant-select__check {
    visibility: visible;
  }

  @media (prefers-reduced-motion: reduce) {
    .variant-select__caret,
    .variant-select__listbox {
      transition: none;
    }
  }

  /* Variant picker container styles - unique to main variant picker */
  .variant-picker {
    width: 100%;
  }

  .variant-picker__form {
    width: 100%;
  }

  .variant-picker[data-shopify-visual-preview] {
    min-width: 300px;
    padding-inline-start: max(4px, var(--padding-inline-start));
  }

  /* Dropdown variant option styles */
  .variant-option__select-wrapper {
    display: flex;
    position: relative;
    border: var(--style-border-width-inputs) solid var(--color-border);
    border-radius: var(--style-border-radius-inputs);
    align-items: center;
    margin-top: var(--margin-2xs);
    overflow: clip;
  }

  .variant-option__select-wrapper:has(.swatch) {
    --variant-picker-swatch-width: 20px;
    --variant-picker-swatch-height: 20px;
  }

  .variant-option__select-wrapper:hover {
    border-color: var(--color-variant-hover-border);
  }

  .variant-option__select:focus-visible {
    outline: var(--focus-outline-width) solid currentcolor;
    outline-offset: var(--focus-outline-offset);
  }

  .variant-option__select {
    padding-block: var(--padding-md);
    padding-inline: var(--padding-lg) calc(var(--padding-lg) + var(--icon-size-2xs));
    appearance: none;
    border: 0;
    width: 100%;
    margin: 0;
    cursor: pointer;
  }

  .variant-option__select-wrapper .icon {
    position: absolute;
    right: var(--padding-md);
    top: 50%;
    transform: translateY(-50%);
    width: var(--icon-size-2xs);
    height: var(--icon-size-2xs);
    pointer-events: none;
  }

  .variant-option__select--has-swatch {
    padding-inline-start: calc((2 * var(--padding-sm)) + var(--variant-picker-swatch-width));
  }

  .variant-option__select-wrapper .swatch {
    position: absolute;
    top: 50%;
    left: var(--padding-md);
    transform: translateY(-50%);
  }

  /* Variant picker alignment modifiers */
  .variant-picker--center,
  .variant-picker--center .variant-option {
    text-align: center;
    align-items: center;
    justify-content: center;
    width: 100%;
  }

  .variant-picker--right,
  .variant-picker--right .variant-option {
    text-align: right;
    justify-content: right;
  }
{% endstylesheet %}
