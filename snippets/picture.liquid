{%- doc -%}
    Renders a picture element with the given source and sources.
    @param {object} source - The source image
    @param {object} [sources] - The sources for the picture element (optional)
    @param {object} [tablet_source] - The tablet source image (optional)
    @param {object} [mobile_source] - The mobile source image (optional)
    @param {string} [class] - The class for the picture element (optional)
    @param {string} [loading] - The loading attribute for the picture element (optional)
    @param {string} [preload] - The preload attribute for the picture element (optional)
    @param {number} [width] - The width of the image (optional)
    @param {number} [height] - The height of the image (optional)
    @param {string} [alt] - The alt text for the image (optional)
    @param {string} [image_classes] - The classes for the image element (optional)
    @param {string} [hover_image_classes] - The classes for the hover image element (optional)
    @param {string} [fetchpriority] - The fetchpriority attribute for the picture element (optional)
    @param {object} [hover_source] - The hover source image (optional)
{%- enddoc -%}

{% assign image_classes = image_classes | default: '' %}
{% assign hover_image_classes = hover_image_classes | default: '' %}

{% liquid
    assign desktop_source = source
    assign resolved_mobile = mobile_source
    if resolved_mobile == blank
        assign resolved_mobile = desktop_source
    endif
    assign resolved_tablet = tablet_source
    if resolved_tablet == blank
        assign resolved_tablet = mobile_source
    endif
    if resolved_tablet == blank
        assign resolved_tablet = desktop_source
    endif
%}

{% capture picture_sources %}
{% if sources %}
    {{ sources }}
{% else %}
    <source srcset="{{ source | image_url: width: 1920 }}" media="(min-width: 1920px)">
    <source srcset="{{ source | image_url: width: 1440 }}" media="(min-width: 1440px)">
    <source srcset="{{ source | image_url: width: 1200 }}" media="(min-width: 1200px)">
    <source srcset="{{ source | image_url: width: 1920 }}" media="(min-width: 1024px)">
    {% if tablet_source %}
        <source srcset="{{ tablet_source | image_url: width: 768 }}" media="(min-width: 768px)">
    {% else %}
        <source srcset="{{ source | image_url: width: 768 }}" media="(min-width: 768px)">
    {% endif %}
    {% if mobile_source %}
        <source srcset="{{ mobile_source | image_url: width: 500 }} 1x, {{ mobile_source | image_url: width: 1000 }} 2x, {{ mobile_source | image_url: width: 1500 }} 3x" media="(max-width: 480px)">
        <source srcset="{{ mobile_source | image_url: width: 767 }} 1x, {{ mobile_source | image_url: width: 1534 }} 2x, {{ mobile_source | image_url: width: 2048 }} 3x" media="(max-width: 767px)">
    {% else %}
        <source srcset="{{ source | image_url: width: 500 }} 1x, {{ source | image_url: width: 1000 }} 2x, {{ source | image_url: width: 1500 }} 3x" media="(max-width: 480px)">
        <source srcset="{{ source | image_url: width: 767 }} 1x, {{ source | image_url: width: 1534 }} 2x, {{ source | image_url: width: 2048 }} 3x" media="(max-width: 767px)">
    {% endif %}
{% endif %}
{% endcapture %}

{% if loading %}
    {% assign loading = loading %}
{% else %}
    {% assign loading = 'lazy' %}
{% endif %}

{% if alt %}
    {% assign alt = alt %}
{% else %}
    {% assign alt = desktop_source.alt %}
{% endif %}

{% liquid
    assign base_source = source
    if base_source == blank
        assign base_source = resolved_mobile
    endif
    if width == blank
        assign width = base_source.width
    endif
    if height == blank
        assign height = base_source.height
    endif
%}

{% capture img_parameters %}
    loading="{{ loading }}"
    {% if preload %}
      preload="{{ preload }}"
    {% endif %}
    alt="{{ alt }}"
    {% if fetchpriority %}
      fetchpriority="{{ fetchpriority }}"
    {% endif %}
{% endcapture %}

<picture>
    {{ picture_sources }}
    <img src="{{ base_source | image_url: width: width }}" width="{{ width }}" height="{{ height }}" {{ img_parameters }} class="{{ class }} {{ image_classes }}">
</picture>
{% if hover_source %}
    <img src="{{ hover_source | image_url: width: hover_source.width }}" width="{{ hover_source.width }}" height="{{ hover_source.height }}" {{ img_parameters }} class="{{ hover_image_classes }}">
{% endif %}