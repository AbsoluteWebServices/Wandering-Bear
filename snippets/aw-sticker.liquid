{%- doc -%}
  Absolutely-positioned sticker (image with a tilt), used across the About Us page.
  All offsets are percentages of the section box so it scales with the layout; desktop and
  mobile take separate values, defaulting to the desktop ones.

  @param {object} block - a "sticker" block whose settings drive the image and placement
{%- enddoc -%}

{%- liquid
  assign s = block.settings
  assign top_m = s.top_mobile | default: s.top
  assign left_m = s.left_mobile | default: s.left
  assign width_m = s.width_mobile | default: s.width
  assign rotate_m = s.rotate_mobile | default: s.rotate
  # Figma rotation is CCW-positive; CSS rotate is CW-positive. Flip the sign so the values in
  # the editor read the same as Figma.
  assign rot_css = 0 | minus: s.rotate
  assign rot_m_css = 0 | minus: rotate_m
  # Anchor offset for translate(): defaults centre the sticker on its top/left point (-50/-50),
  # but can be tweaked to nudge it off that anchor without moving the anchor itself.
  assign tx = s.tx | default: -50
  assign ty = s.ty | default: -50
  assign tx_m = s.tx_mobile | default: tx
  assign ty_m = s.ty_mobile | default: ty

  # Desktop size/offset in px. A % width is a share of the parent, so a sticker shrinks along with
  # the layout and turns illegible on a laptop; width_px pins it instead. Because translate()
  # percentages resolve against the element's OWN size, a px width would otherwise shift the sticker
  # as it grows — tx_px / ty_px keep the anchor independent of the size.
  assign w_css = s.width | append: '%'
  if s.width_px != blank
    assign w_css = s.width_px | append: 'px'
  endif
  # Same story for the anchor point itself: a % left/top resolves against the sticker's positioned
  # ancestor, and on About Us that ancestor is a plate whose width tracks the viewport — so the
  # sticker drifts sideways on a wide screen. left_px / top_px pin it to the plate's edge instead.
  assign left_css = s.left | append: '%'
  assign top_css = s.top | append: '%'
  if s.left_px != blank
    assign left_css = s.left_px | append: 'px'
  endif
  if s.top_px != blank
    assign top_css = s.top_px | append: 'px'
  endif
  assign tx_css = tx | append: '%'
  assign ty_css = ty | append: '%'
  if s.tx_px != blank
    assign tx_css = s.tx_px | append: 'px'
  endif
  if s.ty_px != blank
    assign ty_css = s.ty_px | append: 'px'
  endif
-%}

{%- liquid
  assign sticker_src = ''
  if s.image != blank
    assign sticker_src = s.image | image_url: width: 600
  elsif s.preview_asset != blank
    assign sticker_src = s.preview_asset | asset_url
  endif

  # A desktop-only sticker is revealed from the smd breakpoint (750px) up. When it is also meant to
  # stay hidden on tablet, that is the same thing as revealing it from md (1024px) instead, so raise
  # the breakpoint rather than overriding it: Tailwind's smd:!block lives in @layer utilities, and
  # for !important declarations the cascade reverses layer order — a layered !important beats an
  # unlayered one at any specificity, so a display:none of ours could never win against it.
  assign vis_class = ''
  if s.desktop_only
    assign vis_class = ' hidden smd:!block'
    if s.hide_tablet
      assign vis_class = ' hidden md:!block'
    endif
  elsif s.mobile_only
    assign vis_class = ' smd:!hidden'
  endif
-%}

{%- if sticker_src != blank -%}
  <img
    src="{{ sticker_src }}"
    alt="{{ s.image.alt }}"
    class="aw-sticker aw-sticker--{{ block.id }} absolute pointer-events-none select-none z-[3]{{ vis_class }}"
    loading="lazy"
    {{ block.shopify_attributes }}
  >
  {%- style -%}
    .aw-sticker--{{ block.id }} {
      top: {{ top_m }}%;
      left: {{ left_m }}%;
      width: {{ width_m }}%;
      transform: translate({{ tx_m }}%, {{ ty_m }}%) rotate({{ rot_m_css }}deg);
      {%- comment -%} Lift above neighbouring plates when a sticker straddles two sections. {%- endcomment -%}
      {% if s.z_index != blank %}z-index: {{ s.z_index }};{% endif %}
    }
    @media screen and (min-width: 750px) {
      .aw-sticker--{{ block.id }} {
        top: {{ top_css }};
        left: {{ left_css }};
        width: {{ w_css }};
        transform: translate({{ tx_css }}, {{ ty_css }}) rotate({{ rot_css }}deg);
      }
    }
    {%- comment -%}
      A desktop anchor pinned in px sits at the same distance from the left edge on a tablet, where
      the plate is far narrower — so the sticker lands off its mark. left_tablet overrides just that
      range; pass any CSS length or percentage.
    {%- endcomment -%}
    {%- if s.left_tablet != blank or s.top_tablet != blank or s.hide_tablet -%}
      @media screen and (min-width: 750px) and (max-width: 1023px) {
        .aw-sticker--{{ block.id }} {
          {%- comment -%}
            A desktop-only sticker is already kept off the tablet by its md: breakpoint class (see
            the vis_class note above); this covers the stickers that carry no visibility class.
          {%- endcomment -%}
          {% unless s.desktop_only %}{% if s.hide_tablet %}display: none !important;{% endif %}{% endunless %}
          {% if s.left_tablet != blank %}left: {{ s.left_tablet }};{% endif %}
          {% if s.top_tablet != blank %}top: {{ s.top_tablet }};{% endif %}
        }
      }
    {%- endif -%}
  {%- endstyle -%}
{%- endif -%}
