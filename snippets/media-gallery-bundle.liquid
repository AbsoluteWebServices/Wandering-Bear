{% capture slide_styles %}
    --width: 100%;
    --mobile-width: calc((100% - 1.2px) / 1.12);
    --mobile-margin-right: 10px;
{% endcapture %}
{% capture thumbnail_styles %}
    --desktop-margin-right: 10px;
    --desktop-width: calc((100% / 5) - 8px);
    --aspect-ratio: 1;
{% endcapture %}

{% if bundle_product == blank %}
    {% assign bundle_product = product %}
{% endif %}

{%  liquid 
    assign disable_gallery_background = disable_gallery_background | default: false

    if bundle_product.metafields.custom.new_product_photos != blank and bundle_product.metafields.custom.new_product_photos.value.size > 0
        assign product_media = bundle_product.metafields.custom.new_product_photos.value
    else 
        assign product_media = bundle_product.media
    endif

    assign simple_template = false
    if template.suffix == 'misc' or template.suffix == 'simple' or template.suffix == 'gift-card'
        assign simple_template = true
    endif


    if simple_template
        assign media_fit = 'contain'
    else
        assign media_fit = 'cover'
    endif
%}

{% style %}
    .media-fit {
        object-fit: {{ media_fit }};
    }
{% endstyle %}


<div data-media-gallery-bundle class="w-full overflow-hidden mx-auto md:mx-0 md:max-w-[570px]">
    <div class="flex flex-col gap-2 md:gap-4.25 md:!max-w-[570px]">
        <div class="swiper swiper-main product-gallery w-full lg:max-h-[540px] md:max-w-[570px] lg:aspect-[570/540]" x-ref="swiper">
            <div class="swiper-wrapper max-w-full max-h-full lg:max-h-[540px]">
                {% for media in product_media %}
                    <div
                        class="swiper-slide relative rounded-[5px] lg:max-h-[540px] overflow-hidden{% if disable_gallery_background != true %} before:content-[''] before:absolute before:left-0 before:top-0 before:w-full before:h-full before:bg-kraft/15 before:rounded-[5px] before:-z-1{% endif %}{% if media.height > media.width or media.height < media.width %}{% endif %}"
                        style="{{ slide_styles }}"
                    >
                     <div class="swiper-zoom-container max-w-full max-h-full lg:max-h-[540px] flex">
                        {% capture gallery_sources %}
                            <source
                                media="(min-width: 768px)"
                                srcset="{{ media | image_url: width: 570 }} 570w, {{ media | image_url: width: 855 }} 855w, {{ media | image_url: width: 1140 }} 1140w"
                                sizes="570px">
                            <source
                                srcset="{{ media | image_url: width: 400 }} 400w, {{ media | image_url: width: 550 }} 550w, {{ media | image_url: width: 700 }} 700w, {{ media | image_url: width: 850 }} 850w, {{ media | image_url: width: 1000 }} 1000w, {{ media | image_url: width: 1200 }} 1200w"
                                sizes="100vw">
                        {% endcapture %}
                        {%- comment -%}
                          Slide 1 is the LCP element: eager and high priority.

                          Slides 2-5 already inherit picture.liquid's `loading: lazy`, but
                          that alone does not stop them — the slides sit side by side in the
                          (overflow-hidden) track, so they are only a few hundred px from the
                          viewport and Chrome's lazy threshold fetches them anyway. That was
                          620KB of carousel loading alongside the LCP image. `fetchpriority`
                          cannot cancel the request but it does put them behind slide 1 in
                          the queue, so the LCP image is no longer competing with them.
                        {%- endcomment -%}
                        {% if forloop.first %}
                            {% render 'picture', source: media, sources: gallery_sources, class: 'max-w-full max-h-full w-full h-full media-fit object-center', style: 'object-position: center;', alt: media.alt, loading: 'eager', fetchpriority: 'high' %}
                        {% elsif forloop.index == 2 %}
                            {% render 'picture', source: media, sources: gallery_sources, class: 'max-w-full max-h-full w-full h-full media-fit object-center', style: 'object-position: center;', alt: media.alt, fetchpriority: 'low' %}
                        {% else %}
                            {% render 'picture', source: media, sources: gallery_sources, class: 'max-w-full max-h-full w-full h-full media-fit object-center', style: 'object-position: center;', alt: media.alt, loading: 'lazy', fetchpriority: 'low' %}
                        {% endif %}
                     </div>
                     <div class="zoom-toggle absolute bottom-4 right-4 w-6 h-6 cursor-pointer z-[2]">
                        {% render 'icons', icon: 'zoom-in', class: 'zoom-toggle__icon zoom-toggle__in' %}
                        {% render 'icons', icon: 'zoom-out', class: 'zoom-toggle__icon zoom-toggle__out' %}
                     </div>
                    </div>
                {% endfor %}
            </div>
        </div>
        <div class="swiper-thumbs w-full {% if hide_thumbnails_desktop %} block md:!max-w-[570px] lg:!hidden {% endif %}" x-ref="swiperThumbs">
            <div class="swiper-wrapper flex md:!max-w-[570px]">
                {% for media in product_media %}
                    <div
                        class="swiper-slide rounded-[5px] max-w-17 md:max-w-27 overflow-hidden cursor-pointer !aspect-square before:transition-all before:duration-300{% if forloop.first %} swiper-slide-thumb-active{% endif %}"
                        style="{{ thumbnail_styles }}"
                    >
                        {% liquid
                            assign thumb_alt = media.alt
                            if thumb_alt == blank
                                assign thumb_alt = bundle_product.title | append: ' thumbnail ' | append: forloop.index
                            endif
                        %}
                        {{ media | image_url: width: 600 | image_tag: widths: '100, 150, 220, 320', sizes: '(min-width: 768px) 108px, 68px', class: 'w-full !h-full media-fit object-center scale-[1.1]', style: 'object-position: center;', alt: thumb_alt }}
                    </div>
                {% endfor %}
            </div>
        </div>
    </div>
</div>

{% stylesheet %}
    .product-gallery:not(.swiper-initialized) .swiper-slide:nth-child(n+2) {
        display: none;
    }

    .product-gallery .swiper-slide {
        aspect-ratio: 1 / 1;
        display: flex;
        justify-content: center;
        align-items: center;
    }

    /* No height is reserved on .product-gallery itself: the slide carries a 1/1
       aspect-ratio and, because --mobile-width now matches what Swiper computes,
       the slide is the same size before and after init. The container's height
       follows from it in both states, so there is nothing left to shift. */
{% endstylesheet %}
