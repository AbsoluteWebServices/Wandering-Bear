{% doc %}
  Header Actions Component

  Renders the header actions.

  @param {object} [section] - The section object providing settings such as actions_font.
  @param {block} [block] - The block object, used for Shopify editor attributes.
  @param {string} [display_style] - Controls display mode for header actions: 'icon' or 'text'.
  @param {string} [customer_account_menu] - The menu handle passed to the shopify-account component.

  @example
  {% render 'header-actions', section: section %}
{% enddoc %}
<script
  type="module"
  src="{{ 'cart-icon.js' | asset_url }}"
  fetchpriority="low"
></script>

{% capture cart_icon %}
  <cart-icon
    class="header-actions__cart-icon flex justify-center items-center {% unless cart == empty %} header-actions__cart-icon--has-cart{% endunless %}"
    data-testid="cart-icon"
  >
    <span class="{% if display_style == 'icon' %}hidden{% else %}mobile:hidden{% endif %}">
      {{ 'content.cart_title' | t }}
    </span>

    <span
      class="svg-wrapper {% if display_style != 'icon' %}desktop:hidden{% endif %}"
      aria-hidden="true"
    >
      {% render 'icons', icon: 'cart' with class: 'h-9 w-[27px]' %}
    </span>

    {% render 'cart-bubble', limit: 100 %}
  </cart-icon>
{% endcapture %}

 
{%  
  liquid  
  assign total_original_price = 0
  assign total_price = 0
  assign savings_text = 'Total savings'
  assign is_autoship = false

  assign is_member = false
  assign member_tier = ''

  for tag in customer.tags
    case tag
      when 'inveterate-tier#72ccf378'
        assign member_tier = 'VIP'
      when 'inveterate-tier#dc38b982'
        assign member_tier = 'Elite'
      when 'inveterate-tier#99a431e2'
        assign member_tier = 'Elite'
    endcase
  endfor

  for item in cart.items
    if item.title contains 'Membership'
      assign is_member = true
      assign member_tier = 'Elite'
    endif
    assign quantified = false
    for tag in item.product.tags
      if tag contains 'custom-quantity-rule'
        assign quantified = true
      endif
    endfor

    if item.selling_plan_allocation
      assign is_autoship = true
    endif

    ## Total Savings Calculation ##

    if quantified
      if item.compare_at_price > item.price
        assign total_original_price = total_original_price | plus: item.compare_at_price | times: item.quantity
        assign total_price = total_price | plus: item.price | times: item.quantity
      else
        assign total_original_price = total_original_price | plus: item.product.variants.first.price | times: item.quantity
        assign total_price = total_price | plus: item.price | times: item.quantity
      endif
    elsif item.compare_at_price > item.price
      assign total_original_price = total_original_price | plus: item.compare_at_price
      assign total_price = total_price | plus: item.price
    else 
      assign total_original_price = total_original_price | plus: item.final_line_price
      assign total_price = total_price | plus: item.price
    endif
  endfor

  if is_member
    assign savings_text = 'Total membership savings'
  endif

  assign total_savings = total_original_price | minus: total_price

  unless is_autoship
    assign total_savings = total_savings | plus: cart.total_discounts
  endunless
%}


{% capture account_icon %}
  <svg
    xmlns="http://www.w3.org/2000/svg"
    width="15"
    height="17"
    viewBox="0 0 15 17"
    fill="none"
    slot="signed-out-avatar"
    class="account-button__icon"
  >
    <path
      stroke="currentColor"
      stroke-linejoin="round"
      stroke-width="var(--icon-stroke-width)"
      d="M10.375 3.813a3.063 3.063 0 1 1-6.125 0 3.063 3.063 0 0 1 6.125 0ZM7.313 9.5c-3.667 0-6.24 2.691-6.563 6.125h13.125C13.552 12.191 10.979 9.5 7.312 9.5Z"
    />
  </svg>
{% endcapture %}
<header-actions
    class="header-actions--text lg:!gap-[108px]"
  {{- block.shopify_attributes -}}
>
  {% if shop.customer_accounts_enabled %}
    {% liquid
      assign account_actions_style = ''
        assign actions_font = section.settings.actions_font | default: 'body'
        assign font_obj = settings.type_heading_font
        case actions_font
          when 'body'
            assign font_obj = settings.type_body_font
          when 'subheading'
            assign font_obj = settings.type_subheading_font
          when 'accent'
            assign font_obj = settings.type_accent_font
        endcase
        assign font_family = font_obj.family | append: ', ' | append: font_obj.fallback_families
        assign font_family_safe = font_family | replace: '"', "'"
        assign account_actions_style = '--header-actions-font-family: ' | append: font_family_safe | append: '; --header-actions-font-weight: ' | append: font_obj.weight | append: ';'
    %}
    <div
      class="hidden smd:!flex items-center gap-3 mt-[9px]"
    >
      <a href="{{ routes.account_url }}"
        {% if customer %}
          aria-label="Account"
        {% else %}
          aria-label="Login"
        {% endif %}
        menu="{{ customer_account_menu }}"
        class="uppercase text-lg font-kurdis-semi-condensed font-bold"
      >
        {% if customer %}
           <span>Account</span>
        {% else %}
           <span>Login</span>
        {% endif %}
      </a>
      <span class="flex -mt-1 font-bold text-lg">|</span>
      {% render 'membership-widget' %}
    </div>
  {% endif %}

  {% if settings.cart_type == 'drawer' and template.name != 'cart' %}
    <script
      src="{{ 'cart-drawer.js' | asset_url }}"
      type="module"
      fetchpriority="low"
    ></script>
    <script
      src="{{ 'cart-products.js' | asset_url }}"
      type="module"
      fetchpriority="low"
    ></script>
    <script
      src="{{ 'bundle-editor.js' | asset_url }}"
      type="module"
      fetchpriority="low"
    ></script>

    {% capture empty_cart_drawer_content %}
      {% render 'cart-header' %}

      <div
        data-cart-drawer-content
        class="cart-drawer__content !mt-[calc((100dvh/3)*1.5)]"
        aria-label="{{ 'accessibility.cart' | t }}"
      >
        <h2
          class="cart-drawer__heading h6 !mb-4.5 !text-bear-black mx-auto text-center mb-4.5 font-gothic_condensed !uppercase text-lg"
          id="cart-drawer-heading-empty"
        >
          {{ 'content.your_cart_is_empty' | t }}
        </h2>

        <div class="cart-drawer__items">
          {% render 'cart-products', force_empty: true %}
        </div>
      </div>
    {% endcapture %}

    
    <cart-drawer-component
      x-data="cart()"
      x-init="init()"
      class="cart-drawer{% if display_style == 'text' %} cart-drawer--text{% endif %}"
      {{ block.shopify_attributes }}
      {% if settings.auto_open_cart_drawer %}
        auto-open
      {% endif %}
    >
      <template id="empty-cart-template">
        {{ empty_cart_drawer_content }}
      </template>
      <button
        class="header-actions__action button-unstyled{% if display_style == 'text' %} header-actions__text-style{% endif %}"
        on:click="/open"
        aria-haspopup="dialog"
        {%- comment -%}
          Kept in sync by cart-drawer.js. Without it the trigger announces that it
          opens a dialog but never says whether that dialog is currently open.
        {%- endcomment -%}
        aria-expanded="false"
        data-cart-drawer-trigger
        aria-label="{{ 'accessibility.cart' | t }} ({{ cart.item_count }})"
        aria-describedby="cart-bubble-text"
        data-testid="cart-drawer-trigger"
      >
        {{ cart_icon }}
      </button>
      <dialog
      ref="dialog"
      class="cart-drawer__dialog dialog-modal dialog-drawer color-{{ settings.drawer_color_scheme }}{% if cart.empty? %} cart-drawer--empty{% endif %}"
      data-testid="cart-drawer-dialog"
      aria-labelledby="{% if cart.empty? %}cart-drawer-heading-empty{% else %}cart-drawer-heading{% endif %}"
      scroll-lock
      cart-summary-sticky="true"
    >
      <div>
        <span
          ref="liveRegion"
          class="visually-hidden"
          role="status"
        ></span>
    
        <div
          class="cart-drawer__inner"
          data-hydration-key="cart-drawer-inner"
        >
          {%- comment -%} Cart loading overlay.
              Shown via :has() when cart-products-component sets
             its .cart-items-disabled busy class (remove / selling-plan change) —
             no JS needed. High z-index so it sits above the frequency selects. {%- endcomment -%}
          <span class="cart-loading-overlay" aria-hidden="true" style="position:absolute;inset:0;display:flex;align-items:center;justify-content:center;opacity:0;pointer-events:none;">
            <span class="animate-spin rounded-full border-2 border-dashed border-espresso" style="width: 2rem; height: 2rem;"></span>
          </span>
          <div class="w-full">
            {% capture cart_items_children %}
              {%- if cart.empty? -%}
                {{ empty_cart_drawer_content }}
              {%- else -%}
    
                <div data-cart-view class="">
                  {% render 'cart-header' %}
    
                  <scroll-hint
                    class="cart-drawer__content"
                    aria-label="{{ 'accessibility.cart' | t }}"
                  >
                    <scroll-hint
                      class="cart-drawer__items !gap-3 pt-5.5"
                    >
                      {% render 'cart-products' %}
                    </scroll-hint>

                    <div class="cart-drawer__summary">
                      {% render 'aw-cart-summary', section_id: section.id, total_savings: total_savings, is_member: is_member, member_tier: member_tier, is_autoship: is_autoship %}

                      {% if total_savings > 0 %}
                        <div class="flex justify-center items-start text-xs font-kurdis-semi-condensed font-bold text-gold mb-5">
                              <span>{{ savings_text }}: {{ total_savings | money }}</span>
                        </div>
                      {% endif %}
                    </div>
                  </scroll-hint>
                </div>
    
              {%- endif -%}
            {% endcapture %}
    
            {% render 'cart-items-component',
              children: cart_items_children,
              is_drawer: true,
              section_id: section.id
            %}
          </div>
        </div>
      </div>

      <bundle-editor-component
        class="modify-bundle bg-[#F2E6DC] absolute top-0 right-0 bottom-0 left-0 z-1000"
        data-testid="bundle-editor"
      >
        <div data-bundle-panel class="h-full"></div>
      </bundle-editor-component>
    </dialog>
     
    </cart-drawer-component>
  {% else %}
    <a
      href="{{ routes.cart_url }}"
      class="header-actions__action action__cart{% if display_style == 'text' %} header-actions__text-style{% endif %}"
      aria-label="{{ 'accessibility.cart' | t }} ({{ cart.item_count }})"
      aria-describedby="cart-bubble-text"
    >
      {{ cart_icon }}
    </a>
  {% endif %}

  <span
    ref="liveRegion"
    class="visually-hidden"
    role="status"
    data-testid="cart-count-live-region"
  ></span>
</header-actions>

<script
  type="module"
  src="{{ 'header-actions.js' | asset_url }}"
  fetchpriority="low"
></script>

<script type="application/json" id="bundleDetails">
{
  {% for object in shop.metaobjects.product_group.values %}
    "{{ object.display_name | handleize }}": {
      "headline": {{ object.headline | json }},
      "plural_label": {{ object.plural_label | json }},
      "singular_label": {{ object.singular_label | json }},
      "collection_handle": {{ object.collection_handle | json }},
      "bundle_products": {
        {% for product in object.bundle_products.value %}
         "{{ forloop.index0 }}": {
            "title": {{ product.title | json }},
            "product_id": {{ product.id | json }},
            "variant_id": {{ product.variants.first.id | json }},
            {% for allocation in product.variants.first.selling_plan_allocations %}
              {% if allocation.selling_plan.name contains '1 month' or allocation.selling_plan.name contains '1 Month' %}
                "selling_plan_id": {{ allocation.selling_plan.id | json }}
                {% break %}
              {% endif %}
            {% endfor %}
          }{% unless forloop.last %},{% endunless %}
        {% endfor %}
      }
    }{% unless forloop.last %},{% endunless %}
  {% endfor %}
}
</script>

