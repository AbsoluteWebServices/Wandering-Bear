{% style %}
.recipe-video video {
    width: 100%;
    height: 100%;
    object-fit: cover;
}

.recipe-video .video-wrapper {
    .icon-play,
    .icon-pause {
        opacity: 0;
        transition: opacity 0.3s ease;
    }

    &:hover {
        .icon-play,
        .icon-pause {
            opacity: 1;
        }
    }
}

.recipe-video .icon-play,
.recipe-video .icon-pause {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    color: #fff;
    z-index: 2;
    pointer-events: none;

    svg {
        height: 80px !important;
        width: 80px !important;
    }
}
{% endstyle %}

<div x-data="VideoPlayer()" class="recipe-video relative overflow-hidden rounded-[10px] max-h-[488px] shadow-[0_4px_4px_0_rgba(0,0,0,0.25)]">
    <div @click="toggleSound()" class="absolute bottom-5 left-5 z-5 cursor-pointer">
        <span class="visually-hidden">Toggle Sound</span>
        <div class="flex items-center justify-center h-6 w-6 rounded-full bg-[rgba(249,222,88,0.7)] text-white">
            <div class="w-6 h-6 flex items-center justify-center">
                <span x-show="videoMuted" x-cloak class="block">
                    {% render 'icons', icon: 'mute' class: 'w-5 h-auto mt-1 -ml-0.5' %}
                </span>
                <span x-show="!videoMuted" x-cloak class="block">
                    {% render 'icons', icon: 'unmute' class: 'w-5 h-auto mt-1' %}
                </span>
            </div>
        </div>
    </div>
    <div @click="togglePlay()" class="video-wrapper h-full max-h-[488px] w-full relative wb-flex justify-center items-center group">
        <span class="icon-play hidden">
            {{- 'icon-play.svg' | inline_asset_content -}}
        </span>
        <span class="icon-pause">
            {{- 'icon-pause.svg' | inline_asset_content -}}
        </span>
        {% for source in video_sources %}
            {% if source.mime_type == 'video/mp4' %}
                <video
                    class="h-full w-full object-cover cursor-pointer"
                    autoplay
                    muted
                    loop
                    playsinline
                    webkit-playsinline
                    preload="auto"
                >
                    <source src="{{ source.url }}" type="{{ source.mime_type }}">
                </video>
                {% break %}
            {% endif %}
        {% endfor %}
    </div>
</div>