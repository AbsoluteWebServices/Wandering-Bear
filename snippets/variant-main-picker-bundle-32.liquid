{%- doc -%}
  Renders a default variant picker, used to display the variant picker in the variants block.

  @param {object} product_resource - The product object.
  @param {object} [block] - The block object
  @param {object} section - The section object.
  @param {object} product - The current product object (used to determine selected variant state).
  @param {array} bundle_products - The bundle products array.
{%- enddoc -%}

{% liquid
   assign selling_plan_keywords = blank
   assign multi_unit_product = false
   assign block_settings = block.settings
   assign bundle_collection = section.settings.bundle_collection
   assign first_product = bundle_collection.products.first
   assign product_object = product_resource.metafields.custom.product_group

   assign bundle_placeholder_image = section.settings.bundle_placeholder_image

   if first_product.selected_or_first_available_variant.compare_at_price > first_product.selected_or_first_available_variant.price
    assign compare_at_price = first_product.selected_or_first_available_variant.compare_at_price
   else
    assign compare_at_price = first_product.selected_or_first_available_variant.price
   endif

   assign bundle_products = product_object.value.bundle_products.value
   assign bundle_products_count = bundle_products.size
   assign headline = product_object.value.headline
   assign headline_size = product_object.value.headline
   assign singular_label = product_object.value.singular_label
   assign plural_label = product_object.value.plural_label
   assign selling_plan_keywords = product_object.value.selling_plan_keywords.value
   assign discount_type = product_object.value.discount_type
   assign col_width = 63

   if product_object.value.multi_unit_product_quantity != blank and product_object.value.multi_unit_product_quantity > 1
    assign multi_unit_product = true
    assign multi_unit_quantity = product_object.value.multi_unit_product_quantity
    assign multi_unit_product_unit = product_object.value.multi_unit_product_unit
    assign col_width = 121
   endif

   ## Prices ##
   ## Tier 1 = 3 cartons, Tier 2 = 6 cartons. Each tier is priced from the SKU that will
   ## actually be added: the 3-carton tier from `variants[0].metafields.custom.bundle_unit`
   ## (the mix / single-3 bundle unit), the 6-carton tier from the regular `variants[1]`
   ## (single-6 = the plain 6-pack). Displayed values are per carton.
   ## bundle_unit variants are already priced PER CARTON, so they need no division;
   ## a plain regular variant is a per-pack total and is divided by its carton count.
   assign t1_bu = first_product.variants[0].metafields.custom.bundle_unit.value
   if t1_bu != blank
    assign t1_src = t1_bu
    assign t1_divisor = 1
   else
    assign t1_src = first_product.variants[0]
    assign t1_divisor = 3
   endif

   ## 6-carton tier: the 6-carton sibling of the 3-carton bundle_unit (already per carton,
   ## the mix-6 price), else the regular 6-pack divided by its carton count.
   assign t2_bu6 = blank
   assign t1_bu_variant = first_product.variants[0].metafields.custom.bundle_unit.value
   if t1_bu_variant != blank
    for sib in t1_bu_variant.product.variants
     assign sib_t = sib.title | downcase
     if sib_t contains '6'
      assign t2_bu6 = sib
      break
     endif
    endfor
   endif
   if t2_bu6 != blank
    assign t2_src = t2_bu6
    assign t2_divisor = 1
   else
    assign t2_src = first_product.variants[1]
    assign t2_divisor = 6
   endif

   ## Per-carton one-time prices.
   assign tier_one_unit_price_otp = t1_src.price | times: 1.0 | divided_by: t1_divisor | round
   assign tier_two_unit_price_otp = t2_src.price | times: 1.0 | divided_by: t2_divisor | round

   ## Per-carton autoship prices from the 1 Month plan (fall back to the one-time price).
   assign t1_autoship_total = t1_src.price
   for alloc in t1_src.selling_plan_allocations
    if alloc.selling_plan.name contains '1 Month'
     assign t1_autoship_total = alloc.price
     break
    endif
   endfor
   assign tier_one_unit_price_autoship = t1_autoship_total | times: 1.0 | divided_by: t1_divisor | round

   assign t2_autoship_total = t2_src.price
   for alloc in t2_src.selling_plan_allocations
    if alloc.selling_plan.name contains '1 Month'
     assign t2_autoship_total = alloc.price
     break
    endif
   endfor
   assign tier_two_unit_price_autoship = t2_autoship_total | times: 1.0 | divided_by: t2_divisor | round

   ## Per-carton compare-at, used as the savings base for each tier.
   if t1_src.compare_at_price > t1_src.price
    assign tier_one_compare = t1_src.compare_at_price | times: 1.0 | divided_by: t1_divisor | round
   else
    assign tier_one_compare = tier_one_unit_price_otp
   endif
   if t2_src.compare_at_price > t2_src.price
    assign tier_two_compare = t2_src.compare_at_price | times: 1.0 | divided_by: t2_divisor | round
   else
    assign tier_two_compare = tier_two_unit_price_otp
   endif
%}

{% capture col_width_styles %}
  --col-width: {{ col_width }}px;
{% endcapture %}

{% style %}
  .col-width {
    width: var(--col-width);
  }
{% endstyle %}


<div class="flex flex-col {% if template.suffix == '32oz' %} gap-3.5 md:gap-4.5 mb-1 md:mb-6{% else %} gap-2.5 mb-6{% endif %}">
    <div class="flex flex-col">
    <span class="font-bold font-gothic_condensed text-bear-black block uppercase mb-1.5">Choose Quantity</span>
        <div class="bundle-32-option-grid wb-grid grid-cols-2 w-full h-[74px] border border-[#CFBDB1] rounded-[5px]">
            {% for i in (1..bundle_products_count) %}
              {%- case i -%}
                {%- when 1 -%}
                  {%- assign autoship_price = tier_one_unit_price_autoship -%}
                  {%- assign otp_price = tier_one_unit_price_otp -%}
                  {%- assign tier_compare = tier_one_compare -%}
                {%- when 2 -%}
                  {%- assign autoship_price = tier_two_unit_price_autoship -%}
                  {%- assign otp_price = tier_two_unit_price_otp -%}
                  {%- assign tier_compare = tier_two_compare -%}
              {%- endcase -%}
              {% assign qty = i | times: 3 %}
              {% if discount_type == 'Percentage' %}
                {% assign autoship_savings_raw = tier_compare | minus: autoship_price | times: 100.0 | divided_by: tier_compare | round %}
                {% assign otp_savings_raw = tier_compare | minus: otp_price | times: 100.0 | divided_by: tier_compare | round %}
                {% assign autoship_savings = autoship_savings_raw | append: '%' %}
                {% assign otp_savings = otp_savings_raw | append: '%' %}
              {% else %}
                {% assign autoship_savings_raw = tier_compare | minus: autoship_price %}
                {% assign otp_savings_raw = tier_compare | minus: otp_price %}
                {% assign autoship_savings = autoship_savings_raw | money %}
                {% assign otp_savings = otp_savings_raw | money %}
              {% endif %}

              <fieldset class="flex flex-col h-full w-full justify-center items-center">
                <input
                 @change="changeBundleQuantity({{ qty }})"
                 class="absolute! top-0 left-0 w-0 h-0 opacity-0 hidden peer"
                 x-model="bundleQty"
                 type="radio" name="bundle-qty" id="bundle-qty-{{ i }}" value="{{ qty }}" {% if forloop.first %}checked{% endif %}>
                <label class="{% if forloop.first %}rounded-tl-[5px] rounded-bl-[5px]{% else %}rounded-tr-[5px] rounded-br-[5px]{% endif %} peer-checked:bg-[#F9F3ED] relative h-full w-full wb-flex flex-col justify-center items-center hover:[&_.variant-option-name]:text-dark-gold hover:bg-foam! transition-colors duration-300" for="bundle-qty-{{ i }}">
                  <span class="variant-option-name font-gothic_condensed text-bear-black text-base font-bold uppercase transition-colors duration-300">{{ qty }} Cartons</span>
                  <span x-show="purchaseOption === 'autoship' || hasEliteItem" class="font-kurdis-semi-condensed text-[12px] text-bear-black font-semibold">From {{ autoship_price | money }}/carton</span>
                  <span x-cloak x-show="purchaseOption !== 'autoship' && !hasEliteItem" class="font-kurdis-semi-condensed text-[12px] text-bear-black font-semibold">From {{ otp_price | money }}/carton</span>
                  {% if autoship_savings_raw > 0 %}
                    <span x-show="purchaseOption === 'autoship' || hasEliteItem" class="font-kurdis-semi-condensed text-xs text-kraft font-semibold">Save {{ autoship_savings }}</span>
                  {% endif %}
                  {% if otp_savings_raw > 0 %}
                    <span x-cloak x-show="purchaseOption !== 'autoship' && !hasEliteItem" class="font-kurdis-semi-condensed text-xs text-kraft font-semibold">Save {{ otp_savings }}</span>
                  {% endif %}
                </label>
            </fieldset>
            {% endfor %}
        </div>
    </div>
    <div class="flex flex-col">
    <span class="font-bold font-gothic_condensed text-bear-black block uppercase mb-1.5">Choose Flavors</span>
        <div class="bundle-32-option-grid wb-grid grid-cols-2 w-full h-[74px] border border-[#CFBDB1] rounded-[5px]">
            <fieldset class="flex flex-col h-full w-full justify-center items-center">
                <input
                 @change="changeFlavorType('mix')"
                 x-model="flavorType"
                 class="absolute! top-0 left-0 w-0 h-0 opacity-0 hidden peer"
                 type="radio" name="bundle-flavor" id="bundle-flavor-mix" value="mix">
                <label class="rounded-tl-[5px] rounded-bl-[5px] peer-checked:bg-[#F9F3ED] relative h-full w-full wb-flex flex-col justify-center items-center hover:[&_.variant-option-name]:text-dark-gold hover:bg-foam! transition-colors duration-300" for="bundle-flavor-mix">
                  <span class="variant-option-name font-gothic_condensed text-bear-black text-base font-bold uppercase">Mix & Match</span>
                  <span class="font-kurdis-semi-condensed text-[12px] text-bear-black font-semibold transition-colors duration-300">Pick up to <span x-text="bundleQty">3</span> flavors</span>
                </label>
            </fieldset>
            <fieldset class="flex flex-col h-full w-full justify-center items-center">
                <input
                 @change="changeFlavorType('single')"
                 x-model="flavorType"
                 class="absolute! top-0 left-0 w-0 h-0 opacity-0 hidden peer"
                 type="radio" name="bundle-flavor" id="bundle-flavor-single" value="single" checked>
                <label class="rounded-tr-[5px] rounded-br-[5px] peer-checked:bg-[#F9F3ED] relative h-full w-full wb-flex flex-col justify-center items-center hover:[&_.variant-option-name]:text-dark-gold hover:bg-foam! transition-colors duration-300" for="bundle-flavor-single">
                  <span class="variant-option-name font-gothic_condensed text-bear-black text-base font-bold uppercase transition-colors duration-300">Single Flavor</span>
                  <span x-show="qtyLimit === 6" x-cloak class="font-kurdis-semi-condensed text-xs text-kraft font-semibold">Save an additional 9%</span>

                </label>
            </fieldset>
        </div>
    </div>
    <div x-show="flavorType == 'mix'"
      x-transition:enter="transition ease-out duration-300"
      x-transition:enter-start="opacity-0 transform scale-0"
      x-transition:enter-end="opacity-100 transform scale-100"
      x-transition:leave="transition ease-in duration-300"
      x-transition:leave-start="opacity-100 transform scale-100"
      x-transition:leave-end="opacity-0 transform scale-0"
      x-cloak class="wb-flex justify-center h-[72px] md:h-[87px]"
      :class="{ 'gap-1.5 md:gap-2.25': bundleQty == 3, 'justify-between!': bundleQty == 6 }"
    >
      <template x-for="(product, index) in bundleSlots" :key="index">
        <div
          class="flex flex-col gap-2.5 pt-3.25 pb-3.5 px-1 md:px-3 justify-center items-center border border-dashed border-[#CFBDB1] rounded-[5px] min-h-[72px] md:min-h-[87px] md:pt-4.5 md:pb-4.75 aspect-[52/72] md:aspect-[62/87] w-full max-w-[calc((100%/6)-3px)] overflow-hidden md:max-w-[calc((100%/6)-8px)]"
          :class="{ 'bg-[#F9F3ED] px-0.5! pt-2.25! pb-1.5! md:pt-3! md:pb-1! border-solid! border-[#F9F3ED]!': product }"
        >
          <template x-if="product">
            <div class="h-full w-full wb-flex flex-col justify-center items-center gap-1 md:gap-1.5 overflow-hidden">
              <img
                :class="index % 2 === 0 ? 'rotate-[9.03deg]' : '-rotate-[9.03deg]'"
                :src="product.image"
                alt="Product Image"
                class="!max-w-5 !h-10 md:!w-6 md:!h-12 object-cover mx-auto shrink-0"
                width="24"
                height="48"
              >
              <span class="font-kurdis-semi-condensed text-[10px] text-bear-black font-bold text-center w-full truncate px-0.5" x-text="product.flavorName"></span>
            </div>
          </template>

          <template x-if="!product">
            <div class="w-fit mx-auto" :class="index % 2 === 0 ? 'rotate-[9.03deg]' : '-rotate-[9.03deg]'">
              {% if bundle_placeholder_image != blank %}
                {{ bundle_placeholder_image | image_url: width: 100 | image_tag: class: '!max-w-5 !h-10 md:!w-6 md:!h-12 object-cover mx-auto' }}
              {% endif %}
            </div>
          </template>

        </div>
      </template>
    </div>
</div>


<div class="flex flex-col gap-2.5">
    {% render 'product-selector-group', bundle_collection: bundle_collection, bundle_type: '32oz' %}
</div>


{% render 'purchase-option-selector' %}

<script x-ref="bundleParentProducts" type="application/json">
  [
    {%- for bundle_product in bundle_products -%}
      {%- assign bundle_parent_variant = bundle_product.selected_or_first_available_variant -%}
      {
        "id": {{ bundle_product.id | json }},
        "handle": {{ bundle_product.handle | json }},
        "variant_id": {{ bundle_parent_variant.id | json }}{% if bundle_parent_variant.selling_plan_allocations.size > 0 %},{% endif %}
        {% for allocation in bundle_parent_variant.selling_plan_allocations %}
          {%- assign selling_plan_name = allocation.selling_plan.name -%}
          {%- if selling_plan_name contains '1 Month' -%}
              "selling_plan_id": {{ allocation.selling_plan.id | json }}
          {%- break -%}
          {%- endif -%}
        {%- endfor -%}
      }{% unless forloop.last %},{% endunless %}
    {%- endfor -%}
  ]
</script>

<script x-ref="productObject" type="application/json">
  {
    {%- for child_product in bundle_collection.products -%}
        "{{- child_product.id -}}": {
            "id": {{- child_product.id -}},
            "title": "{{- child_product.title -}}",
            "handle": "{{- child_product.handle -}}",
            "bundle_name": "{{- child_product.metafields.custom.product_group.value.display_name | handleize -}}",
            "collection_handle": "{{- child_product.metafields.custom.product_group.value.collection_handle.value.handle -}}",
            {% if child_product.metafields.custom.bundle_image != blank %}
              "image": "{{- child_product.metafields.custom.bundle_image | image_url: width: 200 -}}",
            {% endif %}
            {% if child_product.metafields.custom.flavor_name != blank %}
              "flavor_name": "{{- child_product.metafields.custom.flavor_name -}}",
            {% endif %}
            {%- liquid
              assign sf_product = child_product.metafields.custom["32oz_single_flavor"].value
              assign sf_sixpack = blank
              if sf_product != blank
                for sf_variant in sf_product.variants
                  if sf_variant.title contains '6 Pack'
                    assign sf_sixpack = sf_variant
                    break
                  endif
                endfor
              endif
            -%}
            {%- if sf_sixpack != blank -%}
              {%- if sf_sixpack.compare_at_price > sf_sixpack.price -%}
                {%- assign sf_compare = sf_sixpack.compare_at_price -%}
              {%- else -%}
                {%- assign sf_compare = sf_sixpack.price -%}
              {%- endif -%}
              "single_flavor_6pk": {
                "id": {{- sf_sixpack.id -}},
                "price": {{- sf_sixpack.price -}},
                "compare_at_price": {{- sf_compare -}},
                "title": {{ sf_sixpack.title | json }}
                {%- for allocation in sf_sixpack.selling_plan_allocations -%}
                  {%- if allocation.selling_plan.name contains '1 Month' -%}
                    ,"selling_plan_id": {{ allocation.selling_plan.id | json }},
                    "selling_plan_price": {{ allocation.price | json }}
                    {%- break -%}
                  {%- endif -%}
                {%- endfor -%}
              },
            {%- endif -%}
            "variants": {
                {% for child_variant in child_product.variants %}
                    "{{- forloop.index0 -}}": {
                        {% liquid
                          assign product_object = child_product.metafields.custom.product_group

                          if product_object.value.discount_type == 'Percentage'
                            assign discount_type = 'Percentage'
                          else
                            assign discount_type = 'Fixed'
                          endif

                          if child_variant.compare_at_price > child_variant.price
                            assign compare_at_price = child_variant.compare_at_price
                          else
                            assign compare_at_price = child_variant.price
                          endif

                          ## The variant's bundle_unit — the 3-carton per-carton SKU (mix-3 / single-3).
                          ## Its product also carries a 6-carton sibling used for mix-6.
                          assign bu_variant = child_variant.metafields.custom.bundle_unit.value
                          assign bu_variant_6 = blank
                          if bu_variant != blank
                            if bu_variant.compare_at_price > bu_variant.price
                              assign bu_compare = bu_variant.compare_at_price
                            else
                              assign bu_compare = bu_variant.price
                            endif
                            for sib in bu_variant.product.variants
                              assign sib_title = sib.title | downcase
                              if sib_title contains '6'
                                assign bu_variant_6 = sib
                                break
                              endif
                            endfor
                            if bu_variant_6 != blank
                              if bu_variant_6.compare_at_price > bu_variant_6.price
                                assign bu_6_compare = bu_variant_6.compare_at_price
                              else
                                assign bu_6_compare = bu_variant_6.price
                              endif
                            endif
                          endif
                        %}

                        {% if child_product.metafields.custom.product_group.value.multi_unit_product_quantity != blank and child_product.metafields.custom.product_group.value.multi_unit_product_quantity > 0 %}
                          "multi_unit_product": true,
                          "multi_unit_product_unit": "{{- child_product.metafields.custom.product_group.value.multi_unit_product_unit -}}",
                          "multi_unit_quantity": {{- child_product.metafields.custom.product_group.value.multi_unit_product_quantity -}},
                        {% endif %}
                        "compare_at_price": {{- compare_at_price -}},
                        "discount_type": "{{- discount_type -}}",
                        "title": "{{- child_variant.title -}}",
                        "price": {{- child_variant.price -}},
                        {%- for allocation in child_variant.selling_plan_allocations -%}
                          {%- if allocation.selling_plan.name contains '1 Month' -%}
                            "selling_plan_id": {{ allocation.selling_plan.id | json }},
                            "selling_plan_name": {{ allocation.selling_plan.name | json }},
                            "selling_plan_price": {{ allocation.price | json }},
                            "selling_plan_savings": {{ child_variant.price | minus: allocation.price | json }},
                            {%- break -%}
                          {%- endif -%}
                        {%- endfor -%}
                        {%- if bu_variant != blank -%}
                          "bundle_unit": {
                            "id": {{ bu_variant.id | json }},
                            "title": {{ bu_variant.title | json }},
                            "price": {{ bu_variant.price | json }},
                            "compare_at_price": {{ bu_compare | json }}
                            {%- for allocation in bu_variant.selling_plan_allocations -%}
                              {%- if allocation.selling_plan.name contains '1 Month' -%}
                                ,"selling_plan_id": {{ allocation.selling_plan.id | json }},
                                "selling_plan_price": {{ allocation.price | json }},
                                "selling_plan_savings": {{ bu_variant.price | minus: allocation.price | json }}
                                {%- break -%}
                              {%- endif -%}
                            {%- endfor -%}
                          },
                        {%- endif -%}
                        {%- if bu_variant_6 != blank -%}
                          "bundle_unit_6": {
                            "id": {{ bu_variant_6.id | json }},
                            "title": {{ bu_variant_6.title | json }},
                            "price": {{ bu_variant_6.price | json }},
                            "compare_at_price": {{ bu_6_compare | json }}
                            {%- for allocation in bu_variant_6.selling_plan_allocations -%}
                              {%- if allocation.selling_plan.name contains '1 Month' -%}
                                ,"selling_plan_id": {{ allocation.selling_plan.id | json }},
                                "selling_plan_price": {{ allocation.price | json }},
                                "selling_plan_savings": {{ bu_variant_6.price | minus: allocation.price | json }}
                                {%- break -%}
                              {%- endif -%}
                            {%- endfor -%}
                          },
                        {%- endif -%}
                        "id": {{- child_variant.id -}}
                    }{%- unless forloop.last -%},{%- endunless -%}
                {%- endfor -%}
            }
        }{%- unless forloop.last -%},{%- endunless -%}
    {%- endfor -%}
  }
</script>

{% stylesheet %}
  .bundle-32-option-grid .peer:checked + label::before {
    content: '';
    position: absolute;
    inset: -1px;
    border: 1px solid var(--color-espresso);
    pointer-events: none;
    z-index: 1;
  }

  .bundle-32-option-grid fieldset:first-of-type .peer:checked + label::before {
    border-top-left-radius: 5px;
    border-bottom-left-radius: 5px;
  }

  .bundle-32-option-grid fieldset:last-of-type .peer:checked + label::before {
    border-top-right-radius: 5px;
    border-bottom-right-radius: 5px;
  }

  variant-picker:not([data-native-wiring]) {
  & {
    width: 100%;
  }

  .variant-picker__form {
    width: 100%;
  }

  &[data-shopify-visual-preview] {
    min-width: 300px;
    padding-inline-start: max(4px, var(--padding-inline-start));
  }

  /* Dropdown variant option styles */
  .variant-option__select-wrapper {
    display: flex;
    position: relative;
    border: var(--style-border-width-inputs) solid var(--color-border);
    border-radius: var(--style-border-radius-inputs);
    align-items: center;
    margin-top: var(--margin-2xs);
    overflow: clip;
  }

  .variant-option__select-wrapper:has(.swatch) {
    --variant-picker-swatch-width: 20px;
    --variant-picker-swatch-height: 20px;
  }

  .variant-option__select-wrapper:hover {
    border-color: var(--color-variant-hover-border);
  }

  .variant-option__select:focus-visible {
    outline: var(--focus-outline-width) solid currentcolor;
    outline-offset: var(--focus-outline-offset);
  }

  .variant-option__select {
    padding-block: var(--padding-md);
    padding-inline: var(--padding-lg) calc(var(--padding-lg) + var(--icon-size-2xs));
    appearance: none;
    border: 0;
    width: 100%;
    margin: 0;
    cursor: pointer;
  }

  .variant-option__select-wrapper .icon {
    position: absolute;
    right: var(--padding-md);
    top: 50%;
    transform: translateY(-50%);
    width: var(--icon-size-2xs);
    height: var(--icon-size-2xs);
    pointer-events: none;
  }

  .variant-option__select--has-swatch {
    padding-inline-start: calc((2 * var(--padding-sm)) + var(--variant-picker-swatch-width));
  }

  .variant-option__select-wrapper .swatch {
    position: absolute;
    top: 50%;
    left: var(--padding-md);
    transform: translateY(-50%);
  }

  /* Variant picker alignment modifiers (`&` = the <variant-picker> host). */
  &.variant-picker--center,
  &.variant-picker--center .variant-option {
    text-align: center;
    align-items: center;
    justify-content: center;
    width: 100%;
  }

  &.variant-picker--right,
  &.variant-picker--right .variant-option {
    text-align: right;
    justify-content: right;
  }
  }
{% endstylesheet %}
