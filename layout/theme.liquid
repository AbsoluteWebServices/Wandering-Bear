      <link
        rel="expect"
        href="#MainContent"
        blocking="render"
        id="view-transition-render-blocker"
      >
    {% endif %}


      {% comment %} We preconnect to commonly used third-parties to initiate TCP/TLS handshake {% endcomment %}
      <link rel="preconnect" href="https://cdn.shopify.com" crossorigin>
     
      {% comment %} We check if its a system font, or a web-safe font {% endcomment %}
      {% unless settings.type_heading.system? and settings.type_body.system? %} 
        <link rel="preconnect" href="https://fonts.shopifycdn.com" crossorigin>
      {% endunless %} 

    {%- render 'meta-tags' -%}
    {%- render 'meta-json-ld' -%}
    {%- render 'stylesheets' -%}
    {%- render 'fonts' -%}
    {%- render 'scripts' -%}
    {%- render 'theme-styles-variables' -%}
    {%- render 'color-schemes' -%}


    {% if request.design_mode %}
      {%- render 'theme-editor' -%}
    {% endif %}

    {%- liquid
      render 'vite-tag' with 'main.css'
      render 'vite-tag' with 'main.js'
    -%}


    {% if request.path == '/collections/all' %}
      <script>
        window.location.href = '/collections/perfect-pour;
      </script>
    {% endif %}

    {% if request.path contains '/collections' and collection.metafields.custom.hidden == true %}
      <script>
        window.location.href = '/collections/perfect-pour';
      </script>
    {% endif %}


    {{ content_for_header }}
    {% render 'cookie-consent' %}
    {% # theme-check-enable RemoteAsset %}
