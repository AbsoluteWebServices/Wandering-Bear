{% liquid
    assign section_settings = section.settings
    assign color_scheme = section_settings.color_scheme
    assign foreground_image = section_settings.foreground_image
    assign foreground_image_mobile = section_settings.foreground_image_mobile
    assign background_image = section_settings.background_image
    assign background_image_tablet = section_settings.background_image_tablet
    assign background_image_mobile = section_settings.background_image_mobile
    assign title_type = section_settings.title_type
    assign title_image = section_settings.title_image
    assign title_image_mobile = section_settings.title_image_mobile
    assign title_text = section_settings.title_text
    assign subtitle = section_settings.subtitle
    assign buttons = section.blocks | where: "type", "button"
    assign badge = section_settings.badge
%}

{% capture title_styles %}
    --font-size: {{ section.settings.font_size }}px;
    --font-size-mobile: {{ section.settings.font_size_mobile }}px;
{% endcapture %}

{% liquid
    assign bg_tablet = background_image_tablet | default: background_image
    assign bg_mobile = background_image_mobile | default: background_image
    assign fg_mobile = foreground_image_mobile | default: foreground_image
%}
{% capture bg_sources %}
    <source media="(max-width: 749px)" srcset="{{ bg_mobile | image_url: width: 480 }} 480w, {{ bg_mobile | image_url: width: 768 }} 768w, {{ bg_mobile | image_url: width: 1080 }} 1080w" sizes="100vw">
    <source media="(max-width: 1023px)" srcset="{{ bg_tablet | image_url: width: 768 }} 768w, {{ bg_tablet | image_url: width: 1024 }} 1024w, {{ bg_tablet | image_url: width: 1600 }} 1600w" sizes="100vw">
    <source srcset="{{ background_image | image_url: width: 1200 }} 1200w, {{ background_image | image_url: width: 1536 }} 1536w, {{ background_image | image_url: width: 1920 }} 1920w" sizes="100vw">
{% endcapture %}
{% capture fg_sources %}
    <source media="(max-width: 1023px)" srcset="{{ fg_mobile | image_url: width: 500 }} 500w, {{ fg_mobile | image_url: width: 768 }} 768w, {{ fg_mobile | image_url: width: 1000 }} 1000w" sizes="100vw">
    <source srcset="{{ foreground_image | image_url: width: 600 }} 600w, {{ foreground_image | image_url: width: 900 }} 900w, {{ foreground_image | image_url: width: 1200 }} 1200w" sizes="(min-width: 1024px) 50vw, 100vw">
{% endcapture %}
{% capture hero_content %}
        {% render 'picture', sources: bg_sources, source: background_image, tablet_source: background_image_tablet, mobile_source: background_image_mobile, class: 'w-full !h-full object-cover object-left sm:!object-[center_bottom] md:!object-center !max-w-none absolute inset-0 2xl:!object-[0%_30%]', alt: background_image.alt, preload: 'eager', loading: 'eager', fetchpriority: 'high' %}
        {% if title_image != blank or title_text != blank or subtitle != blank %}
            <div class="container relative wb-flex flex-col items-center md:flex-row pt-8 justify-center w-full max-w-none md:justify-start md:max-w-full gap-8 md:px-5 lg:max-w-[1136px] h-full smd:min-h-[415px] md:gap-5 mx-0 md:mx-auto lg:min-h-[555px] h-full lg:max-h-[528px]">
            <div class="relative wb-flex flex-col items-center justify-center sm:items-start md:items-center gap-2.5 z-1 w-fit md:min-w-1/2 max-w-full">
                {% if title_image != blank and title_type == 'image' %}
                    {% render 'title-image', image: title_image, image_mobile: title_image_mobile, alt: title_image.alt, class: 'relative w-full h-full object-contain !max-w-[270px] md:!max-w-full mx-auto', preload: 'eager', loading: 'eager' %}
                {% elsif title_text != blank and title_type == 'text'%}
                    <h1 class="h1 title-text leading-[1.2] text-center md:!text-left" style="color: {{ color_scheme.settings.foreground }}; {{ title_styles }}">{{ title_text | replace: '\b', '<br>' }}</h1>
                {% endif %}
                {% if subtitle != blank %}
                    <span class="h3 text-center md:!text-xl title-text mx-auto" style="color: {{ color_scheme.settings.foreground }};">{{ subtitle }}</span>
                {% endif %}
                {% if buttons != blank %}
                    <div class="wb-flex flex-col lg:!flex-row gap-3 lg:gap-6.5 w-fit mx-auto lg:!mx-0 mt-3 relative">
                        {% for button in buttons %}
                            <div class="relative mx-auto md:!mx-0" data-anchor="shop-cold-brew">
                                {% if button.settings.badge != blank %}
                                    {{ button.settings.badge | image_url: width: 100 | image_tag: class: 'absolute z-[2] -top-5 -left-10 !w-[59px] !h-auto shadow-button', loading: 'eager', preload: 'eager' }}
                                {% endif %}
                                {% render 'wb-button', style: button.settings.style, label: button.settings.label, link: button.settings.link %}
                            </div>
                        {% endfor %}
                    </div>
                {% endif %}
            </div>
            {% if foreground_image != blank or foreground_image_mobile != blank %}
                    {% render 'picture', sources: fg_sources, source: foreground_image, mobile_source: foreground_image_mobile, class: 'relative min-h-full left-0 bottom-0 md:static w-screen smd:w-auto h-full object-contain z-1 object-bottom md:mt-12', alt: foreground_image.alt, preload: 'eager', loading: 'eager' %}
                {% endif %}
               
            </div>
        {% endif %}
{% endcapture %}

{% if hero_content != blank %}
<div class="flex relative justify-center items-center relative overflow-hidden 
">
    <div class="flex justify-center items-center w-full">
      {{ hero_content }}
    </div>
    {% if badge != blank %}
        {{ badge | image_url: width: 100 | image_tag: class: 'absolute z-[2] -bottom-5 right-[20vw] !w-[85px] !h-auto', loading: 'eager', preload: 'eager' }}
    {% endif %}
    <svg preserveAspectRatio="none" class="absolute -bottom-4 md:-bottom-0.5 left-0 w-full z-[2]" xmlns="http://www.w3.org/2000/svg" width="1290" height="30" viewBox="0 0 1290 30" fill="none">
        <path d="M0 0.952156L320 0L938 7.63188L1290 5.2564V30H0V0.952156Z" fill="{{ color_scheme.settings.background }}"/>
    </svg>
</div>
{% endif %}

{% style %}
    .title-text {
        font-size: var(--font-size);
    }

    @media (max-width: 1024px) {
        .title-text {
            font-size: var(--font-size-mobile);
        }
    }
{% endstyle %}

{% schema %}
{
    "name": "AW Hero",
    "settings": [
        {
            "type": "color_scheme",
            "id": "color_scheme",
            "label": "Color Scheme",
            "default": "scheme-1"
        },
        {
            "type": "image_picker",
            "id": "foreground_image",
            "label": "Foreground Image"
        },
        {
            "type": "image_picker",
            "id": "foreground_image_mobile",
            "label": "Foreground Image Mobile"
        },
        {
            "type": "image_picker",
            "id": "background_image",
            "label": "Background Image"
        },
        {
            "type": "image_picker",
            "id": "background_image_tablet",
            "label": "Background Image Tablet"
        },
        {
            "type": "image_picker",
            "id": "background_image_mobile",
            "label": "Background Image Mobile"
        },
        {
            "type": "select",
            "id": "title_type",
            "label": "Title Type",
            "options": [
                {
                    "value": "image",
                    "label": "Image"
                },
                {
                    "value": "text",
                    "label": "Text"
                }
            ],
            "default": "image"
        },
        {
            "type": "image_picker",
            "id": "title_image",
            "label": "Title Image",
            "visible_if": "{{ section.settings.title_type == 'image' }}"
        },
        {
            "type": "image_picker",
            "id": "title_image_mobile",
            "label": "Title Image Mobile",
            "visible_if": "{{ section.settings.title_type == 'image' }}"
        },
        {
            "type": "text",
            "id": "title_text",
            "label": "Title",
            "visible_if": "{{ section.settings.title_type == 'text' }}",
            "info": "Add '\\b' for line breaks"
        },
        {
            "type": "range",
            "id": "font_size",
            "label": "Font Size",
            "min": 16,
            "max": 100,
            "step": 1,
            "unit": "px",
            "default": 24,
            "visible_if": "{{ section.settings.title_type == 'text' }}"
        },
        {
            "type": "range",
            "id": "font_size_mobile",
            "label": "Font Size Mobile",
            "min": 16,
            "max": 100,
            "step": 1,
            "unit": "px",
            "default": 24,
            "visible_if": "{{ section.settings.title_type == 'text' }}"
        },
        {
            "type": "text",
            "id": "subtitle",
            "label": "Subtitle"
        },
        {
            "type": "image_picker",
            "id": "badge",
            "label": "Badge"
        }
    ],
    "blocks": [
        {
            "type": "button",
            "name": "Button",
            "limit": 2,
            "settings": [
                {
                    "type": "select",
                    "id": "style",
                    "label": "Style",
                    "options": [
                        {
                            "value": "primary",
                            "label": "Primary"
                        },
                        {
                            "value": "secondary-gold",
                            "label": "Secondary Gold"
                        },
                        {
                            "value": "secondary-cream",
                            "label": "Secondary Cream"
                        }
                    ],
                    "default": "primary"
                },
                {
                    "type": "text",
                    "id": "label",
                    "label": "Label"
                },
                {
                    "type": "url",
                    "id": "link",
                    "label": "Link"
                },
                {
                    "type": "image_picker",
                    "id": "badge",
                    "label": "Badge"
                }
            ]
        }
    ],
    "presets": [
        {
            "name": "AW Hero"
        }
    ]
}
{% endschema %}