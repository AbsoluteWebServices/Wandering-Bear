    {
      "type": "header",
      "content": "Script heading"
    },
    {
      "type": "text",
      "id": "script",
      "label": "Script",
      "info": "Use \\b to force a line break.",
      "default": "Same cold brew, any way you want it!"
    },
    {
      "type": "color",
      "id": "script_color",
      "label": "Script color",
      "default": "#AF7404"
    },
    {
      "type": "range",
      "id": "script_size",
      "label": "Script size",
      "min": 20,
      "max": 80,
      "step": 1,
      "unit": "px",
      "default": 45
    },
    {
      "type": "range",
      "id": "script_size_mobile",
      "label": "Script size mobile",
      "min": 16,
      "max": 60,
      "step": 1,
      "unit": "px",
      "default": 32
    },
    {
      "type": "header",
      "content": "Product grid"
    },
    {
      "type": "color",
      "id": "label_color",
      "label": "Card label color",
      "default": "#282827"
    },
    {
      "type": "header",
      "content": "Paw Promise"
    },
    {
      "type": "text",
      "id": "promise_heading",
      "label": "Heading",
      "default": "PAW PROMISE"
    },
    {
      "type": "color",
      "id": "promise_heading_color",
      "label": "Heading color",
      "default": "#2A1A0F"
    },
    {
      "type": "text",
      "id": "promise_subheading",
