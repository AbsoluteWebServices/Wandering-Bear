{% comment %}
  Bottom of the About Us banner. Figma: WB Website, About Us_UPDATE 1694:518, desktop 1653:20.
  One dark-gradient block (#F2E6DC→#AF7404, y 2648–4336) holding three things:
    1. script heading "Same cold brew, any way you want it!" (Parslay 45px, Gold)
    2. a 3×2 product grid — photo card + label (Kurdis Condensed 18px)
    3. Paw Promise — outline heading + cream subtext + bear paw (bleeds left) and a numbered list

  Two block types: `product` (grid cards) and `promise` (numbered items).
{% endcomment %}

{% liquid
  assign s = section.settings
  assign color_scheme = s.color_scheme
  assign products = section.blocks | where: 'type', 'product'
  assign promises = section.blocks | where: 'type', 'promise'
%}

{% capture type_styles %}
  --script-size: {{ s.script_size | default: 45 }}px;
  --script-size-mobile: {{ s.script_size_mobile | default: 32 }}px;
  --label-color: {{ s.label_color | default: '#282827' }};
{% endcapture %}

<div
  class="wb-about-products relative overflow-hidden spacing-style wb-section-bg"
  style="{% render 'section-background', settings: s, part: 'style', fallback_color: color_scheme.settings.background %} {% render 'spacing-style', settings: s %} {{ type_styles }}"
  {{ section.shopify_attributes }}
>
  {% render 'section-background', settings: s, part: 'media' %}

  <div class="relative z-[1] max-w-[1074px] mx-auto px-6">
    {% if s.script != blank %}
      <p class="wb-about-products__script font-parslay" style="color: {{ s.script_color | default: '#AF7404' }};">
        {{ s.script | replace: '\b', '<br>' }}
      </p>
    {% endif %}

    {% comment %} ---- Product grid: 3×2 (grid defined in the section stylesheet, not via Tailwind) ---- {% endcomment %}
    {% if products.size > 0 %}
      <div class="wb-about-products__grid">
        {% for block in products %}
          <div class="wb-about-products__cell" {{ block.shopify_attributes }}>
            <div class="wb-about-products__card">
              {% if block.settings.image != blank %}
                {% render 'picture', source: block.settings.image, class: 'w-full h-full object-cover', alt: block.settings.label, width: 640, height: 680, loading: 'lazy' %}
              {% elsif block.settings.image_preview != blank %}
                <img src="{{ block.settings.image_preview | asset_url }}" alt="{{ block.settings.label }}" class="wb-about-products__card-img" loading="lazy">
              {% endif %}
            </div>
            {% if block.settings.label != blank %}
              <span class="wb-about-products__label font-kurdis font-extrabold" style="color: var(--label-color);">
                {{ block.settings.label }}
              </span>
            {% endif %}
          </div>
        {% endfor %}
      </div>
    {% endif %}

    {% comment %} ---- Paw Promise ---- {% endcomment %}
    {% if s.promise_heading != blank or promises.size > 0 %}
      {% comment %}
        DOM order is heading → cards → paw, which is the mobile stack. On desktop a grid template
        moves the paw into the lower-left (below the heading) while the cards span the right column.
      {% endcomment %}
      <div class="wb-about-products__paw mt-16 smd:!mt-24">
        <div class="wb-about-products__paw-left">
          {% if s.promise_heading != blank %}
            <h2 class="wb-about-products__paw-heading font-gothic_condensed font-extrabold" style="color: {{ s.promise_heading_color | default: '#2A1A0F' }};">
              {{ s.promise_heading }}
            </h2>
          {% endif %}
          {% if s.promise_subheading != blank %}
            <p class="wb-about-products__paw-sub font-kurdis font-extrabold" style="color: {{ s.promise_subheading_color | default: '#F2E6DC' }};">
              {{ s.promise_subheading }}
            </p>
          {% endif %}
        </div>

        {% comment %} Numbered promise cards {% endcomment %}
        {% if promises.size > 0 %}
          <ol class="wb-about-products__promises">
            {% for block in promises %}
              <li class="wb-about-products__promise" style="background-color: {{ s.card_bg | default: '#F2E6DC' }};" {{ block.shopify_attributes }}>
                <span class="wb-about-products__promise-num font-gothic_condensed font-extrabold" style="background-color: {{ s.number_bg | default: '#1B1B1B' }}; color: {{ s.number_color | default: '#F2E6DC' }};">{{ forloop.index }}</span>
                <span class="wb-about-products__promise-text font-kurdis font-semibold" style="color: {{ s.promise_text_color | default: '#2A1A0F' }};">{{ block.settings.text }}</span>
              </li>
            {% endfor %}
          </ol>
        {% endif %}

        {% liquid
          assign paw_src = ''
          if s.paw_image != blank
            assign paw_src = s.paw_image | image_url: width: 1200
          elsif s.paw_preview != blank
            assign paw_src = s.paw_preview | asset_url
          endif
          assign sticker_src = ''
          if s.paw_sticker != blank
            assign sticker_src = s.paw_sticker | image_url: width: 300
          elsif s.paw_sticker_preview != blank
            assign sticker_src = s.paw_sticker_preview | asset_url
          endif
        %}
        {% if paw_src != blank %}
          {% comment %}
            The asset is a white-background JPG. background-blend-mode multiply blends it against a
            gold gradient echoing the section's own, so the white knocks out reliably —
            mix-blend-mode depends on the backdrop's stacking context and did not work here.
          {% endcomment %}
          <div class="wb-about-products__paw-img" style="--paw-img: url('{{ paw_src }}'); --paw-blend-top: {{ s.paw_blend_top | default: '#BF8F38' }}; --paw-blend-bottom: {{ s.paw_blend_color | default: '#B27A0F' }};" role="img" aria-label="Bear paw holding a glass of cold brew">
            {% if sticker_src != blank %}
              <img src="{{ sticker_src }}" alt="" class="wb-about-products__paw-sticker" loading="lazy">
            {% endif %}
          </div>
        {% endif %}
      </div>
    {% endif %}
  </div>
</div>

{%- comment -%}
  Optional wrapper margin-top. The previous section (started banner) is absolute / out of flow, so
  this reserves the space it visually occupies and keeps the products grid from riding up under it.
{%- endcomment -%}
{%- if s.section_margin_top != blank -%}
  {% style %}
    #shopify-section-{{ section.id }} {
      margin-top: {{ s.section_margin_top }}px;
    }
  {% endstyle %}
{%- endif -%}

{%- comment -%}
  Mobile (< 750px): on desktop the margin above reserves the space of the absolute banner section.
  On mobile that banner is back in normal flow, so the reserved gap is removed and the products
  block simply follows it. Desktop is not matched by this query.
{%- endcomment -%}
{% style %}
  @media screen and (max-width: 749px) {
    #shopify-section-{{ section.id }} {
      margin-top: {{ s.section_margin_top_mobile | default: 0 }}px !important;
    }
  }
{% endstyle %}

{% stylesheet %}
  /* Fonts per Figma: regular Kurdis for labels/subheading/promise text, Gothic Condensed for the
     numbered badges, Parslay for the script. Enforced here (not only via Tailwind utilities) so the
     section stays correct independent of the bundle. */
  .wb-about-products__label,
  .wb-about-products__paw-sub,
  .wb-about-products__promise-text {
    font-family: "Kurdis", sans-serif;
  }

  .wb-about-products__promise-num {
    font-family: "Gothic Condensed", sans-serif;
  }

  .wb-about-products__script {
    font-size: var(--script-size) !important;
    text-align: center;
    line-height: 1.1;
    margin-bottom: 40px;
  }

  @media screen and (min-width: 750px) {
    .wb-about-products__script {
      margin-bottom: 56px;
    }
  }

  /* Product grid: 2 columns on mobile, 3 from 750px. Defined here so it does not depend on
     Tailwind generating grid-cols-* for this file. */
  .wb-about-products__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    column-gap: 16px;
    row-gap: 32px;
  }

  /* Figma card = a cream plate (#F2E6DC) with the photo inset inside it and the label sitting on
     the same plate below the photo (node 1783:142). The photo does not go edge to edge. */
  .wb-about-products__cell {
    display: flex;
    flex-direction: column;
    align-items: stretch;
    background-color: #f2e6dc;
    border-radius: 14px;
    padding: 18px 18px 16px;
    box-shadow: 0 10px 24px rgba(0, 0, 0, 0.1);
  }

  .wb-about-products__card {
    width: 100%;
    aspect-ratio: 252 / 296;
    border-radius: 8px;
    overflow: hidden;
  }

  .wb-about-products__card-img,
  .wb-about-products__card img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .wb-about-products__label {
    display: block;
    margin-top: 12px;
    font-size: 18px;
    line-height: 1.05;
    text-align: center;
    text-transform: uppercase;
  }

  /* ---- Paw Promise ---- */
  /* Mobile: single centred column, DOM order — heading, subheading, cards (badge on top), paw. */
  .wb-about-products__paw {
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .wb-about-products__paw-left {
    text-align: center;
  }

  .wb-about-products__paw-heading {
    font-size: 44px;
    line-height: 0.9;
    text-transform: uppercase;
  }

  .wb-about-products__paw-sub {
    font-size: 20px;
    line-height: 1.15;
    margin: 12px auto 0;
    max-width: 300px;
  }

  /* The asset is a full arm on white with ~30% white margin above it. Two background layers:
     the arm (cover + a vertical position crops the white to the arm band) multiplied over a
     gold gradient that echoes the section's own gradient — so the white knocks out to a colour
     that matches the surroundings and the multiply box has no visible edges. */
  .wb-about-products__paw-img {
    position: relative;
    /* Transparent PNG cut-out (ab-bearhand.png) — shown directly, no multiply/gradient knock-out.
       Mobile (Figma 1694:245 BearHand: 642×541 ≈ the image's native ratio, bled off the left edge). */
    width: 642px;
    max-width: none;
    align-self: flex-start;
    aspect-ratio: 1024 / 863;
    margin: 24px 0 0 -350px;
    background-image: var(--paw-img);
    background-repeat: no-repeat;
    background-position: center;
    background-size: contain;
    pointer-events: none;
  }

  .wb-about-products__paw-sticker {
    display: none; /* desktop-only accent */
  }

  .wb-about-products__promises {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 44px; /* leaves room for the number badge sitting above each card */
    margin: 44px 0 0;
    padding: 0;
  }

  .wb-about-products__promise {
    position: relative;
    border-radius: 14px;
    padding: 34px 22px 24px;
    text-align: center;
  }

  .wb-about-products__promise-num {
    position: absolute;
    top: -24px;
    left: 50%;
    transform: translateX(-50%);
    width: 48px;
    height: 48px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 9999px;
    font-size: 20px;
    line-height: 1;
  }

  .wb-about-products__promise-text {
    display: block;
    font-size: 15px;
    line-height: 1.4;
  }

  @media screen and (min-width: 750px) {
    .wb-about-products__grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      column-gap: 24px;
      row-gap: 40px;
    }

    /* Desktop: heading top-left, paw bottom-left, cards span the right column. */
    .wb-about-products__paw {
      display: grid;
      grid-template-columns: 1fr 1fr;
      grid-template-areas:
        "head cards"
        "paw  cards";
      column-gap: 48px;
      row-gap: 0;
      align-items: start;
    }

    .wb-about-products__paw-left {
      grid-area: head;
      text-align: left;
    }

    .wb-about-products__promises {
      grid-area: cards;
    }

    .wb-about-products__paw-img {
      grid-area: paw;
      align-self: end;
    }

    .wb-about-products__paw-heading {
      font-size: 72px;
    }

    .wb-about-products__paw-sub {
      margin: 16px 0 0;
      max-width: 340px;
    }

    .wb-about-products__paw-img {
      width: 620px;
      max-width: none;
      aspect-ratio: 1024 / 500;
      /* bleed off the left edge of the content column (clipped by the section's overflow:hidden) */
      margin: 40px 0 0 -130px;
      background-position: 50% 46%;
      background-size: cover;
    }

    .wb-about-products__paw-sticker {
      display: block;
      position: absolute;
      top: 24%;
      left: 20%;
      width: 116px;
      height: auto;
      transform: rotate(-12deg);
    }

    .wb-about-products__promises {
      gap: 28px;
      margin: 0;
      padding-left: 24px;
    }

    .wb-about-products__promise {
      padding: 26px 30px 26px 38px;
    }

    .wb-about-products__promise-num {
      top: 50%;
      left: -24px;
      transform: translateY(-50%);
    }
  }

  @media screen and (max-width: 1023px) {
    .wb-about-products__script {
      font-size: var(--script-size-mobile) !important;
    }
  }

  /* Mobile: bigger number badges to match the Figma mobile design (digit 25px). Scoped to < 750px
     so the desktop badge (48px / 20px) is untouched. */
  @media screen and (max-width: 749px) {
    .wb-about-products__paw-heading {
      font-size: 54px;
      line-height: 0.82;
      letter-spacing: -0.5px;
    }
    .wb-about-products__paw-left {
      text-align: center;
      margin-bottom: 50px;
    }
    .wb-about-products__paw-sub {
      font-size: 20px;
      line-height: 1.15;
      margin: 30px auto 0;
      max-width: 315px;
    }
    .wb-about-products__promise {
      padding: 55px 22px 24px;
    }
    .wb-about-products__promise-num {
      width: 75px;
      height: 75px;
      top: -38px;
      font-size: 25px;
    }
    .wb-about-products__promises {
      gap: 56px;
      max-width: 370px;
      margin-left: auto;
      margin-right: auto;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "AW About Products",
  "tag": "section",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color Scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "Script heading"
    },
    {
      "type": "text",
      "id": "script",
      "label": "Script",
      "info": "Use \\b to force a line break.",
      "default": "Same cold brew, any way you want it!"
    },
    {
      "type": "color",
      "id": "script_color",
      "label": "Script color",
      "default": "#AF7404"
    },
    {
      "type": "range",
      "id": "script_size",
      "label": "Script size",
      "min": 20,
      "max": 80,
      "step": 1,
      "unit": "px",
      "default": 45
    },
    {
      "type": "range",
      "id": "script_size_mobile",
      "label": "Script size mobile",
      "min": 16,
      "max": 60,
      "step": 1,
      "unit": "px",
      "default": 32
    },
    {
      "type": "header",
      "content": "Product grid"
    },
    {
      "type": "color",
      "id": "label_color",
      "label": "Card label color",
      "default": "#282827"
    },
    {
      "type": "header",
      "content": "Paw Promise"
    },
    {
      "type": "text",
      "id": "promise_heading",
      "label": "Heading",
      "default": "PAW PROMISE"
    },
    {
      "type": "color",
      "id": "promise_heading_color",
      "label": "Heading color",
      "default": "#2A1A0F"
    },
    {
      "type": "text",
      "id": "promise_subheading",
      "label": "Subheading",
      "default": "This is why our customers trust Wandering Bear."
    },
    {
      "type": "color",
      "id": "promise_subheading_color",
      "label": "Subheading color",
      "default": "#F2E6DC"
    },
    {
      "type": "image_picker",
      "id": "paw_image",
      "label": "Bear paw image"
    },
    {
      "type": "text",
      "id": "paw_preview",
      "label": "Bear paw preview asset (dev only)"
    },
    {
      "type": "color",
      "id": "paw_blend_top",
      "label": "Paw blend color (top)",
      "info": "The paw JPG's white background is multiplied against a gradient of these two colors. Match the section gradient behind the paw.",
      "default": "#BF8F38"
    },
    {
      "type": "color",
      "id": "paw_blend_color",
      "label": "Paw blend color (bottom)",
      "default": "#B27A0F"
    },
    {
      "type": "image_picker",
      "id": "paw_sticker",
      "label": "Paw sticker (desktop)"
    },
    {
      "type": "text",
      "id": "paw_sticker_preview",
      "label": "Paw sticker preview asset (dev only)"
    },
    {
      "type": "color",
      "id": "card_bg",
      "label": "Promise card color",
      "default": "#F2E6DC"
    },
    {
      "type": "color",
      "id": "number_bg",
      "label": "Number circle color",
      "default": "#1B1B1B"
    },
    {
      "type": "color",
      "id": "number_color",
      "label": "Number color",
      "default": "#F2E6DC"
    },
    {
      "type": "color",
      "id": "promise_text_color",
      "label": "Promise text color",
      "default": "#2A1A0F"
    },
    {
      "type": "header",
      "content": "Background"
    },
    {
      "type": "select",
      "id": "background_type",
      "label": "Background type",
      "options": [
        { "value": "transparent", "label": "Transparent" },
        { "value": "color", "label": "Color" },
        { "value": "gradient", "label": "Gradient" },
        { "value": "image", "label": "Image" }
      ],
      "default": "gradient"
    },
    {
      "type": "color",
      "id": "background_solid",
      "label": "Background color",
      "default": "#AF7404",
      "visible_if": "{{ section.settings.background_type == 'color' }}"
    },
    {
      "type": "color_background",
      "id": "background_gradient",
      "label": "Background gradient",
      "default": "linear-gradient(180deg, #F2E6DC 0%, #AF7404 100%)",
      "visible_if": "{{ section.settings.background_type == 'gradient' }}"
    },
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "Background image",
      "visible_if": "{{ section.settings.background_type == 'image' }}"
    },
    {
      "type": "number",
      "id": "section_margin_top",
      "label": "Section margin-top px (reserve space for the absolute banner above)"
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding-block-start-mobile",
      "label": "t:settings.top_mobile",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding-block-end-mobile",
      "label": "t:settings.bottom_mobile",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "default": 60
    }
  ],
  "blocks": [
    {
      "type": "product",
      "name": "Product card",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "image_preview", "label": "Image preview asset (dev only)" },
        { "type": "text", "id": "label", "label": "Label" }
      ]
    },
    {
      "type": "promise",
      "name": "Promise item",
      "settings": [
        { "type": "textarea", "id": "text", "label": "Text" }
      ]
    }
  ],
  "presets": [
    {
      "name": "AW About Products"
    }
  ]
}
{% endschema %}
