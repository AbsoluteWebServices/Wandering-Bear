{% comment %}
  Bottom of the About Us banner. Figma: WB Website, About Us_UPDATE 1694:518, desktop 1653:20.
  One dark-gradient block (#F2E6DC→#AF7404, y 2648–4336) holding three things:
    1. script heading "Same cold brew, any way you want it!" (Parslay 45px, Gold)
    2. a 3×2 product grid — photo card + label (Kurdis Condensed 18px)
    3. Paw Promise — outline heading + cream subtext + bear paw (bleeds left) and a numbered list

  Two block types: `product` (grid cards) and `promise` (numbered items).
{% endcomment %}

{% liquid
  assign s = section.settings
  assign color_scheme = s.color_scheme
  assign products = section.blocks | where: 'type', 'product'
  assign promises = section.blocks | where: 'type', 'promise'
%}

{% capture type_styles %}
  --script-size: {{ s.script_size | default: 45 }}px;
  --script-size-mobile: {{ s.script_size_mobile | default: 32 }}px;
  --label-color: {{ s.label_color | default: '#282827' }};
  --promise-text-color-mobile: {{ s.promise_text_color_mobile | default: '#431A03' }};
  --prod-pad-top-desktop: {{ s['padding-block-start'] | default: 60 }}px;
  --paw-width-mobile: {{ s.paw_width_mobile | default: 668 }}px;
  --paw-left-mobile: {{ s.paw_left_mobile | default: -339 }}px;
  --paw-top-mobile: {{ s.paw_top_mobile | default: -60 }}px;
  --paw-bleed-mobile: {{ s.paw_bleed_mobile | default: -148 }}px;
{% endcapture %}

<div
  class="wb-about-products relative overflow-hidden spacing-style wb-section-bg"
  style="{% render 'section-background', settings: s, part: 'style', fallback_color: color_scheme.settings.background %} {% render 'spacing-style', settings: s %} {{ type_styles }}"
  {{ section.shopify_attributes }}
>
  {% render 'section-background', settings: s, part: 'media' %}

  <div class="wb-about-products__container relative z-[1] max-w-[1074px] mx-auto px-6">
    {% if s.script != blank %}
      <p class="wb-about-products__script font-parslay" style="color: {{ s.script_color | default: '#AF7404' }};">
        {{ s.script | replace: '\b', '<br>' }}
      </p>
    {% endif %}

    {% comment %} ---- Product grid: 3×2 (grid defined in the section stylesheet, not via Tailwind) ---- {% endcomment %}
    {% if products.size > 0 %}
      <div class="wb-about-products__grid">
        {% for block in products %}
          {%- comment -%}
            A card with a link renders as <a> so the whole tile is the hit area; without one it
            stays a plain <div>, so cards that lead nowhere are not announced as links.
          {%- endcomment -%}
          {%- liquid
            assign cell_tag = 'div'
            if block.settings.link != blank
              assign cell_tag = 'a'
            endif
          -%}
          <{{ cell_tag }} class="wb-about-products__cell{% if block.settings.link != blank %} wb-about-products__cell--link{% endif %}"{% if block.settings.link != blank %} href="{{ block.settings.link }}"{% endif %} {{ block.shopify_attributes }}>
            <div class="wb-about-products__card">
              {% if block.settings.image != blank %}
                {% render 'picture', source: block.settings.image, class: 'w-full h-full object-cover', alt: block.settings.label, width: 640, height: 680, loading: 'lazy' %}
              {% elsif block.settings.image_preview != blank %}
                <img src="{{ block.settings.image_preview | asset_url }}" alt="{{ block.settings.label }}" class="wb-about-products__card-img" loading="lazy">
              {% endif %}
            </div>
            {% if block.settings.label != blank %}
              <span class="wb-about-products__label font-extrabold" style="color: var(--label-color);">
                {{ block.settings.label }}
              </span>
            {% endif %}
          </{{ cell_tag }}>
        {% endfor %}
      </div>
    {% endif %}

    {% comment %} ---- Paw Promise ---- {% endcomment %}
    {% if s.promise_heading != blank or promises.size > 0 %}
      {% comment %}
        DOM order is heading → cards → paw, which is the mobile stack. On desktop a grid template
        moves the paw into the lower-left (below the heading) while the cards span the right column.
      {% endcomment %}
      <div class="wb-about-products__paw mt-16">
        <div class="wb-about-products__paw-left">
          {% if s.promise_heading != blank %}
            {%- comment -%} Desktop: PAW PROMISE as the Figma outline wordmark (SVG). Mobile keeps the text heading untouched. {%- endcomment -%}
            <span class="wb-about-products__paw-heading-svg block" role="img" aria-label="{{ s.promise_heading }}">
              <svg width="365" height="57" viewBox="0 0 365 57" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M338.949 56.1261C338.397 56.1261 337.949 55.6784 337.949 55.1261V5.74609C337.949 5.19381 338.397 4.74609 338.949 4.74609H362.009C362.562 4.74609 363.009 5.19381 363.009 5.74609V13.4061C363.009 13.9584 362.562 14.4061 362.009 14.4061H349.869C349.317 14.4061 348.869 14.8538 348.869 15.4061V24.2561C348.869 24.8084 349.317 25.2561 349.869 25.2561H360.469C361.022 25.2561 361.469 25.7038 361.469 26.2561V33.6361C361.469 34.1884 361.022 34.6361 360.469 34.6361H349.869C349.317 34.6361 348.869 35.0838 348.869 35.6361V45.4661C348.869 46.0184 349.317 46.4661 349.869 46.4661H363.269C363.822 46.4661 364.269 46.9138 364.269 47.4661V55.1261C364.269 55.6784 363.822 56.1261 363.269 56.1261H338.949Z" fill="#1B1B1B"/>
