                <path d="M3.73817 52.82C3.18667 52.8494 2.71572 52.4262 2.68628 51.8747L0.0533203 2.56498C0.0238723 2.01348 0.447078 1.54253 0.998577 1.51309L12.2326 0.913233C23.3467 0.319778 29.5597 3.77341 30.1718 15.2371C30.6571 24.3241 28.0107 32.5269 14.6597 33.2398L13.6312 33.2947C13.0797 33.3242 12.6564 33.7951 12.6859 34.3466L13.5907 51.2925C13.6202 51.844 13.197 52.3149 12.6455 52.3444L3.73817 52.82ZM12.0791 22.9828C12.1086 23.5343 12.5795 23.9575 13.131 23.9281L13.6702 23.8993C17.7245 23.6828 19.3675 21.6323 19.0913 16.4596C18.8449 11.8462 17.1514 10.3243 13.936 10.496L12.4181 10.5771C11.8666 10.6065 11.4434 11.0775 11.4729 11.629L12.0791 22.9828Z" fill="#1B1B1B"/>
              </svg>
            </span>
            <h2 class="wb-about-products__paw-heading font-gothic_condensed font-extrabold hidden" style="color: {{ s.promise_heading_color | default: '#2A1A0F' }};">
              {{ s.promise_heading }}
            </h2>
          {% endif %}
          {% if s.promise_subheading != blank %}
            {%- comment -%} Optional mobile-only line break: the phrase in promise_sub_break_mobile gets a
               <br> in front of it, hidden from the desktop breakpoint up. Done here rather than in the
               setting because Shopify strips class attributes from authored HTML. {%- endcomment -%}
            {%- liquid
              assign sub_html = s.promise_subheading
              if s.promise_sub_break_mobile != blank
                capture sub_break
                  echo '<br class="wb-br-mobile">'
                  echo s.promise_sub_break_mobile
                endcapture
                assign sub_html = sub_html | replace: s.promise_sub_break_mobile, sub_break
              endif
            -%}
            <p class="wb-about-products__paw-sub font-extrabold" style="color: {{ s.promise_subheading_color | default: '#F2E6DC' }};">
              {{ sub_html }}
            </p>
          {% endif %}
        </div>

        {% comment %} Numbered promise cards {% endcomment %}
        {% if promises.size > 0 %}
          <ol class="wb-about-products__promises">
            {% for block in promises %}
              <li class="wb-about-products__promise" style="background-color: {{ s.card_bg | default: '#F2E6DC' }};" {{ block.shopify_attributes }}>
                <span class="wb-about-products__promise-num font-gothic_condensed font-extrabold" style="background-color: {{ s.number_bg | default: '#1B1B1B' }}; color: {{ s.number_color | default: '#F2E6DC' }};">{{ forloop.index }}</span>
                <span class="wb-about-products__promise-text font-(font-family:var(--font-kurdis-semi-condensed))! font-semibold" style="color: {{ s.promise_text_color | default: '#2A1A0F' }};">{{ block.settings.text }}</span>
              </li>
            {% endfor %}
          </ol>
        {% endif %}

        {% liquid
          assign paw_src = ''
          if s.paw_image != blank
            assign paw_src = s.paw_image | image_url: width: 1200
          elsif s.paw_preview != blank
            assign paw_src = s.paw_preview | asset_url
          endif
          assign sticker_src = ''
          if s.paw_sticker != blank
            assign sticker_src = s.paw_sticker | image_url: width: 300
          elsif s.paw_sticker_preview != blank
            assign sticker_src = s.paw_sticker_preview | asset_url
          endif
        %}
        {% if paw_src != blank %}
          {% comment %}
            The asset is a white-background JPG. background-blend-mode multiply blends it against a
            gold gradient echoing the section's own, so the white knocks out reliably —
            mix-blend-mode depends on the backdrop's stacking context and did not work here.
          {% endcomment %}
          <div class="wb-about-products__paw-img" style="--paw-img: url('{{ paw_src }}'); --paw-blend-top: {{ s.paw_blend_top | default: '#BF8F38' }}; --paw-blend-bottom: {{ s.paw_blend_color | default: '#B27A0F' }};" role="img" aria-label="Bear paw holding a glass of cold brew">
            {% if sticker_src != blank %}
              <img src="{{ sticker_src }}" alt="" class="wb-about-products__paw-sticker" loading="lazy">
            {% endif %}
          </div>
        {% endif %}
      </div>
    {% endif %}
  </div>
</div>

{%- comment -%}
  Optional wrapper margin-top. The previous section (started banner) is absolute / out of flow, so
  this reserves the space it visually occupies and keeps the products grid from riding up under it.
{%- endcomment -%}
{%- if s.section_margin_top != blank -%}
  {% style %}
    #shopify-section-{{ section.id }} {
      margin-top: {{ s.section_margin_top }}px;
    }
  {% endstyle %}
{%- endif -%}

{%- comment -%}
  Mobile (< 750px): on desktop the margin above reserves the space of the absolute banner section.
  On mobile that banner is back in normal flow, so the reserved gap is removed and the products
  block simply follows it. Desktop is not matched by this query.
{%- endcomment -%}
{% style %}
  @media screen and (max-width: 749px) {
    #shopify-section-{{ section.id }} {
      margin-top: {{ s.section_margin_top_mobile | default: 0 }}px !important;
    }
  }
{% endstyle %}

{% stylesheet %}
  /* Fonts per Figma: regular Kurdis for labels/subheading/promise text, Gothic Condensed for the
     numbered badges, Parslay for the script. Enforced here (not only via Tailwind utilities) so the
     section stays correct independent of the bundle. */
  /* Figma 1653:20 / 1694:245 — card labels and the paw subheading are Kurdis Condensed ExtraBold;
     promise copy is Kurdis SemiCondensed SemiBold; the numerals are Tablet Gothic Condensed. */
  .wb-about-products__label,
  .wb-about-products__paw-sub {
    font-family: var(--font-kurdis-condensed);
    font-weight: 800;
  }

  .wb-about-products__promise-text {
    font-family: var(--font-kurdis-semi-condensed);
    font-weight: 600;
  }

  .wb-about-products__promise-num {
    font-family: "Gothic Condensed", sans-serif;
  }

  .wb-about-products__script {
    font-size: var(--script-size) !important;
    text-align: center;
    line-height: 1.1;
    margin-bottom: 40px;
  }

  @media screen and (min-width: 750px) {
    .wb-about-products__script {
      margin-bottom: 56px;
      transform: rotate(-1.28deg);
    }
  }

  /* Product grid: 2 columns on mobile, 3 from 750px. Defined here so it does not depend on
     Tailwind generating grid-cols-* for this file. */
  .wb-about-products__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    column-gap: 16px;
    row-gap: 5px;
  }

  /* Figma card = a cream plate (#F2E6DC) with the photo inset inside it and the label sitting on
     the same plate below the photo (node 1783:142). The photo does not go edge to edge. */
  .wb-about-products__cell {
    display: flex;
    flex-direction: column;
    align-items: stretch;
    background-color: #f2e6dc;
    border-radius: 14px;
    padding: 18px 18px 16px;
    box-shadow: 0 10px 24px rgba(0, 0, 0, 0.1);
  }

  /* A card with a link is an <a>, so it has to be stripped of the default link styling and keep
     the label colour the block sets. The whole tile is the hit area. */
  .wb-about-products__cell--link {
    text-decoration: none;
    color: inherit;
    cursor: pointer;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }

  .wb-about-products__cell--link:hover,
  .wb-about-products__cell--link:focus-visible {
    transform: translateY(-3px);
    box-shadow: 0 16px 30px rgba(0, 0, 0, 0.16);
  }

  @media (prefers-reduced-motion: reduce) {
    .wb-about-products__cell--link {
      transition: none;
    }
    .wb-about-products__cell--link:hover,
    .wb-about-products__cell--link:focus-visible {
      transform: none;
    }
  }

  .wb-about-products__card {
    width: 100%;
    aspect-ratio: 252 / 296;
    border-radius: 8px;
    overflow: hidden;
  }

  .wb-about-products__card-img,
  .wb-about-products__card img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .wb-about-products__label {
    display: block;
    margin-top: 12px;
    font-size: 18px;
    line-height: 1.12;
    text-align: center;
    text-transform: uppercase;
  }

  /* ---- Paw Promise ---- */
  /* Mobile: single centred column, DOM order — heading, subheading, cards (badge on top), paw. */
  .wb-about-products__paw {
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .wb-about-products__paw-left {
    text-align: center;
  }

  .wb-about-products__paw-heading {
    font-size: 44px;
    line-height: 0.9;
    text-transform: uppercase;
  }

  /* Desktop PAW PROMISE wordmark (SVG). Scales to the paw column, capped at its native width. */
  .wb-about-products__paw-heading-svg svg {
    display: block;
    width: 100%;
    /* Figma: 255 wide on mobile, 365 on desktop. */
    max-width: 265px;
    height: auto;
    margin: 0 auto;
  }

  @media screen and (min-width: 750px) {
    .wb-about-products__paw-heading-svg svg {
      max-width: 365px;
      margin: 0;
    }
  }

  /* Mobile-only line break helper (see promise_sub_break_mobile). */
  .wb-br-mobile {
    display: inline;
  }

  @media screen and (min-width: 750px) {
    .wb-br-mobile {
      display: none;
    }
  }

  .wb-about-products__paw-sub {
    font-size: 26px;
    line-height: 1.29;
    margin: 12px auto 0;
    max-width: 300px;
  }

  /* The asset is a full arm on white with ~30% white margin above it. Two background layers:
     the arm (cover + a vertical position crops the white to the arm band) multiplied over a
     gold gradient that echoes the section's own gradient — so the white knocks out to a colour
     that matches the surroundings and the multiply box has no visible edges. */
  .wb-about-products__paw-img {
    position: relative;
    /* Soft shadow under the paw (QA r75), at every width. drop-shadow follows the PNG's alpha, so
       it hugs the fur instead of boxing the element. On mobile the paw bleeds past the left edge,
       so only the top and right of the shadow are in view. */
    filter: drop-shadow(0 16px 18px rgba(27, 27, 27, 0.32));
    /* Transparent PNG cut-out (ab-bearhand.png) — shown directly, no multiply/gradient knock-out.
       Mobile (Figma 1694:245 BearHand: 642×541 ≈ the image's native ratio, bled off the left edge). */
    /* Tuning knobs (edit these numbers):
         width        — overall size of the paw block (bigger = bigger paw)
         margin-left  — negative value = how far it bleeds off the LEFT edge
         background-size — ZOOM: bigger % = closer/more zoom (100% = whole paw)
         background-position — PAN: e.g. center, left center, 30% 60% */
    width: var(--paw-width-mobile, 668px);
    max-width: none;
    align-self: flex-start;
    /* Native ratio of ab-bearhand.png (1024x863) — same as Figma's 642x541 — so the whole paw shows
       without cropping. */
    aspect-ratio: 1024 / 863;
    /* The artwork sits in the top 71% of ab-bearhand.png; the rest is transparent, so the box keeps
       running past the visible paw and reads as a gap above the footer. Figma clips that tail with
       the frame edge — do the same by bleeding the box past the section, which is overflow:hidden. */
    margin: var(--paw-top-mobile, -22px) 0 var(--paw-bleed-mobile, -148px) var(--paw-left-mobile, -339px);
    z-index: 0;
    background-image: var(--paw-img);
    background-repeat: no-repeat;
    /*
      background-position X is a percentage of the OVERFLOW, and the artwork is wider than its box,
      so a larger value slides the paw further LEFT. 112% sat too far right on a phone — the glass
      almost touched the right edge — so nudge it over.
    */
    background-position: center;
    background-size: 100% 100%;
    pointer-events: none;
  }

  .wb-about-products__paw-sticker {
    display: none; /* desktop-only accent */
  }

  .wb-about-products__promises {
    /* The paw is raised into this column on mobile; the cards stay on top of it, as in Figma. */
    position: relative;
    z-index: 1;
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 44px; /* leaves room for the number badge sitting above each card */
    margin: 44px 0 0;
    padding: 0;
  }

  .wb-about-products__promise {
    position: relative;
    border-radius: 14px;
    padding: 34px 22px 24px;
    text-align: center;
  }

  /* Per the comp the middle card is the only one off-axis — first and third sit level, the second
     lifts its right edge by 4deg. The number badge is a child, so it tilts with the card. */
  .wb-about-products__promise:nth-child(2) {
    transform: rotate(-4deg);
  }

  .wb-about-products__promise-num {
    position: absolute;
    top: -24px;
    left: 50%;
    transform: translateX(-50%);
    width: 48px;
    height: 48px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 9999px;
    font-size: 33px;
    line-height: 1;
  }

  .wb-about-products__promise-text {
    display: block;
    font-size: 15px;
    line-height: 1.29;
  }

  @media screen and (min-width: 750px) {
    /* Figma 1694:518 — the grid is 892 wide: three 288 cells with a 14px gutter. The cell's 18px
       padding leaves the photo at exactly 252x296 (the card's aspect-ratio). Capping the width here
       rather than letting it fill the 1074 container is what keeps the photo at its design size. */
    /* spacing-style interpolates the block padding between the mobile and desktop values, so this
       section's top padding is 60px at 1280 but only 42px at 768 — which shifted the script heading
       relative to the banner above. Pin it so the 30px gap holds across the whole desktop range. */
    .wb-about-products.spacing-style {
      padding-block-start: var(--prod-pad-top-desktop, 60px) !important;
    }

    .wb-about-products__grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      max-width: 892px;
      margin-inline: auto;
      column-gap: 14px;
      row-gap: 19px;
    }

    /* Figma: 21px from the photo down to the label. */
    .wb-about-products__label {
      margin-top: 21px;
    }

    /* Desktop: heading top-left, paw bottom-left, cards span the right column. */
    .wb-about-products__paw {
      display: grid;
      /* Same 892 width as the product grid above, and inside it the Figma columns fall out exactly:
         397 heading column + 47 gutter + 448 promise card (node 1694:518). The promise column is a
         fixed width so the cards do not get squeezed on tablet — with 1fr 1fr they shrank to ~357px
         at 820 and the copy wrapped into a narrow ribbon (QA r33). */
      max-width: 892px;
      margin-inline: auto;
      grid-template-columns: minmax(0, 1fr) 448px;
      grid-template-areas:
        "head cards"
        "paw  cards";
      column-gap: 47px;
      row-gap: 0;
      align-items: start;
      /* 46px below the product grid (QA r27). Set here rather than as a Tailwind utility so it does
         not depend on the arbitrary-value class being generated at build time. */
      margin-top: 46px !important;
    }

    .wb-about-products__paw-left {
      grid-area: head;
      text-align: left;
    }

    .wb-about-products__promises {
      grid-area: cards;
      /* Keep the cards above the paw, which is later in the DOM and would otherwise paint over them. */
      position: relative;
      z-index: 1;
    }

    .wb-about-products__paw-img {
      grid-area: paw;
      align-self: end;
    }

    .wb-about-products__paw-heading {
      font-size: 72px;
    }

    .wb-about-products__paw-sub {
      margin: 16px 0 0;
      max-width: 340px;
    }

    .wb-about-products__paw-img {
      width: 617px;
      /* Figma lets the paw run under the promise cards; it just sits behind them (z-index below).
         The cap only stops it overshooting the screen once the column narrows on tablet — at the
         1280 design width (397 + 220 = 617) it is inert. */
      max-width: calc(100% + 220px);
      aspect-ratio: 1087 / 608;
      /* bleed off the left edge of the content column (clipped by the section's overflow:hidden) */
      margin: 5px 0 0 -197px;
      background-position: 86% 43%;
      /* zoom: bigger % = closer (tune here / in console). cover = minimum fill. */
      background-size: 130%;
    }

    .wb-about-products__paw-sticker {
      display: block;
      position: absolute;
      top: 17%;
      left: 28%;
      width: 76px;
      height: auto;
      transform: rotate(-10deg);
    }

    /* Tablet: the paw is pinned at -173 so it can bleed off the left edge, which takes 28% of it
       off screen and with it the sticker. Park the sticker just inside the viewport instead. */
    @media screen and (max-width: 1023px) {
      .wb-about-products__paw-sticker {
        left: 193px;
      }
    }

    .wb-about-products__promises {
      gap: 28px;
      margin: 0;
      padding-left: 0;
    }

    .wb-about-products__promise {
      padding: 32px 36px;
    }

    .wb-about-products__promise-num {
      top: 50%;
      left: -24px;
      transform: translateY(-50%);
      /* Badge enlarged from the original 48px; the digit is 33px per Figma 1653:20. */
      width: 58px;
      height: 58px;
      font-size: 33px;
    }
  }

  @media screen and (max-width: 1023px) {
    .wb-about-products__script {
      font-size: var(--script-size-mobile) !important;
      margin-bottom: 20px;
    }
  }

  /* Mobile: bigger number badges to match the Figma mobile design (digit 25px). Scoped to < 750px
     so the desktop badge (48px / 20px) is untouched. */
  @media screen and (max-width: 749px) {
    /*
      Card labels have to sit on ONE line (Figma). In Kurdis the longest label, "Cold Brew
      Concentrate", measures 273px at 18px — it cannot be squeezed into a half-of-375 card no matter
      how the padding is tuned. So mobile switches the label to the condensed face (137px at 14px)
      and the cards are widened toward the mockup: smaller page gutter, tighter column gap and less
      card padding, which also lets the photo fill more of the card as the design shows.
      Desktop is not matched here and keeps Kurdis at 18px.
    */
    .wb-about-products__container {
      padding-left: 12px;
      padding-right: 12px;
    }

    .wb-about-products__grid {
      column-gap: 10px;
    }

    /* Figma 1694:245: the label clears the tile's bottom edge by 11px. */
    .wb-about-products__cell {
      padding: 12px 12px 11px;
    }

    /* Mobile corners are tighter than desktop's across the page: the tiles are roughly half the
       width here, so the desktop radius eats a visible share of a short edge and reads as soft. */
    .wb-about-products__cell,
    .wb-about-products__promise {
      border-radius: 8px;
    }

    /* Kept a step below the tile so the photo's corner sits inside the frame's, not against it. */
    .wb-about-products__card {
      border-radius: 6px;
    }

    /* Figma 1694:245: card labels drop to 13px on mobile and stay on one line. */
    .wb-about-products__label {
      font-size: 13px;
      white-space: nowrap;
    }

    .wb-about-products__script {
      padding-left: 28px;
      padding-right: 28px;
    }
    .wb-about-products__paw-heading {
      font-size: 54px;
    }
    .wb-about-products__paw-left {
      text-align: center;
      margin-bottom: 75px;
    }
    .wb-about-products__paw-sub {
      font-size: 16px;
      line-height: 1.29;
      /* Figma 1694:245: the sub-line sits 11px under the outlined PAW PROMISE glyphs. */
      margin: 11px auto 0;
      max-width: 315px;
    }
    .wb-about-products__promise {
      padding: 40px 22px 24px;
    }
    .wb-about-products__promise-num {
      width: 52px;
      height: 52px;
      top: -26px;
      font-size: 25px;
      line-height: 1.29;
    }
    /* Figma: the promise copy is #1B1B1B on desktop but #431A03 on mobile, so the inline desktop
       colour has to be overridden here. Liquid is not evaluated inside {% stylesheet %}, so the
       value arrives as a custom property set on the section wrapper. */
    .wb-about-products__promise-text {
      font-size: 13px;
      color: var(--promise-text-color-mobile, #431A03) !important;
    }
    .wb-about-products__promises {
      /* Figma mobile: the badge of the next card clears the one above by 6px. The badge overhangs
         its own card by 26, so the plates sit 32 apart (QA r67). */
      gap: 32px;
      max-width: 265px;
      margin-left: auto;
      margin-right: auto;
      /* Figma mobile: the "1" badge sits right under the subheading (QA r59). */
      margin-top: -24px;
    }
    /* Figma mobile: 48 from the product grid down to the PAW PROMISE lockup (QA r59). */
    .wb-about-products__paw {
      margin-top: 48px !important;
    }
    /* Figma mobile grid order: On Tap, Cartons, Kegs, Concentrate, Cans, Lattes
       (swap the 3rd/4th cards — Concentrate <-> Kegs — mobile only; desktop grid unchanged). */
    .wb-about-products__cell:nth-child(1) { order: 1; }
    .wb-about-products__cell:nth-child(2) { order: 2; }
    .wb-about-products__cell:nth-child(3) { order: 4; }
    .wb-about-products__cell:nth-child(4) { order: 3; }
    .wb-about-products__cell:nth-child(5) { order: 5; }
    .wb-about-products__cell:nth-child(6) { order: 6; }
  }
{% endstylesheet %}

{% schema %}
