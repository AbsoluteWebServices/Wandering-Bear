      "default": "#BF8F38"
    },
    {
      "type": "color",
      "id": "paw_blend_color",
      "label": "Paw blend color (bottom)",
      "default": "#B27A0F"
    },
    { "type": "text", "id": "paw_top_mobile", "label": "Paw top offset — mobile px (negative = higher)" },
    {
      "type": "image_picker",
      "id": "paw_sticker",
      "label": "Paw sticker (desktop)"
    },
    {
      "type": "text",
      "id": "paw_sticker_preview",
      "label": "Paw sticker preview asset (dev only)"
    },
    {
      "type": "color",
      "id": "card_bg",
      "label": "Promise card color",
      "default": "#F2E6DC"
    },
    {
      "type": "color",
      "id": "number_bg",
      "label": "Number circle color",
      "default": "#1B1B1B"
    },
    {
      "type": "color",
      "id": "number_color",
      "label": "Number color",
      "default": "#F2E6DC"
    },
    {
      "type": "color",
      "id": "promise_text_color",
      "label": "Promise text color",
      "default": "#2A1A0F"
    },
    {
      "type": "color",
      "id": "promise_text_color_mobile",
      "label": "Promise text color — mobile",
      "default": "#431A03"
    },
    { "type": "text", "id": "promise_sub_break_mobile", "label": "Subheading: break before this phrase on mobile" },
    {
      "type": "header",
