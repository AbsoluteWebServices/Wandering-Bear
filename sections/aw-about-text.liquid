{% comment %}
  About Us text block — heading + rich text, one column, optional cream plate + stickers.
  Figma: WB Website 1653:20. Reused for the several copy sections on the page
  ("A Coffee Shop In Your Fridge", "We Believe…", "So How Do We Do It?").

  The column can sit left / centre / right so the same section covers blocks that hug either
  edge of the layout. Rich text carries the gold highlights and links from the design.
{% endcomment %}

{% liquid
  assign s = section.settings

  # Optional mobile-only line break: the phrase in body_break_mobile gets a <br> in front of it,
  # hidden from the desktop breakpoint up. Injected here rather than typed into the setting because
  # Shopify strips class attributes from authored HTML.
  assign body_html = s.body
  assign body_break_phrase = s.body_break_mobile | default: 'our mission'
  if body_break_phrase != blank
    capture body_break
      echo '<br class="wb-br-mobile">'
      echo body_break_phrase
    endcapture
    assign body_html = body_html | replace: body_break_phrase, body_break
  endif
  assign color_scheme = s.color_scheme
  assign text_color = s.text_color | default: '#1B1B1B'

  assign align_class = 'mx-auto text-center'
  if s.align == 'left'
    assign align_class = 'mr-auto text-left'
  elsif s.align == 'right'
    assign align_class = 'ml-auto text-left'
  endif

  # Heading can align independently of the body (e.g. centred title over left-aligned copy).
  assign title_align = s.title_align | default: 'inherit'

  # The heading is Kurdis Condensed ExtraBold, but on a quoted title the quotation marks stay at the
  # regular weight per the design. They are always the first and last characters, so wrap them here
  # rather than asking an editor to author markup — Shopify strips class attributes from HTML typed
  # into a setting, and an auto theme pull would overwrite it anyway. Sections whose title carries
  # no curly quotes are untouched. The closing mark is handled first, while the offsets still refer
  # to the raw string.
  assign title_html = s.title | replace: '\b', '<br>'
  assign last_index = title_html | size | minus: 1
  assign last_char = title_html | slice: last_index
  if last_char == '”'
    assign title_head = title_html | slice: 0, last_index
    assign title_html = title_head | append: '<span class="wb-about-text__title-quote">”</span>'
  endif
  assign first_char = title_html | slice: 0
  if first_char == '“'
    assign title_tail = title_html | slice: 1, 9999
    assign title_html = '<span class="wb-about-text__title-quote">“</span>' | append: title_tail
  endif
%}

{% capture type_styles %}
  --font-size: {{ s.font_size | default: 40 }}px;
  --font-size-mobile: {{ s.font_size_mobile | default: 20 }}px;
{% endcapture %}

{%- comment -%}
  Absolute mode: lifts the whole section out of flow so it can overlap its neighbours, then
  nudges it with a transform. left/right:0 keep it full width; section_shift_y negative = up,
  section_shift_x positive = right. The following sections close the gap it leaves behind.
{%- endcomment -%}
{%- comment -%}
  The sideways nudge is a flat px value, so on a narrower screen it keeps pushing a fixed-width
  plate past the right edge and the copy gets cut off. section_shift_x_cap supplies a ceiling that
  shrinks with the viewport — e.g. calc(50vw - 430px) — so the shift tapers off and eventually goes
  negative, parking the plate against the edge instead of beyond it. No breakpoint, no jump.
{%- endcomment -%}
{% liquid
  assign shift_x_css = s.section_shift_x | default: 0 | append: 'px'
  if s.section_shift_x_cap != blank
    assign shift_x_css = 'min(' | append: shift_x_css | append: ', ' | append: s.section_shift_x_cap | append: ')'
  endif
%}
{% capture section_pos %}
  {%- if s.section_abs -%}position: absolute; left: 0; right: 0; top: {{ s.section_abs_top | default: '0' }};{%- endif -%}
  {%- if s.section_z != blank -%} z-index: {{ s.section_z }};{%- endif -%}
  {%- if s.section_shift_x != blank or s.section_shift_y != blank -%} transform: translate({{ shift_x_css }}, {{ s.section_shift_y | default: 0 }}px);{%- endif -%}
{% endcapture %}

<div
  class="wb-about-text wb-about-text--{{ section.id }} relative overflow-hidden spacing-style wb-section-bg"
  style="{% render 'section-background', settings: s, part: 'style', fallback_color: color_scheme.settings.background %} {% render 'spacing-style', settings: s %} {{ type_styles }}{% if s.panel %} margin-top: -{{ s.panel_overlap | default: 0 }}px;{% if s.section_min_height != blank %} min-height: {{ s.section_min_height }}px;{% endif %}{% endif %}{{ section_pos }}"
  {{ section.shopify_attributes }}
>
  {% render 'section-background', settings: s, part: 'media' %}

  {%- comment -%}
    Optional cream plate behind the copy. Absolutely positioned so it can be freely placed —
    top / left / width / height are all editable (px, negative allowed to overshoot the edge).
    The copy lives INSIDE the plate; the inner container keeps it in the on-screen column.
    With no plate, the copy sits in a normal centred container instead.
  {%- endcomment -%}
  {% if s.panel %}
    {%- comment -%}
      Plate placement, chosen by panel_align:
      · left   — absolute left/width in px; the plate can overshoot the edge and the copy gets a
                 left inset that cancels the offset so it still lands on screen.
      · center — mx-auto within the parent; width is a % of the parent (default 50 = half).
      · right  — flush to the right edge (offset by panel_right px); width is a % of the parent,
                 so a value a bit over 50 has the left edge sit just past the middle.
      Center / right use panel_content_left / right directly for the copy padding.
    {%- endcomment -%}
    {% liquid
      assign content_left = s.panel_content_left | default: 40
      assign pad_right = s.panel_content_right | default: 40
      assign plate_align = s.panel_align | default: 'center'
      assign plate_width_pct = s.panel_width_pct | default: 50

      # Plate width: raw override (e.g. "58%") wins; else % for center/right, px for left.
      if s.panel_width_css != blank
        assign width_css = s.panel_width_css
      elsif plate_align == 'left'
        assign plate_width = s.panel_width | default: 1201
        assign width_css = plate_width | append: 'px'
      else
        assign width_css = plate_width_pct | append: '%'
      endif

      # Horizontal placement + on-screen inset for the copy.
      if s.panel_left_css != blank
        # Manual left override (e.g. "50%"): plain left + width, no transform.
        assign plate_pos = 'left: ' | append: s.panel_left_css | append: '; width: ' | append: width_css | append: ';'
        assign pad_left = content_left
      elsif plate_align == 'center'
        assign plate_pos = 'left: 50%; transform: translateX(-50%); width: ' | append: width_css | append: ';'
        assign pad_left = content_left
      elsif plate_align == 'right'
        if s.panel_right_css != blank
          assign right_css = s.panel_right_css
        else
          assign plate_right = s.panel_right | default: 0
          assign right_css = plate_right | append: 'px'
        endif
        assign plate_pos = 'right: ' | append: right_css | append: '; width: ' | append: width_css | append: ';'
        assign pad_left = content_left
      else
        assign plate_left = s.panel_left | default: -341
        assign plate_left_abs = 0 | minus: plate_left
        assign pad_left = plate_left_abs | plus: content_left
        assign plate_pos = 'left: ' | append: plate_left | append: 'px; width: ' | append: width_css | append: ';'
      endif

      # Copy padding: raw overrides (e.g. "59%") win; else computed px values.
      if s.panel_pad_left_css != blank
        assign pad_left_css = s.panel_pad_left_css
      else
        assign pad_left_css = pad_left | append: 'px'
      endif
      if s.panel_pad_right_css != blank
        assign pad_right_css = s.panel_pad_right_css
      else
        assign pad_right_css = pad_right | append: 'px'
      endif

      # Corner radius: single value by default, or split left / right if those are set.
      assign radius = s.panel_radius | default: 48
      assign radius_left = s.panel_radius_left | default: radius
      assign radius_right = s.panel_radius_right | default: radius
      # order: top-left top-right bottom-right bottom-left
      assign plate_radius = radius_left | append: 'px ' | append: radius_right | append: 'px ' | append: radius_right | append: 'px ' | append: radius_left | append: 'px'

      # top: raw override (e.g. "15%") wins; else px.
      if s.panel_top_css != blank
        assign top_css = s.panel_top_css
      else
        assign top_css = s.panel_top | default: 0 | append: 'px'
      endif
    %}
    {%- comment -%}
      The gold call-out is styled by .text-gold in the stylesheet below, not by a last-child rule:
      it is only the last paragraph in the fridge block. In "so how do we do it" the last paragraph
      is "Check out our <pill>" and in "super premium" it is the whole body, so a last-child rule
      set those in the condensed display face by mistake.
    {%- endcomment -%}
    <div
      class="wb-about-text__plate absolute z-0"
      style="background: {{ s.panel_color | default: '#F2E6DC' }}; top: {{ top_css }}; {{ plate_pos }} {% if s.panel_height != blank %}height: {{ s.panel_height }}px;{% elsif s.panel_min_height != blank %}min-height: {{ s.panel_min_height }};{% else %}bottom: 0;{% endif %} border-radius: {{ plate_radius }};{% if s.panel_shadow != blank %} box-shadow: {{ s.panel_shadow }};{% endif %}{% if s.panel_margin_bottom != blank %} margin-bottom: {{ s.panel_margin_bottom }}px;{% endif %}"
    >
      {%- comment -%}
        Plate content. Two layouts:
        · two_col — a flex row: image column (side_image) + text column. Plain flow, no absolute.
        · default — a single vertically-centred copy column (col_valign / col_abs for placement).
      {%- endcomment -%}
      {% capture copy_html %}
        {%- comment -%} Mobile-only icon centred above the title (e.g. the crown over "Super Premium?"). {%- endcomment -%}
        {% if s.mobile_top_icon != blank %}
          <img src="{{ s.mobile_top_icon | asset_url }}" alt="" class="wb-about-text__mobile-icon smd:!hidden" style="width: {{ s.mobile_top_icon_width | default: 46 }}px;" loading="lazy">
        {% endif %}
        {% if s.title != blank %}
          <h2 class="wb-about-text__title {{ s.title_style | default: 'display-md' }} wb-about-text__title-size leading-[1.1] uppercase mb-5" style="color: {{ text_color }};{% if title_align != 'inherit' %} text-align: {{ title_align }};{% endif %}">
            {{ title_html }}
          </h2>
        {% endif %}
        {% if s.body != blank %}
          <div class="wb-about-text__body wb-about-text-body body [&_strong]:font-bold font-semibold font-(family-name:var(--font-kurdis-semi-condensed))! leading-[1.4]" style="color: {{ text_color }};">
            {{ body_html }}
          </div>
        {% endif %}
        {%- comment -%} Optional gold underline flourish centred under the copy (Figma). {%- endcomment -%}
        {% if s.bottom_flourish %}
          <span class="wb-about-text__flourish" style="color: {{ s.flourish_color | default: '#AF7404' }};" aria-hidden="true">
            <svg width="130" height="9" viewBox="0 0 130 9" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M0 4.64498C2.09425 4.40444 4.35751 4.17337 6.45606 3.98355C25.9323 2.26982 45.4333 1.71366 64.9353 2.06405C84.4127 2.47124 103.911 3.81124 123.122 7.3586C125.244 7.75391 127.393 8.18673 129.5 8.64498C127.425 8.05738 125.302 7.50056 123.202 6.98712C104.173 2.37167 84.5378 0.470927 64.9745 0.0644352C45.3803 -0.288361 25.7913 0.81574 6.411 3.60623C4.32398 3.91552 2.07491 4.27252 0 4.64498Z" fill="currentColor"/></svg>
          </span>
        {% endif %}
      {% endcapture %}

      {% if s.two_col %}
        {% liquid
          assign tc_src = ''
          if s.side_image != blank
            assign tc_src = s.side_image | image_url: width: 1200
          elsif s.side_image_preview != blank
            assign tc_src = s.side_image_preview | asset_url
          endif
          assign tc_align = s.two_col_valign | default: 'center'
          assign tc_align_css = 'center'
          if tc_align == 'start'
            assign tc_align_css = 'flex-start'
          elsif tc_align == 'end'
            assign tc_align_css = 'flex-end'
          endif
          assign tc_text = 'text-left'
          if s.align == 'center'
            assign tc_text = 'text-center'
          elsif s.align == 'right'
            assign tc_text = 'text-right'
          endif
        %}
        <div class="wb-about-text__plate-inner relative z-[1] h-full flex flex-row"
             style="align-items: {{ tc_align_css }}; padding-left: {{ pad_left_css }}; padding-right: {{ pad_right_css }}; gap: {{ s.two_col_gap | default: 24 }}px;">
          {% if tc_src != blank %}
            {%- comment -%}
              side_fit: image column fills the plate height, its bottom flush to the plate bottom,
              and pokes out the top by side_overflow_top px (height 100%+N, margin-top -N).
              Otherwise it uses a fixed side_height.
            {%- endcomment -%}
            {% assign side_ot = s.side_overflow_top | default: 0 %}
            <div class="wb-about-text__img-col shrink-0"
                 style="width: {{ s.side_width | default: 289 }}px; {% if s.side_fit %}height: calc(100% + {{ side_ot }}px); margin-top: -{{ side_ot }}px;{% else %}height: {{ s.side_height | default: 358 }}px;{% endif %} background-image: url('{{ tc_src }}'); background-size: {{ s.side_bg_size | default: '100% auto' }}; background-position: {{ s.side_bg_pos | default: 'top center' }}; background-repeat: no-repeat;{% if s.side_bg != blank %} background-color: {{ s.side_bg }};{% endif %}"
                 role="img" aria-label="{{ s.side_image.alt }}"></div>
          {% endif %}
          <div class="wb-about-text__col {{ tc_text }} flex-1 min-w-0" style="max-width: {{ s.column_width | default: 566 }}px;{% if s.col_pad_top != blank %} padding-top: {{ s.col_pad_top }}px;{% endif %}{% if s.col_pad_bottom != blank %} padding-bottom: {{ s.col_pad_bottom }}px;{% endif %}">
            {{ copy_html }}
          </div>
        </div>
      {% else %}
        {% liquid
          assign col_justify = 'justify-center'
          if s.col_valign == 'top'
            assign col_justify = 'justify-start'
          elsif s.col_valign == 'bottom'
            assign col_justify = 'justify-end'
          endif
          # Mobile-only photo tucked into the top of the plate (Figma mobile shows the sourcing shot
          # full-bleed at the top of the "So how do we do it?" plate). Uses the same side image asset.
          assign mtop_src = ''
          if s.side_image != blank
            assign mtop_src = s.side_image | image_url: width: 900
          elsif s.side_image_preview != blank
            assign mtop_src = s.side_image_preview | asset_url
          endif
        %}
        <div class="wb-about-text__plate-inner relative z-[1] h-full flex flex-col {{ col_justify }}"
             style="padding-left: {{ pad_left_css }}; padding-right: {{ pad_right_css }};">
          {% if s.side_show_mobile_top and mtop_src != blank %}
            <div class="wb-about-text__mobile-photo smd:!hidden" role="img" aria-label="{{ s.side_image.alt }}"
                 style="background-image: url('{{ mtop_src }}'); background-position: {{ s.side_mobile_pos | default: 'center 68%' }};"></div>
          {% endif %}
          <div class="wb-about-text__col {{ align_class }}{% unless s.col_abs %} relative w-full{% endunless %}" style="{% if s.col_abs %}position: absolute; top: {{ s.col_top | default: '50%' }}; left: {{ s.col_left | default: '0' }};{% if s.col_width != blank %} width: {{ s.col_width }};{% endif %} max-width: none;{% else %}max-width: {{ s.column_width | default: 566 }}px;{% endif %}{% if s.col_pad_top != blank %} padding-top: {{ s.col_pad_top }}px;{% endif %}{% if s.col_pad_bottom != blank %} padding-bottom: {{ s.col_pad_bottom }}px;{% endif %}">
            {{ copy_html }}
          </div>
        </div>
      {% endif %}

      {% comment %} Plate stickers (default). on_section stickers render at section level instead. {% endcomment %}
      {% for block in section.blocks %}
        {% if block.type == 'sticker' and block.settings.on_section != true %}
          {% render 'aw-sticker', block: block %}
        {% endif %}
      {% endfor %}
    </div>

    {%- comment -%}
      Fluid desktop ("fixed text, elastic filler").

      The plate is authored as a % of the viewport, but the copy column used to be positioned with a
      % padding too — so narrowing the window squeezed the column, the (fixed-size) type re-wrapped,
      grew taller and got clipped by the plate's fixed height.

      Here the copy column keeps a FIXED width and a FIXED gutter on the side it hugs, so its line
      breaks, height and typography are identical at every width. Only the empty part of the plate
      absorbs the shrink. min-width stops the plate from ever crushing the column.

      Geometry is unchanged at the design width: e.g. fridge 1114 − 78 − 379 = 657 = the authored
      inset. Mobile (< 750px) is not matched and keeps the stacked layout.
    {%- endcomment -%}
    {% if s.fluid_desktop %}
      {% liquid
        assign f_text = s.fluid_text_width | default: 380
        assign f_pad = s.fluid_pad | default: 78
        assign f_gap = s.fluid_min_filler | default: 24
        assign f_min = f_text | plus: f_pad | plus: f_gap

        # A raw CSS gutter (e.g. "calc(81.967% - 493.5px)") lets the copy line up with something
        # outside this section — the hero photo's edge — instead of a flat px inset. Percentages here
        # resolve against the plate, so the value is pre-solved against the plate's own width.
        # With a dynamic gutter the plate needs no computed min-width, so it stays opt-in.
        assign f_pad_css = f_pad | append: 'px'
        if s.fluid_pad_css != blank
          assign f_pad_css = s.fluid_pad_css
          assign f_min = s.fluid_plate_min | default: 0
        endif
      %}
      {% style %}
        @media screen and (min-width: 750px) {
          .wb-about-text--{{ section.id }} .wb-about-text__plate {
            min-width: {{ f_min }}px;
            {%- comment -%}
              Re-anchor the plate to a viewport edge so that, once min-width kicks in, it grows AWAY
              from that edge instead of pushing itself off screen (a plate placed with left: 50%
              would otherwise widen past the right edge).
            {%- endcomment -%}
            {% if s.fluid_plate_edge == 'right' %}
              left: auto !important;
              right: 0 !important;
              transform: none !important;
            {% elsif s.fluid_plate_edge == 'left' %}
              left: 0 !important;
              right: auto !important;
              transform: none !important;
            {% endif %}
          }
          .wb-about-text--{{ section.id }} .wb-about-text__plate-inner {
            {% if s.fluid_anchor == 'left' %}
              padding-left: {{ f_pad_css }} !important;
              padding-right: 0 !important;
            {% else %}
              padding-left: 0 !important;
              padding-right: {{ f_pad_css }} !important;
            {% endif %}
          }
          .wb-about-text--{{ section.id }} .wb-about-text__col {
            width: {{ f_text }}px !important;
            max-width: 100% !important;
            {% if s.fluid_anchor == 'left' %}
              margin-left: 0 !important;
              margin-right: auto !important;
            {% else %}
              margin-left: auto !important;
              margin-right: 0 !important;
            {% endif %}
          }
          {%- comment -%}
            Side photo glued to the plate's right edge.

            It used to be placed from the viewport centre (left: calc(50% + Npx)) while the plate's
            right edge sits at a different percentage — so the two drifted apart as the window
            narrowed and the photo floated off to the right. Driving it from the SAME expression as
            the plate width (min-width included) keeps the gap constant at every width.
          {%- endcomment -%}
          {% if s.side_track_plate %}
            .wb-about-text--{{ section.id }} .wb-about-text__side {
              left: calc(max({{ width_css }}, {{ f_min }}px) + {{ s.side_track_offset | default: 0 }}px) !important;
            }
            {%- comment -%}
              Section-level ("on_section") stickers sit on that photo, so drive them from the same
              expression — otherwise they slide across it as the window narrows. Offset is measured
              from the plate's right edge to the sticker's centre.
            {%- endcomment -%}
            {% if s.side_badge_offset != blank %}
              {%- comment -%}
                Vertical anchor. side_badge_bottom measures up from the photo's BOTTOM edge, so the
                badge keeps its corner when the photo is resized; side_badge_top is the raw
                distance from the plate top (the photo starts there) for free placement.
              {%- endcomment -%}
              {% liquid
                assign badge_top = s.side_badge_top
                if s.side_badge_bottom != blank
                  assign ph_top = s.side_top | default: 0
                  assign ph_h = s.side_height | default: 367
                  assign badge_top = ph_top | plus: ph_h | minus: s.side_badge_bottom
                endif
              %}
              .wb-about-text--{{ section.id }} > .aw-sticker {
                {%- comment -%} The badge rides the plate's right edge, which on a narrow desktop
                   window puts it past the viewport. min() caps it so it always stays on screen;
                   at the design width the cap is inert. {%- endcomment -%}
                left: min(calc(max({{ width_css }}, {{ f_min }}px) + {{ s.side_badge_offset }}px), calc(100% - {{ s.side_badge_cap | default: 58 }}px)) !important;
                {% comment %} top/width in px so the badge holds its corner of the photo and stays legible. {% endcomment %}
                {% if badge_top != blank %}top: {{ badge_top }}px !important;{% endif %}
                {% if s.side_badge_width != blank %}width: {{ s.side_badge_width }}px !important;{% endif %}
              }
            {% endif %}
          {% endif %}
        }

        {%- comment -%}
          Tablet (750-1023). The fluid model assumes there is room for the fixed copy column plus the
          side photo side by side; below ~1024 the plate hits its min-width and the photo (and the
          badge riding on it) run off the right edge. Keep the two columns — and the copy width, so
          the line breaks never change — but let the plate fill the screen, give the copy a gutter,
          and shrink the photo into whatever is left.
        {%- endcomment -%}
        {% if s.tablet_fit %}
          @media screen and (min-width: 750px) and (max-width: 1023px) {
            .wb-about-text--{{ section.id }} .wb-about-text__plate {
              min-width: 0 !important;
              width: 100% !important;
              left: 0 !important;
              right: auto !important;
            }
            .wb-about-text--{{ section.id }} .wb-about-text__plate-inner {
              padding-left: {{ s.tablet_pad | default: 24 }}px !important;
              padding-right: 0 !important;
            }
            .wb-about-text--{{ section.id }} .wb-about-text__col {
              margin-left: 0 !important;
              margin-right: auto !important;
            }
            {% if s.side_track_plate %}
              {%- liquid
                assign t_pad = s.tablet_pad | default: 24
                assign t_gap = s.tablet_gap | default: 24
                assign t_edge = s.tablet_edge | default: 16
                assign t_text = s.fluid_text_width | default: 380
                assign t_reserved = t_pad | plus: t_text | plus: t_gap | plus: t_edge
              -%}
              .wb-about-text--{{ section.id }} .wb-about-text__side {
                left: auto !important;
                right: {{ t_edge }}px !important;
                width: min({{ s.side_width | default: 313 }}px, calc(100% - {{ t_reserved }}px)) !important;
              }
              .wb-about-text--{{ section.id }} > .aw-sticker {
                left: auto !important;
                right: {{ s.tablet_badge_right | default: 0 }}px !important;
              }
            {% endif %}
          }
        {% endif %}
      {% endstyle %}
    {% endif %}

    {%- comment -%}
      Mobile (< 750px): the plate is absolutely placed with px sizes tuned for desktop, which on a
      narrow screen truncate the copy and overlap the neighbouring sections. Per the mobile spec,
      drop the plate back into normal flow — full width with a small gutter, height driven by its
      content — and clear the desktop overlap / min-height / shift so the sections simply stack.
      For two-column plates (image + text) the columns stack vertically. Desktop (>=750px) is
      never matched by this query, so it stays exactly as authored.
    {%- endcomment -%}
    {% style %}
      @media screen and (max-width: 749px) {
        .wb-about-text--{{ section.id }} {
          margin-top: 0 !important;
          min-height: 0 !important;
          transform: none !important;
          position: relative !important;
          top: auto !important;
        }
        .wb-about-text--{{ section.id }} .wb-about-text__plate {
          position: relative !important;
          top: auto !important;
          left: auto !important;
          right: auto !important;
          bottom: auto !important;
          width: auto !important;
          height: auto !important;
          min-height: 0 !important;
          transform: none !important;
          margin: 0 {% if s.plate_hide_mobile %}0{% else %}{{ s.plate_gutter_mobile | default: 16 }}px{% endif %} {{ s.plate_margin_bottom_mobile | default: 36 }}px !important;
          {% comment %} overflow visible when a photo pokes out of the plate top; otherwise clip to the radius. {% endcomment %}
          overflow: {% if s.side_show_mobile_top %}visible{% else %}hidden{% endif %} !important;
          {%- comment -%}
            On desktop the plate runs off the left edge of the screen, so its left corners are
            authored square. On mobile it sits inset from BOTH edges, so that asymmetry looks like a
            bug — round every corner instead. The card also lifts off the photo it overlaps, which is
            what the drop shadow reads as.
          {%- endcomment -%}
          {% if s.plate_radius_mobile != blank %}border-radius: {{ s.plate_radius_mobile }}px !important;{% endif %}
          {% if s.plate_shadow_mobile != blank %}box-shadow: {{ s.plate_shadow_mobile }} !important;{% endif %}
          {% comment %} plate_hide_mobile: the "blue field" sections (believe / premium) drop the plate
             so the centred copy sits straight on the page background, per the Figma mobile design. {% endcomment %}
          {% if s.plate_hide_mobile %}background: transparent !important; box-shadow: none !important;{% endif %}
        }
        {% if s.side_show_mobile_top %}
        .wb-about-text--{{ section.id }} .wb-about-text__mobile-photo {
          display: block !important;
          align-self: center !important;
          {% comment %} 20% narrower than the plate, centred, and poked ~20% of its height above the plate top. {% endcomment %}
          width: {{ s.side_mobile_width_pct | default: 92 }}% !important;
          margin: -{{ s.side_mobile_poke | default: 80 }}px auto {{ s.side_mobile_gap | default: 34 }}px !important;
          aspect-ratio: {{ s.side_mobile_aspect | default: '16 / 11' }} !important;
          border-radius: {{ s.side_radius_mobile | default: 18 }}px !important;
          background-size: {{ s.side_mobile_zoom | default: '135%' }} !important;
          background-repeat: no-repeat !important;
        }
        {% endif %}
        .wb-about-text--{{ section.id }} .wb-about-text__plate-inner {
          position: relative !important;
          display: flex !important;
          flex-direction: column !important;
          align-items: center !important;
          height: auto !important;
          {% comment %} Plateless (blue-field) sections still need horizontal padding so the centred copy
             is inset from the screen edge; the cream plates keep their full padding. {% endcomment %}
          padding: {% if s.plate_hide_mobile %}0 {{ s.plate_pad_x_mobile | default: 26 }}px{% else %}{{ s.plate_pad_y_mobile | default: 28 }}px {{ s.plate_pad_x_mobile | default: 22 }}px{% endif %} !important;
          {% comment %} plate_pad_y_mobile is a single Y value; Figma's mobile plate is asymmetric
             (23 above the title, 15 below the copy), so allow the bottom to be set on its own. {% endcomment %}
          {% if s.plate_pad_bottom_mobile != blank %}padding-bottom: {{ s.plate_pad_bottom_mobile }}px !important;{% endif %}
          gap: {{ s.plate_stack_gap_mobile | default: 18 }}px !important;
        }
        {% comment %} The gold flourish under the copy is desktop-only in the mobile frame. {% endcomment %}
        {% if s.flourish_hide_mobile %}
          .wb-about-text--{{ section.id }} .wb-about-text__flourish { display: none !important; }
        {% endif %}
        .wb-about-text--{{ section.id }} .wb-about-text__col {
          position: relative !important;
          top: auto !important;
          left: auto !important;
          width: 100% !important;
          max-width: none !important;
          padding-top: 0 !important;
          {% unless s.text_center_mobile == false %}text-align: center !important; margin-left: auto !important; margin-right: auto !important;{% endunless %}
          {% if s.col_pad_bottom_mobile != blank %}padding-bottom: {{ s.col_pad_bottom_mobile }}px !important;{% endif %}
        }
        {% comment %} Figma's mobile frame runs the first two body paragraphs together as one block,
           so the blank line between them is dropped (QA r42). {% endcomment %}
        {% if s.merge_paras_mobile %}
          {% comment %} Closing the gap still left a line break, since the paragraphs are blocks.
             Running them inline makes the copy continue on the same line, with ::before supplying
             the sentence space the markup no longer provides. {% endcomment %}
          .wb-about-text--{{ section.id }} .wb-about-text__body > p:nth-of-type(1),
          .wb-about-text--{{ section.id }} .wb-about-text__body > p:nth-of-type(2) {
            display: inline !important;
            margin-top: 0 !important;
          }
          .wb-about-text--{{ section.id }} .wb-about-text__body > p:nth-of-type(2)::before {
            content: " ";
          }
        {% endif %}
        {% if s.body_pad_x_mobile != blank %}
          .wb-about-text--{{ section.id }} .wb-about-text__body {
            padding-left: {{ s.body_pad_x_mobile }}px !important;
            padding-right: {{ s.body_pad_x_mobile }}px !important;
          }
        {% endif %}
        {% comment %} Two-column text column (Super Premium): extra side padding on mobile. {% endcomment %}
        .wb-about-text--{{ section.id }} .wb-about-text__col.flex-1 {
          padding-left: 10px !important;
          padding-right: 10px !important;
        }
        {% unless s.text_center_mobile == false %}
        .wb-about-text--{{ section.id }} .wb-about-text__title { text-align: center !important; }
        {% endunless %}
        .wb-about-text--{{ section.id }} .wb-about-text__img-col {
          width: 100% !important;
          height: {{ s.side_height_mobile | default: 240 }}px !important;
          margin-top: 0 !important;
          border-radius: {{ s.side_radius_mobile | default: 12 }}px !important;
          order: {{ s.two_col_img_order_mobile | default: 2 }};
          {% if s.two_col_img_hide_mobile %}display: none !important;{% endif %}
        }
      }
    {% endstyle %}
  {% else %}
    <div class="relative z-[1] container mx-auto px-6 max-w-[1092px]">
      <div class="wb-about-text__col relative w-full {{ align_class }}" style="max-width: {{ s.column_width | default: 566 }}px;">
        {% if s.title != blank %}
          <h2 class="wb-about-text__title {{ s.title_style | default: 'display-md' }} wb-about-text__title-size leading-[1.1] uppercase mb-5" style="color: {{ text_color }};{% if title_align != 'inherit' %} text-align: {{ title_align }};{% endif %}">
            {{ title_html }}
          </h2>
        {% endif %}
        {% if s.body != blank %}
          <div class="wb-about-text__body body leading-[1.4]" style="color: {{ text_color }};">
            {{ body_html }}
          </div>
        {% endif %}
      </div>

      {% for block in section.blocks %}
        {% if block.type == 'sticker' and block.settings.on_section != true %}
          {% render 'aw-sticker', block: block %}
        {% endif %}
      {% endfor %}
    </div>
  {% endif %}

  {%- comment -%}
    Optional side image — a masked photo that sits beside the plate and slightly overlaps it.
    The image is shown full-size (side_img_w × side_img_h) inside a smaller window
    (side_width × side_height) offset by side_crop_x / side_crop_y, reproducing a Figma mask crop.
    Skipped in two_col mode, where the image lives inside the plate as its own column.
  {%- endcomment -%}
  {% liquid
    assign side_src = ''
    unless s.two_col
      if s.side_image != blank
        assign side_src = s.side_image | image_url: width: 1200
      elsif s.side_image_preview != blank
        assign side_src = s.side_image_preview | asset_url
      endif
    endunless
  %}
  {% if side_src != blank %}
    <div class="wb-about-text__side absolute overflow-hidden{% if s.side_hide_mobile %} hidden smd:!block{% endif %}"
         style="left: {{ s.side_left | default: '55%' }}; top: {{ s.side_top | default: 0 }}px; width: {{ s.side_width | default: 313 }}px; height: {{ s.side_height | default: 367 }}px; border-radius: {{ s.side_radius | default: 0 }}px; z-index: {{ s.side_z | default: 2 }};{% if s.side_bg != blank %} background: {{ s.side_bg }};{% endif %}">
      <img src="{{ side_src }}" alt="{{ s.side_image.alt }}"
           style="width: {{ s.side_img_w | default: 516 }}px; height: {{ s.side_img_h | default: 689 }}px; max-width: none; object-fit: cover; margin-left: -{{ s.side_crop_x | default: 152 }}px; margin-top: -{{ s.side_crop_y | default: 317 }}px;">
    </div>
  {% endif %}

  {%- comment -%}
    Stickers flagged "on_section" render here (not inside the plate) so they can sit on the side
    image, which lives outside the plate. Positioned as % of the section box, not clipped by the plate.
  {%- endcomment -%}
  {% for block in section.blocks %}
    {% if block.type == 'sticker' and block.settings.on_section == true %}
      {% render 'aw-sticker', block: block %}
    {% endif %}
  {% endfor %}
</div>

{%- comment -%}
  Wrapper-level stacking + spacing on the section's own .shopify-section wrapper. z-index needs
  !important because the theme locks #MainContent > .shopify-section { z-index: 1 } (specificity
  110). margin-top/bottom go on the wrapper (not the inner div) so they actually move the section
  in flow — the inner block padding would otherwise block margin-collapse.
{%- endcomment -%}
{%- if s.wrapper_z != blank or s.section_margin_top != blank or s.section_margin_bottom != blank -%}
  {% style %}
    #shopify-section-{{ section.id }} {
      position: relative;
      {% if s.wrapper_z != blank %}z-index: {{ s.wrapper_z }} !important;{% endif %}
      {% if s.section_margin_top != blank %}margin-top: {{ s.section_margin_top }}px;{% endif %}
      {% if s.section_margin_bottom != blank %}margin-bottom: {{ s.section_margin_bottom }}px;{% endif %}
    }
  {% endstyle %}
{%- endif -%}

{%- comment -%}
  Mobile (< 750px): clear the wrapper's desktop overlap margins / stacking so the sections stack in
  natural order. Same #shopify-section id-specificity as the desktop rule above, emitted later, so
  it wins on mobile only. Desktop is not matched.
{%- endcomment -%}
{% style %}
  @media screen and (max-width: 749px) {
    #shopify-section-{{ section.id }} {
      {% comment %} overlap_mobile (negative) lets a plate tuck up under the photo of the section
         above — e.g. the hero photo overlaps the fridge plate, per the Figma mobile design. {% endcomment %}
      margin-top: {{ s.overlap_mobile | default: 0 }}px !important;
      margin-bottom: {{ s.section_margin_bottom_mobile | default: 0 }}px !important;
      position: relative !important;
      top: auto !important;
      {% comment %} Keep z-index at 1 (the theme's default for a section), NOT auto: the page-background
         paints its blue field at z-0 inside its own z-1 section, so a copy section dropped to z:auto
         would render behind that blue field and vanish. z:1 keeps every section above it. {% endcomment %}
      z-index: 1 !important;
    }
  }
{% endstyle %}

{%- comment -%}
  Keep the title on a single line on desktop (>=750px) for this section only. Scoped to the
  section id so the other shared aw-about-text titles are untouched; mobile is never matched.
{%- endcomment -%}
{%- comment -%}
  The section clips with overflow:hidden so bled plates cannot add a sideways scrollbar. A sticker
  that is meant to straddle the section's edge (e.g. the "super premium" seal sitting above the
  plate) gets cut off by that clip — no z-index can rescue it, since the sticker is simply not
  painted outside the box. Opt this section out of clipping instead. #MainContent keeps its own
  overflow-x: clip, so this cannot introduce horizontal scrolling.
{%- endcomment -%}
{%- if s.overflow_visible -%}
  {% style %}
    .wb-about-text--{{ section.id }} {
      overflow: visible !important;
    }
  {% endstyle %}
{%- endif -%}

{%- comment -%}
  In the design the heading is not confined to the copy column: it sits a little further left and
  runs as wide as it needs (e.g. fridge — copy at x221 w506, heading at x194 w560). Modelling both
  as one fixed column is what forced the heading to wrap and pushed it out of alignment.

  title_nowrap keeps it on one line; title_offset shifts it left of the copy. Desktop only — the
  mobile block overrides the column to full width and centres it, so neither reaches mobile.
{%- endcomment -%}
{%- comment -%}
  The gold call-out is its own, narrower text box in the design (fridge: copy 506 wide, call-out
  440), so it breaks a line earlier than the paragraphs above it. Desktop only.
{%- endcomment -%}
{%- if s.gold_width != blank or s.gold_gap != blank -%}
  {% style %}
    @media screen and (min-width: 750px) {
      .wb-about-text--{{ section.id }} .wb-about-text__body p.text-gold {
        {% if s.gold_width != blank %}max-width: {{ s.gold_width }}px;{% endif %}
        {%- comment -%} In the design the call-out follows the line above with no paragraph gap. {%- endcomment -%}
        {% if s.gold_gap != blank %}margin-top: {{ s.gold_gap }}px !important;{% endif %}
      }
    }
  {% endstyle %}
{%- endif -%}

{%- comment -%}
  The title carries mb-5 in the markup, which is the desktop gap. Mobile sets its own distance to
  the copy below per section (Figma 1694:245), so it needs !important to beat the utility class.
{%- endcomment -%}
{%- if s.title_gap_mobile != blank -%}
  {% style %}
    @media screen and (max-width: 749px) {
      .wb-about-text--{{ section.id }} .wb-about-text__title {
        margin-bottom: {{ s.title_gap_mobile }}px !important;
      }
    }
  {% endstyle %}
{%- endif -%}

{%- comment -%}
  Desktop-only geometry. These are tuned against the 1280 design width, and the row still has to
  fit a 768 tablet, so they start at 1024 rather than at the 750 breakpoint the rest of the row
  layout uses — below that the column and the side image keep their original sizes.
{%- endcomment -%}
{%- if s.col_margin_left != blank or s.side_width_desktop != blank -%}
  {% style %}
    @media screen and (min-width: 1024px) {
      {% if s.col_margin_left != blank %}
        .wb-about-text--{{ section.id }} .wb-about-text__col.flex-1 {
          margin-left: {{ s.col_margin_left }}px;
        }
      {% endif %}
      {% if s.side_width_desktop != blank %}
        .wb-about-text--{{ section.id }} .wb-about-text__img-col {
          width: {{ s.side_width_desktop }}px !important;
        }
      {% endif %}
    }
  {% endstyle %}
{%- endif -%}

{%- if s.title_nowrap or s.title_offset != blank or s.title_offset_tablet != blank -%}
  {% style %}
    @media screen and (min-width: 750px) {
      .wb-about-text--{{ section.id }} .wb-about-text__title {
        {% if s.title_nowrap %}white-space: nowrap;{% endif %}
        {% if s.title_offset != blank %}margin-left: {{ s.title_offset }}px;{% endif %}
      }
    }
    {%- comment -%}
      The desktop offset is measured against the 1280 design width. A tablet plate is ~550px
      narrower, so the same pull to the left lands the heading differently there; this range gets
      its own value. Nowrap is restated so the rule holds even without a desktop offset.
    {%- endcomment -%}
    {%- if s.title_offset_tablet != blank -%}
      @media screen and (min-width: 750px) and (max-width: 1023px) {
        .wb-about-text--{{ section.id }} .wb-about-text__title {
          {% if s.title_nowrap %}white-space: nowrap;{% endif %}
          margin-left: {{ s.title_offset_tablet }}px;
        }
      }
    {%- endif -%}
  {% endstyle %}
{%- endif -%}

{% stylesheet %}
  /* Stacking for the About Us plate overlap: hero (aw-z-2) stays above the plate of the next
     section (aw-z-1), so a plate tucked up under the hero sits behind the photo, not over it. */
  .aw-z-2 { position: relative; z-index: 2; }
  .aw-z-1 { position: relative; z-index: 1; }

  /* Typography comes from the Figma file (WB Website, frames 1653:20 desktop / 1694:245 mobile):
     headings are Kurdis Condensed ExtraBold, body copy Kurdis SemiCondensed SemiBold. Set here
     rather than on the shared display-md/body classes, since these aw-about-* sections are
     About-Us-only. */
  /* Mobile-only line break helper (see body_break_mobile). */
  .wb-br-mobile { display: inline; }

  @media screen and (min-width: 750px) {
    .wb-br-mobile { display: none; }
  }

  .wb-about-text__title {
    font-family: var(--font-kurdis-condensed) !important;
    font-weight: 800 !important;
    line-height: 1.29 !important;
  }

  /* Kurdis Condensed ships a real 400 cut, so the quotation marks land on the regular face rather
     than a synthesised light one. The weight above is !important but sits on the h2; a value
     declared on the span itself beats what the span would otherwise inherit. */
  .wb-about-text__title-quote {
    font-weight: 400;
  }

  /* Mobile-only icon centred above the title (crown over Super Premium). Hidden on desktop via smd:!hidden. */
  .wb-about-text__mobile-icon {
    display: block;
    margin: 0 auto 10px;
  }

  /* Gold underline flourish centred under the copy. */
  .wb-about-text__flourish {
    display: block;
    width: 130px;
    max-width: 70%;
    margin: 16px auto 0;
  }
  .wb-about-text__flourish svg {
    display: block;
    width: 100%;
    height: auto;
  }

  .wb-about-text__body,
  .wb-about-text__body p,
  .wb-about-text__body span,
  .wb-about-text__body strong,
  .wb-about-text__body a {
    font-family: var(--font-kurdis-semi-condensed) !important;
    font-weight: 600 !important;
    font-size: 15px !important;
    line-height: 1.38 !important;
  }

  /* Every emphasised run in the body copy is SemiCondensed Bold, not SemiBold — both the standalone
     lead-ins ("Nearly 100,000,000 cups later…") and the inline runs inside a paragraph
     ("super premium", "more coffee", "better coffee", …). Kept above the gold call-out rule so that
     one, being more specific, still wins. */
  .wb-about-text__body strong {
    font-weight: 700 !important;
  }

  /* The gold in-copy links ("pitched a bold idea", "single greatest invention of mankind ever") carry
     no underline in the Figma file — colour alone marks them, hover included. */
  .wb-about-text__body a.text-gold,
  .wb-about-text__body a.text-gold:hover,
  .wb-about-text__body a.text-gold:focus {
    text-decoration: none !important;
  }

  /* The gold call-out run ("Take inspiration from coffee shop culture…") steps up to the condensed
     display face at a smaller size. */
  .wb-about-text__body .text-gold strong,
  .wb-about-text__body p.text-gold strong {
    font-family: var(--font-kurdis-condensed) !important;
    font-weight: 800 !important;
    font-size: 16px !important;
    line-height: 1.17 !important;
  }

  /* The "Fresh Taste Guarantee." pill is the one run set in the Parslay script face (Figma 1694:518
     — Parslay Regular 24/138%). It restates the size because the body rule above is !important and
     would otherwise flatten the inline 24px the template sets. */
  .wb-about-text__body a[style*="background"],
  .wb-about-text__body span[style*="background"] {
    font-family: Parslay, sans-serif !important;
    font-weight: 400 !important;
    font-size: 24px !important;
    line-height: 1.38 !important;
    /* Figma: the pill is a fixed 328x41 plate with the label centred, not a box that hugs the text
       (the inline padding in the block's HTML would otherwise size it). */
    display: inline-flex !important;
    align-items: center;
    justify-content: center;
    width: 328px;
    max-width: 100%;
    height: 41px;
    /* Parslay sits high in its em box, so the label reads as floating above the middle of the
       plate. Nudge it down without resizing the plate: the height is border-box, so the padding
       eats into the content box instead of growing the pill, and a centred flex line moves by
       half the top padding. --pill-text-drop is the visual shift; the padding doubles it. */
    box-sizing: border-box;
    padding: calc(var(--pill-text-drop, 6px) * 2) 10px 0 !important;
    vertical-align: middle;
  }

  /* A paragraph marked .wb-oneline stays on a single line above the mobile breakpoint — used for
     "Check out our <pill>", which overshoots the fixed copy column by a few px and would otherwise
     wrap the pill onto its own line. The overflow lands on empty plate, so nothing is clipped.
     The mobile rule below re-wraps it, so the stacked layout is unaffected. */
  @media screen and (min-width: 750px) {
    .wb-about-text__body p.wb-oneline {
      white-space: nowrap;
    }
  }

  /* Mobile: the "Fresh Taste Guarantee." pill drops onto its own centred line; body copy gets a
     little extra side padding. */
  @media screen and (max-width: 749px) {
    {%- comment -%} Mobile sizes per Figma 1694:245: body 12px, the pill 18px. {%- endcomment -%}
    .wb-about-text__body a[style*="background"],
    .wb-about-text__body span[style*="background"] {
      /* Figma mobile (1694:518): the pill is a fixed 276x41 plate with the label centred in it,
         not a box that hugs the text. */
      display: flex !important;
      align-items: center;
      justify-content: center;
      width: 276px !important;
      max-width: 100%;
      height: 41px !important;
      box-sizing: border-box;
      padding: calc(var(--pill-text-drop-mobile, 3px) * 2) 10px 0 !important;
      margin: 12px auto 0 !important;
      font-size: 18px !important;
      white-space: nowrap;
    }
    .wb-about-text__body,
    .wb-about-text__body p,
    .wb-about-text__body span,
    .wb-about-text__body strong {
      font-size: 12px !important;
    }
    {%- comment -%} Mobile pulls the gold call-out up against the line that introduces it (QA r80). {%- endcomment -%}
    .wb-about-text__body > p.text-gold {
      margin-top: 0 !important;
    }
    .wb-about-text__body .text-gold,
    .wb-about-text__body p.text-gold,
    .wb-about-text__body .text-gold strong,
    .wb-about-text__body p.text-gold strong {
      font-size: 13px !important;
      line-height: 1.29 !important;
    }
    .wb-about-text__body {
      padding-left: 30px;
      padding-right: 30px;
    }
  }

  .wb-about-text__title-size {
    font-size: var(--font-size) !important;
  }

  @media screen and (max-width: 1023px) {
    .wb-about-text__title-size {
      font-size: var(--font-size-mobile) !important;
    }
  }

  /* Gold highlights and links come from the rich text; keep links underlined, bold runs bold. */
  .wb-about-text__body p + p {
    margin-top: 1rem;
  }

  .wb-about-text__body a {
    text-decoration: underline;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "AW About Text",
  "tag": "section",
  "class": "aw-z-1",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color Scheme",
      "default": "scheme-1"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "info": "Use \\b to force a line break."
    },
    {
      "type": "select",
      "id": "title_style",
      "label": "Title style",
      "options": [
        { "value": "display-md", "label": "Display M (Kurdis Condensed)" },
        { "value": "display-lg", "label": "Display L (Gothic Condensed)" },
        { "value": "h1", "label": "H1" }
      ],
      "default": "display-md"
    },
    {
      "type": "range",
      "id": "font_size",
      "label": "Title size",
      "min": 16,
      "max": 80,
      "step": 1,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "font_size_mobile",
      "label": "Title size mobile",
      "min": 16,
      "max": 80,
      "step": 1,
      "unit": "px",
      "default": 20
    },
    {
      "type": "liquid",
      "id": "body",
      "label": "Body",
      "info": "HTML allowed — gold highlights use <span class=\"text-gold\">."
    },
    {
      "type": "text",
      "id": "mobile_top_icon",
      "label": "Mobile icon above title (asset filename)",
      "info": "Shown centred above the title on mobile only (e.g. ab-crown.png)."
    },
    {
      "type": "number",
      "id": "mobile_top_icon_width",
      "label": "Mobile icon width px"
    },
    {
      "type": "checkbox",
      "id": "bottom_flourish",
      "label": "Gold underline flourish under copy",
      "default": false
    },
    {
      "type": "color",
      "id": "flourish_color",
      "label": "Flourish color",
      "default": "#AF7404"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
