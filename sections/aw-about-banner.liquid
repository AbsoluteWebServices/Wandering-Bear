{% comment %}
  About Us banner — a centred, fixed-width block holding a photo, with a half-width text block
  (heading + paragraph) laid over its left side. Figma: "STARTED WITH A BOX, NOW WE'RE HERE."

  · Section background is a flat colour (cream by default).
  · The block is a fixed px width, centred; its right corners are rounded.
  · The photo fills the block; the text block is a % of the block width, over the left side.
{% endcomment %}

{% liquid
  assign s = section.settings
  assign img_src = ''
  if s.image != blank
    assign img_src = s.image | image_url: width: 1600
  elsif s.image_preview != blank
    assign img_src = s.image_preview | asset_url
  endif

  # Desktop cover image (its own slot so it can be a clean landscape crop, separate from the
  # mobile box photo). Falls back to the base image if no dedicated cover is set.
  assign cover_src = img_src
  if s.desktop_cover_image != blank
    assign cover_src = s.desktop_cover_image | image_url: width: 1600
  elsif s.desktop_cover_preview != blank
    assign cover_src = s.desktop_cover_preview | asset_url
  endif

  # Mobile cover image (own crop). Falls back to the desktop cover if not set.
  assign mobile_cover_src = cover_src
  if s.mobile_cover_image != blank
    assign mobile_cover_src = s.mobile_cover_image | image_url: width: 1200
  elsif s.mobile_cover_preview != blank
    assign mobile_cover_src = s.mobile_cover_preview | asset_url
  endif

  assign radius_l = s.radius_left | default: 0
  assign radius_r = s.radius_right | default: 20
  assign block_radius = radius_l | append: 'px ' | append: radius_r | append: 'px ' | append: radius_r | append: 'px ' | append: radius_l | append: 'px'

  assign overlay_src = ''
  if s.overlay_image != blank
    assign overlay_src = s.overlay_image | image_url: width: 1600
  elsif s.overlay_preview != blank
    assign overlay_src = s.overlay_preview | asset_url
  endif

  assign badge_src = ''
  if s.badge_image != blank
    assign badge_src = s.badge_image | image_url: width: 400
  elsif s.badge_preview != blank
    assign badge_src = s.badge_preview | asset_url
  endif
%}

<div
  class="aw-about-banner spacing-style"
  style="background-color: {{ s.background_color | default: '#F2E6DC' }};{% if s.section_min_height != blank %} min-height: {{ s.section_min_height }}px;{% endif %} --padding-block-start-desktop: {{ s.padding_top | default: 60 }}px; --padding-block-end-desktop: {{ s.padding_bottom | default: 60 }}px; --padding-block-start-mobile: {{ s.padding_top_mobile | default: 32 }}px; --padding-block-end-mobile: {{ s.padding_bottom_mobile | default: 32 }}px; --font-size: {{ s.heading_size | default: 40 }}px; --font-size-mobile: {{ s.heading_size_mobile | default: 28 }}px;"
  {{ section.shopify_attributes }}
>
  <div class="aw-about-banner__block relative mx-auto w-full"
       style="max-width: {{ s.block_width | default: 1024 }}px;">
    {%- comment -%}
      Two ways to fill the frame:

      · desktop_cover — one finished photo dropped straight into the rounded frame. Desktop only:
        mobile keeps the layered treatment below, so the cover image is hidden under 750px.

      · the layered treatment — a photo clipped by the rounded frame plus a transparent cut-out of
        the same shot on top, unclipped, so its subject breaks out above the frame. Both share a
        width and vertical offset so the subjects line up. In cover mode it is hidden on desktop.
    {%- endcomment -%}
    <div class="aw-about-banner__media relative w-full" style="height: {{ s.image_height | default: 500 }}px;">
      <div class="aw-about-banner__frame absolute inset-0 overflow-hidden" style="border-radius: {{ block_radius }};{% if img_src != blank %} --frame-img: url('{{ img_src }}');{% endif %}">
        {% if s.desktop_cover %}
          <img src="{{ cover_src }}" alt="{{ s.image.alt }}" class="aw-about-banner__cover-img aw-about-banner__cover-img--desktop hidden smd:!block absolute inset-0 w-full h-full max-w-none" style="object-fit: cover; object-position: {{ s.desktop_cover_pos | default: 'center' }};" loading="lazy">
        {% endif %}
        {% if img_src != blank %}
          <img src="{{ img_src }}" alt="{{ s.image.alt }}" class="aw-about-banner__frame-img absolute inset-x-0 w-full max-w-none{% if s.desktop_cover %} smd:!hidden{% endif %}" style="top: {{ s.media_img_top | default: 0 }}px;" loading="lazy">
        {% endif %}
      </div>
      {% if overlay_src != blank %}
        {% assign ov_top = s.overlay_top | default: s.media_img_top | default: 0 %}
        {% assign ov_w = s.overlay_width | default: s.block_width | default: 1024 %}
        <img src="{{ overlay_src }}" alt="" class="aw-about-banner__overlay absolute max-w-none z-[2]{% if s.desktop_cover %} smd:!hidden{% endif %}" style="left: {{ s.overlay_left | default: 0 }}px; width: {{ ov_w }}px; top: {{ ov_top }}px;" loading="lazy">
      {% endif %}
    </div>

    {%- comment -%}
      Text below the media. Inside it a half-width card, pushed left, with its right corners
      rounded; the heading + body live in the card. text_card_margin_top (negative) can pull the
      card up over the photo.
    {%- endcomment -%}
    <div class="aw-about-banner__text relative z-[1]"
         style="width: {{ s.text_width | default: '100%' }};{% if s.text_bg != blank %} background: {{ s.text_bg }};{% endif %}">
      {%- comment -%}
        Card = full-width flex column with two children:
        · heading block — half width, cream, right corners rounded, holds the title
        · body block — full width, holds the paragraph
      {%- endcomment -%}
      <div class="aw-about-banner__card {% if s.card_abs %}absolute{% else %}relative{% endif %}"
           style="width: {{ s.card_width | default: '100%' }};{% if s.card_abs %} top: {{ s.card_top | default: '0' }}; left: {{ s.card_left | default: '0' }}; z-index: {{ s.card_z | default: 3 }};{% else %}{% if s.text_card_margin_top != blank %} margin-top: {{ s.text_card_margin_top }}px;{% endif %}{% endif %} display: flex; flex-direction: column; justify-content: {{ s.text_valign | default: 'flex-start' }};">
        {% if s.heading != blank %}
          <div class="aw-about-banner__heading-wrap" style="width: {{ s.text_card_width | default: '50%' }}; padding: {{ s.text_pad_y | default: 40 }}px {{ s.text_pad_x | default: 40 }}px;{% if s.heading_wrap_pad_bottom != blank %} padding-bottom: {{ s.heading_wrap_pad_bottom }}px;{% endif %} border-radius: 0 {{ s.text_card_radius | default: 20 }}px {{ s.text_card_radius | default: 20 }}px 0;{% if s.text_card_bg != blank %} background: {{ s.text_card_bg }};{% endif %}{% if s.heading_gap != blank %} margin-bottom: {{ s.heading_gap }}px;{% endif %}">
            <h2 class="aw-about-banner__title {{ s.heading_style | default: 'display-md' }} aw-about-banner__title-size uppercase" style="color: {{ s.text_color | default: '#1B1B1B' }}; line-height: {{ s.heading_lh | default: 1.09 }};{% if s.title_pad_top != blank %} padding-top: {{ s.title_pad_top }}px;{% endif %}">
              {{ s.heading }}
            </h2>
          </div>
        {% endif %}
        {% if s.body != blank %}
          <div class="aw-about-banner__body-wrap" style="width: {{ s.body_wrap_width | default: '100%' }}; padding: {{ s.body_pad_y | default: 0 }}px {{ s.body_pad_x | default: 40 }}px;">
            <div class="aw-about-banner__body body [&_strong]:font-bold font-semibold font-(font-family:var(--font-kurdis-semi-condensed))!" style="color: {{ s.body_color | default: s.text_color | default: '#1B1B1B' }}; font-size: {{ s.body_size | default: 15 }}px; line-height: {{ s.body_lh | default: 1.38 }};">
              {{ s.body }}
            </div>
          </div>
        {% endif %}
      </div>
    </div>

    {%- comment -%} Decorative badge, absolutely placed on the block (e.g. left edge). {%- endcomment -%}
    {% if badge_src != blank %}
      <img src="{{ badge_src }}" alt="" class="aw-about-banner__badge absolute z-[4] pointer-events-none select-none"
           style="{% if s.badge_right != blank %}right: {{ s.badge_right }};{% else %}left: {{ s.badge_left | default: '0' }};{% endif %} top: {{ s.badge_top | default: '0' }}; width: {{ s.badge_width | default: 112 }}px;{% if s.badge_rotate != blank %} transform: rotate({{ s.badge_rotate }}deg);{% endif %}" loading="lazy">
    {% endif %}
  </div>
</div>

{%- comment -%}
  Wrapper-level positioning + stacking, all on the .shopify-section wrapper (a margin on the inner
  div won't move the section, its block padding blocks margin-collapse). z-index needs !important
  to beat the theme's #MainContent > .shopify-section { z-index: 1 } lock.
  · section_abs — take the banner out of flow (position:absolute, full width) and place it with
    section_abs_top, relative to #MainContent. Following sections flow up under it.
  · section_margin_top — in-flow overlap of the section above (negative = up).
{%- endcomment -%}
{%- if s.section_abs or s.wrapper_z != blank or s.section_margin_top != blank -%}
  {% style %}
    #shopify-section-{{ section.id }} {
      {% if s.section_abs %}position: absolute !important; left: 0; right: 0; top: {{ s.section_abs_top | default: 0 }}px;{% else %}position: relative;{% endif %}
      {% if s.wrapper_z != blank %}z-index: {{ s.wrapper_z }} !important;{% endif %}
      {% if s.section_margin_top != blank and s.section_abs != true %}margin-top: {{ s.section_margin_top }}px;{% endif %}
    }
  {% endstyle %}
{%- endif -%}

{%- comment -%}
  Mobile (< 750px): the banner is authored for desktop with the section taken out of flow
  (section_abs, top 1850px), the photo cropped by a big negative offset, a cut-out overlay breaking
  out of the top, and the text card lifted over the photo. None of that survives a narrow screen, so
  on mobile it collapses to a clean vertical block: section back in flow, photo shown whole in its
  rounded frame, breakout overlay hidden, and the heading/body card sitting below the photo.
  Desktop (>=750px) is not matched by this query.
{%- endcomment -%}
{% style %}
  @media screen and (max-width: 749px) {
    #shopify-section-{{ section.id }} {
      position: relative !important;
      top: auto !important;
      left: auto !important;
      right: auto !important;
      margin-top: {{ s.section_margin_top_mobile | default: 0 }}px !important;
    }
    {% comment %} Mobile: keep the desktop layering — the box photo clipped inside the rounded frame,
       the transparent cut-out over it breaking out — at mobile scale. BOTH images share the same
       width + top so they stay perfectly aligned as one subject. media_scale_mobile is the zoom
       (bigger = more scale), media_top_mobile the vertical framing, media_height_mobile the frame. {% endcomment %}
    {%- comment -%}
      media_aspect_mobile sizes the frame from the artwork's own ratio instead of a fixed height, so
      a cut-out fits whole at any phone width. Falls back to media_height_mobile.
    {%- endcomment -%}
    .aw-about-banner__media {
      {% if s.media_aspect_mobile != blank %}
        aspect-ratio: {{ s.media_aspect_mobile }} !important;
        height: auto !important;
      {% else %}
        height: {{ s.media_height_mobile | default: 300 }}px !important;
      {% endif %}
      overflow: visible !important;
    }
    .aw-about-banner__frame {
      position: absolute !important;
      inset: 0 !important;
      overflow: hidden !important;
      {%- comment -%}
        Optional: round every corner on mobile. Off by default — the layered artwork carries its own
        rounding, so this is only wanted when a plain rectangular photo fills the frame.
      {%- endcomment -%}
      {% if s.media_radius_mobile != blank %}border-radius: {{ s.media_radius_mobile }}px !important;{% endif %}
    }
    {%- comment -%}
      The cut-out overlay lives OUTSIDE the clipping frame so its subject can break out on desktop.
      At mobile sizes that breakout is 365px tall against a ~300px frame, so it escaped upwards and
      covered the copy of the section above. Mobile shows the photo inside the frame instead.
    {%- endcomment -%}
    .aw-about-banner__overlay {
      display: none !important;
    }
    .aw-about-banner__frame-img {
      display: block !important;
      position: absolute !important;
      left: {{ s.media_left_pct_mobile | default: '50%' }} !important;
      {%- comment -%} media_left_mobile nudges the artwork sideways inside the frame — a cut-out is
         not centred on its own bounding box, so its straight edge may need pushing to the screen
         edge. Positive = right. {%- endcomment -%}
      transform: translateX(calc(-50% + {{ s.media_left_mobile | default: 0 }}px)) !important;
      width: {{ s.media_scale_mobile | default: '125%' }} !important;
      top: {{ s.media_top_mobile | default: -365 }}px !important;
      max-width: none !important;
      height: auto !important;
    }
    .aw-about-banner__overlay {
      z-index: 2 !important;
    }
    .aw-about-banner__badge {
      display: none !important;
    }
    .aw-about-banner__card {
      position: relative !important;
      top: auto !important;
      left: auto !important;
      width: 100% !important;
      margin-top: {{ s.card_margin_top_mobile | default: 20 }}px !important;
      align-items: center !important;
      {% comment %} Side padding lives on the card (parent) on mobile; the inner wraps are flush. {% endcomment %}
      padding-left: {{ s.text_pad_x_mobile | default: 40 }}px !important;
      padding-right: {{ s.text_pad_x_mobile | default: 40 }}px !important;
    }
    .aw-about-banner__heading-wrap {
      width: 100% !important;
      border-radius: 0 !important;
      {% comment %} On mobile the heading is centred text on the page background, not the half-width cream tab. {% endcomment %}
      background: transparent !important;
      text-align: center !important;
      padding-left: 0 !important;
      padding-right: 0 !important;
      {% comment %} The desktop vertical rhythm (text_pad_y / heading_wrap_pad_bottom / heading_gap) is
         set inline, so it leaks into mobile. Pin the mobile values here; the defaults are what mobile
         rendered before the desktop spacing was tightened. {% endcomment %}
      padding-top: {{ s.text_pad_y_mobile | default: 40 }}px !important;
      padding-bottom: {{ s.heading_wrap_pad_bottom_mobile | default: 10 }}px !important;
      margin-bottom: {{ s.heading_gap_mobile | default: 20 }}px !important;
    }
    .aw-about-banner__title {
      text-align: center !important;
      padding-top: {{ s.title_pad_top_mobile | default: 120 }}px !important;
      line-height: {{ s.heading_lh | default: 1.09 }} !important;
      color: {{ s.text_color | default: '#1B1B1B' }} !important;
    }
    .aw-about-banner__body-wrap {
      width: 100% !important;
      padding-left: 0 !important;
      padding-right: 0 !important;
    }
    .aw-about-banner__body {
      text-align: center !important;
    }
  }
{% endstyle %}

{%- comment -%}
  Tablet nudge for the heading tab. The card is pinned to the photo with a fixed negative top, but
  the cover photo is a different crop at tablet widths, so the tab can sit a couple of px high
  against the notch. Relative offset only — it does not reflow the body below it.
{%- endcomment -%}
{%- if s.heading_offset_tablet != blank -%}
  {% style %}
    @media screen and (min-width: 750px) and (max-width: 1023px) {
      #shopify-section-{{ section.id }} .aw-about-banner__heading-wrap {
        position: relative;
        top: {{ s.heading_offset_tablet }}px;
      }
    }
  {% endstyle %}
{%- endif -%}

{%- comment -%}
  Cover mode renders neither the overlay nor the offset frame image, so only the decorative badge
  still needs hiding here.
{%- endcomment -%}
{%- if s.desktop_cover -%}
  {% style %}
    {%- comment -%} The decorative badge is part of the layered treatment, so cover mode drops it —
       unless it is explicitly kept (the Figma desktop frame still shows the BOXED COLD BREW CLUB
       sticker on the right edge of the photo). {%- endcomment -%}
    {% unless s.badge_show_in_cover %}
      #shopify-section-{{ section.id }} .aw-about-banner__badge {
        display: none !important;
      }
    {% endunless %}
  {% endstyle %}
{%- endif -%}

{% stylesheet %}
  /* About Us is set in regular Kurdis, not the theme's default Condensed display face. Override
     locally (banner is About-Us-only) instead of touching the shared display-md/body classes. */
  /* Figma 1653:20 — heading is Kurdis Condensed ExtraBold at 109% leading. */
  .aw-about-banner__title {
    font-family: var(--font-kurdis-condensed) !important;
    font-weight: 800 !important;
  }

  .aw-about-banner__body,
  .aw-about-banner__body p,
  .aw-about-banner__body span,
  .aw-about-banner__body strong,
  .aw-about-banner__body a {
    font-family: var(--font-kurdis-semi-condensed) !important;
  }

  /* Mobile drops the body to 13px (Figma 1694:245). */
  /* Mobile wants "Find us nationwide" to start a new paragraph. The copy comes from an html setting
     that Shopify sanitises (no class attributes, so no taggable <br>), and the run is already the
     only <strong> in the block — so inject the break with a pseudo-element. The <strong> itself
     stays inline, which keeps "at Whole Foods..." flowing on after it. */
  @media screen and (max-width: 749px) {
    .aw-about-banner__body strong::before {
      content: "\A\A";
      white-space: pre;
    }
  }

  @media screen and (max-width: 749px) {
    .aw-about-banner__body,
    .aw-about-banner__body p,
    .aw-about-banner__body strong {
      font-size: 13px !important;
    }
  }

  /* Figma: body copy is Kurdis SemiCondensed SemiBold (600); the "Find us nationwide" run steps up
     to Bold (700). Set explicitly so the weight does not fall back to the theme's default. */
  .aw-about-banner__body,
  .aw-about-banner__body p {
    font-weight: 600;
  }

  /* The badge hangs 31px off the right edge of the 987px block. That overhang only exists while the
     viewport is wider than the block plus the overhang; on tablet the block fills the screen and the
     badge gets clipped, so pull it back flush with the photo. */
  @media screen and (min-width: 750px) and (max-width: 1049px) {
    .aw-about-banner__badge {
      right: 0 !important;
    }
  }

  /* Figma 1694:518 breaks this paragraph after "exciting" and after "protein"; everything after that
     wraps on its own inside the 603px column. Mobile centres the copy across the full width, where
     hard breaks would read as ragged, so they only apply from the desktop breakpoint up. */
  .aw-about-banner__body br {
    display: none;
  }

  @media screen and (min-width: 750px) {
    .aw-about-banner__body br {
      display: inline;
    }
  }

  .aw-about-banner__body strong {
    font-weight: 700;
  }

  .aw-about-banner__title-size {
    font-size: var(--font-size) !important;
  }
  @media screen and (max-width: 749px) {
    .aw-about-banner__title-size {
      font-size: var(--font-size-mobile) !important;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "AW About Banner",
  "tag": "section",
  "settings": [
    { "type": "color", "id": "background_color", "label": "Section background", "default": "#F2E6DC" },
    { "type": "number", "id": "section_min_height", "label": "Section min height px" },
    { "type": "number", "id": "section_margin_top", "label": "Section margin-top px (negative = overlap section above)" },
    { "type": "number", "id": "media_height_mobile", "label": "Mobile media height px" },
    { "type": "number", "id": "media_radius_mobile", "label": "Mobile media corner radius px" },
    { "type": "text", "id": "media_left_pct_mobile", "label": "Media anchor — mobile (e.g. 60%)" },
    { "type": "text", "id": "media_left_mobile", "label": "Media horizontal nudge — mobile px" },
    { "type": "number", "id": "title_pad_top_mobile", "label": "Title padding-top — mobile px" },
    { "type": "number", "id": "text_pad_y_mobile", "label": "Heading block padding-top — mobile px" },
    { "type": "number", "id": "heading_wrap_pad_bottom_mobile", "label": "Heading block padding-bottom — mobile px" },
    { "type": "number", "id": "heading_gap_mobile", "label": "Gap heading→body — mobile px" },
    { "type": "number", "id": "card_margin_top_mobile", "label": "Card margin-top — mobile px" },
    { "type": "number", "id": "text_pad_x_mobile", "label": "Card padding X — mobile px" },
    { "type": "number", "id": "media_top_mobile", "label": "Media image top — mobile px" },
    { "type": "text", "id": "media_scale_mobile", "label": "Media image width — mobile (e.g. 125%)" },
    { "type": "number", "id": "section_margin_top_mobile", "label": "Section margin-top — mobile px" },
    { "type": "text", "id": "media_aspect_mobile", "label": "Mobile frame aspect (e.g. 4 / 3)" },
    { "type": "text", "id": "media_zoom_mobile", "label": "Mobile frame bg-size (e.g. cover, 150%)" },
    { "type": "text", "id": "media_pos_mobile", "label": "Mobile frame bg-position (e.g. center 22%)" },
    { "type": "text", "id": "overlay_left_mobile", "label": "Mobile overlay left (e.g. 50%)" },
    { "type": "number", "id": "overlay_top_mobile", "label": "Mobile overlay top px" },
    { "type": "text", "id": "overlay_width_mobile", "label": "Mobile overlay width (e.g. 100%)" },
    { "type": "checkbox", "id": "section_abs", "label": "Absolute position (out of flow)", "default": false },
    { "type": "number", "id": "section_abs_top", "label": "Absolute top px (from MainContent)", "visible_if": "{{ section.settings.section_abs }}" },
    { "type": "number", "id": "wrapper_z", "label": "Wrapper z-index" },
    { "type": "number", "id": "block_width", "label": "Block width px" },
    { "type": "number", "id": "image_height", "label": "Image block height px" },
    { "type": "image_picker", "id": "image", "label": "Background image (in frame)" },
    { "type": "text", "id": "image_preview", "label": "Background preview asset (dev only)" },
    { "type": "number", "id": "media_img_top", "label": "Image vertical offset px (negative = up)" },
    { "type": "image_picker", "id": "overlay_image", "label": "Cut-out overlay (breaks out top)" },
    { "type": "text", "id": "overlay_preview", "label": "Overlay preview asset (dev only)" },
    { "type": "number", "id": "overlay_left", "label": "Overlay left px" },
    { "type": "number", "id": "overlay_width", "label": "Overlay width px" },
    { "type": "number", "id": "overlay_top", "label": "Overlay top px (negative = up)" },
    { "type": "number", "id": "radius_left", "label": "Radius left px" },
    { "type": "number", "id": "radius_right", "label": "Radius right px" },
    { "type": "checkbox", "id": "desktop_cover", "label": "Desktop: single cover image (hide breakout overlay)", "default": false },
    { "type": "image_picker", "id": "desktop_cover_image", "label": "Desktop cover image (blank = use main image)" },
    { "type": "text", "id": "desktop_cover_preview", "label": "Desktop cover preview asset (dev only)" },
    { "type": "text", "id": "desktop_cover_pos", "label": "Desktop cover position (e.g. center, center 60%)" },
    { "type": "image_picker", "id": "mobile_cover_image", "label": "Mobile cover image (blank = use desktop cover)" },
    { "type": "text", "id": "mobile_cover_preview", "label": "Mobile cover preview asset (dev only)" },
    { "type": "text", "id": "mobile_cover_pos", "label": "Mobile cover position (e.g. center, center 55%)" },
    { "type": "header", "content": "Text block" },
    { "type": "text", "id": "text_width", "label": "Text wrapper width (e.g. 100%)" },
    { "type": "text", "id": "text_bg", "label": "Text wrapper background (blank = transparent)" },
    { "type": "header", "content": "Text card (heading block + body block)" },
    { "type": "text", "id": "card_width", "label": "Card wrapper width (e.g. 100%)" },
    { "type": "text", "id": "text_card_width", "label": "Heading block width (e.g. 50%)" },
    { "type": "text", "id": "text_card_bg", "label": "Card background (blank = transparent)" },
    { "type": "number", "id": "text_card_radius", "label": "Card right corner radius px" },
    { "type": "number", "id": "text_card_margin_top", "label": "Card margin-top px (flow mode)" },
    { "type": "checkbox", "id": "card_abs", "label": "Card absolute (free placement)", "default": false },
