{% liquid
    assign color_scheme = section.settings.color_scheme
    assign background_image = section.settings.background_image
    assign background_image_mobile = section.settings.background_image_mobile
    assign floating_image = section.settings.floating_image
    assign floating_image_mobile = section.settings.floating_image_mobile
    assign title_type = section.settings.title_type
    assign title = section.settings.title
    assign title_image = section.settings.title_image
    assign title_image_mobile = section.settings.title_image_mobile
    assign title_alt = section.settings.title_alt
    assign description = section.settings.description
    assign bulletpoints = section.blocks | where: "type", "bulletpoint"
    assign button_label = section.settings.button_label
    assign button_link = section.settings.button_link
    assign badge = section.settings.badge
    assign section_header = section.settings.section_header
%}

{% capture title_styles %}
    --font-size: {{ section.settings.font_size }}px;
    --font-size-mobile: {{ section.settings.font_size_mobile }}px;
{% endcapture %}

<div class="seo-hidden">{{ section_header }}</div>

<div class="relative w-full pb-2 md:!pb-0" style="background-color: {{ color_scheme.background }}">
    <svg preserveAspectRatio="none" class="hidden md:block absolute top-0 md:-top-5 left-0 w-full z-[2]" xmlns="http://www.w3.org/2000/svg" width="1290" height="28" viewBox="0 0 1290 28" fill="none">
        <path d="M1290 27.249L970 28L352 21.9804L3.62444e-07 23.854L2.44783e-06 -1.16568e-06L1290 0.00011161L1290 27.249Z" fill="{{ color_scheme.settings.background }}"/>
    </svg>
   
    {% liquid
        assign bg_mobile = background_image_mobile | default: background_image
        assign fg_mobile = floating_image_mobile | default: floating_image
    %}
    {% capture bg_sources %}
        <source media="(max-width: 749px)" srcset="{{ bg_mobile | image_url: width: 480 }} 480w, {{ bg_mobile | image_url: width: 768 }} 768w, {{ bg_mobile | image_url: width: 1080 }} 1080w" sizes="100vw">
        <source srcset="{{ background_image | image_url: width: 1024 }} 1024w, {{ background_image | image_url: width: 1536 }} 1536w, {{ background_image | image_url: width: 1920 }} 1920w" sizes="100vw">
    {% endcapture %}
    {% capture fg_sources %}
        <source media="(max-width: 1023px)" srcset="{{ fg_mobile | image_url: width: 400 }} 400w, {{ fg_mobile | image_url: width: 600 }} 600w, {{ fg_mobile | image_url: width: 800 }} 800w" sizes="70vw">
        <source srcset="{{ floating_image | image_url: width: 500 }} 500w, {{ floating_image | image_url: width: 800 }} 800w, {{ floating_image | image_url: width: 1100 }} 1100w" sizes="(min-width: 1024px) 50vw, 70vw">
    {% endcapture %}
    {% render 'picture', sources: bg_sources, source: background_image, mobile_source: background_image_mobile, class: 'w-full !h-full object-cover !max-w-none absolute inset-0', alt: background_image.alt %}
    {% if floating_image != blank %}
        {% render 'picture', sources: fg_sources, source: floating_image, mobile_source: floating_image_mobile, class: 'bottom-7 md:-bottom-2 max-w-[80vw] sm:!max-w-[50vw] md:!max-h-[600px] object-contain absolute right-0 z-[2] md:!w-min lg:!w-auto !flex justify-end', alt: floating_image.alt %}
    {% endif %}
    <div class="container max-w-[1000px] px-4 mx-auto lg:relative z-[2] pt-10 lg:!pt-[60px] pb-[458px] md:!pb-20">
        <div class="relative z-[3] md:!w-1/2 wb-flex flex-col max-w-[263px] md:!max-w-[457px] mx-auto md:!mx-0">
            <div class="flex flex-col mb-6 md:!mb-3 relative md:left-0">
                {% if badge != blank %}
                    {{ badge | image_url: width: 100 | image_tag: class: 'absolute z-[2] -top-[30px] -left-[30px] !w-[60px] !h-auto shadow-button', loading: 'eager', preload: 'eager' }}
                {% endif %}
                {% if title_type == 'text' %}
                    <h2 class="h2 title-text !leading-[1.1]" style="color: {{ color_scheme.settings.foreground }}; {{ title_styles }}">{{ title | replace: '\b', '<br>' }}</h2>
                {% elsif title_type == 'image' %}
                    {% render 'title-image', image: title_image, image_mobile: title_image_mobile, alt: title_alt, class: '!max-w-[246px] md:!max-w-[438px] mx-auto md:!mx-0 w-full max-h-full object-contain' %}
                {% endif %}
            </div>
            {% if description != blank %}
            <div class="hidden md:block font-kurdis-semi-condensed font-bold mb-[35px] text-xl leading-[22px]">
                {{ description | replace: '\b', '<br>' }}
            </div>
            {% endif %}
            <div class="wb-flex leading-[16px] flex-col gap-3.5 md:gap-4 items-center md:pb-0 md:items-start">
            {% for bullet in bulletpoints %}
                <div class="inline !leading-[16px] text-center md:text-left md:flex gap-2">
                    {% if bullet.settings.image != blank %}
                        {{ bullet.settings.image | image_url: width: 20 | image_tag: class: '!h-4 !w-4 !inline-block md:!flex', alt: bullet.settings.title }}
                    {% endif %}
                    {% if bullet.settings.title != blank %}
                        <span class="body font-semibold !text-base !leading-[16px] text-center md:!text-left">{{ bullet.settings.title }}</span>
                    {% endif %}
                </div>
            {% endfor %}
            {% if button_label != blank and button_link != blank %}
                {% render 'wb-button', 
                style: 'custom', 
                button_bg: color_scheme.settings.primary_button_background,
                button_text: color_scheme.settings.primary_button_text,
                button_hover_bg: color_scheme.settings.primary_button_hover_background,
                button_hover_text: color_scheme.settings.primary_button_hover_text,
                class: 'mt-2 md:!mt-4 z-[3] !w-[266px] !h-[51px]', width: 253, height: 49, label: button_label, link: button_link %}
            {% endif %}
            </div>
        </div>
    </div>
    <svg preserveAspectRatio="none" class="absolute -bottom-0.5 left-0 w-full z-[3]" xmlns="http://www.w3.org/2000/svg" width="1280" height="18" viewBox="0 0 1280 18" fill="none">
        <path d="M0 0L670 5.33019L1280 0V18H0V0Z" fill="{{ color_scheme.settings.background }}"/>
    </svg>
</div>

{% style %}
    .title-text {
        font-size: var(--font-size);
    }

    @media (max-width: 1024px) {
        .title-text {
            font-size: var(--font-size-mobile);
        }
    }
{% endstyle %}

{% schema %}
    {
        "name": "Floating Image",
        "settings": [
            {
                "type": "color_scheme",
                "id": "color_scheme",
                "label": "Color Scheme",
                "default": "scheme-1"
            },
            {
                "type": "image_picker",
                "id": "background_image",
                "label": "Background Image"
            },
            {
                "type": "image_picker",
                "id": "background_image_mobile",
                "label": "Background Image Mobile"
            },
            {
                "type": "image_picker",
                "id": "floating_image",
                "label": "Floating Image"
            },
            {
                "type": "image_picker",
                "id": "floating_image_mobile",
                "label": "Floating Image Mobile"
            },
            {
                "type": "image_picker",
                "id": "badge",
                "label": "Badge"
            },
            {
                "type": "select",
                "id": "title_type",
                "label": "Title Type",
                "options": [
                    {
                        "value": "text",
                        "label": "Text"
                    },
                    {
                        "value": "image",
                        "label": "Image"
                    }
                ],
                "default": "text"
            },
            {
                "type": "text",
                "id": "title",
                "label": "Title",
                "visible_if": "{{ section.settings.title_type == 'text' }}",
                "info": "Add '\\b' for line breaks"
            },
            {
                "type": "range",
                "id": "font_size",
                "label": "Font Size",
                "min": 16,
                "max": 100,
                "step": 1,
                "unit": "px",
                "default": 24,
                "visible_if": "{{ section.settings.title_type == 'text' }}"
            },
            {
                "type": "range",
                "id": "font_size_mobile",
                "label": "Font Size Mobile",
                "min": 16,
                "max": 100,
                "step": 1,
                "unit": "px",
                "default": 24,
                "visible_if": "{{ section.settings.title_type == 'text' }}"
            },
            {
                "type": "image_picker",
                "id": "title_image",
                "label": "Title Image",
                "visible_if": "{{ section.settings.title_type == 'image' }}"
            },
            {
                "type": "image_picker",
                "id": "title_image_mobile",
                "label": "Title Image Mobile",
                "visible_if": "{{ section.settings.title_type == 'image' }}"
            },
            {
                "type": "text",
                "id": "title_alt",
                "label": "Title Alt",
                "visible_if": "{{ section.settings.title_type == 'image' }}"
            },
            {
                "type": "text",
                "id": "description",
                "label": "Description",
                "default": "We reimagined how delicious a canned latte could taste."
            },
            {
                "type": "text",
                "id": "button_label",
                "label": "Button Label"
            },
            {
                "type": "url",
                "id": "button_link",
                "label": "Button Link"
            },
            {
                "type": "header",
                "content": "SEO"
            },
            {
                "type": "richtext",
                "id": "section_header",
                "label": "Section Header",
                "info": "This is a hidden SEO field that will be used to display the section header in the search results"
            }
        ],
        "blocks": [
            {
                "type": "bulletpoint",
                "name": "Bulletpoint",
                "settings": [
                    {
                        "type": "image_picker",
                        "id": "image",
                        "label": "Image"
                    },
                    {
                        "type": "text",
                        "id": "title",
                        "label": "Title"
                    }
                ]
            }
        ],
        "presets": [
            {
                "name": "Floating Image"
            }
        ]
    }
{% endschema %}