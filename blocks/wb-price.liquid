

{%- liquid
  assign block_settings = block.settings
  assign product_resource = closest.product
  assign selected_variant = product_resource.selected_or_first_available_variant
-%}

{% liquid
  if block_settings.type_preset == 'rte' or block_settings.type_preset == 'paragraph'
    assign is_rte = true
  endif

  capture text_block_classes
    if block_settings.width == '100%'
      echo 'text-block--align-' | append: block_settings.alignment
      if block_settings.max_width == 'none'
        echo ' text-block--full-width'
      endif
    endif
    if block_settings.type_preset == 'custom'
      echo ' custom-typography'
      if block_settings.font_size != ''
        echo ' custom-font-size'
      endif
      if block_settings.color != ''
        echo ' custom-color'
      endif
    endif
    if block_settings.background
      echo ' text-block--background'
    endif
    if is_rte
      echo ' rte'
    endif
  endcapture
%}

{% assign product_data = product_resource.metafields.custom.product_group.value %}
{% assign multi_unit_quantity = product_data.multi_unit_product_quantity %}
{% assign last_variant_index = product_resource.variants.size | minus: 1 %}


{%- liquid
  # "N Pack from" price. For 32oz bundles the pack is built from the per-carton
  # bundle_unit SKU (variants.first.metafields.custom.bundle_unit), so the correct
  # figure is that SKU's Autoship (1 Month) price × the pack quantity
  assign autoship_qty = multi_unit_quantity | default: 1
  assign autoship_price_min = nil
  assign bundle_unit_variant = product_resource.variants.first.metafields.custom.bundle_unit.value
  if bundle_unit_variant != blank
    for allocation in bundle_unit_variant.selling_plan_allocations
      if allocation.selling_plan.name contains '1 Month'
        assign candidate = allocation.price | times: autoship_qty
        if autoship_price_min == nil or candidate < autoship_price_min
          assign autoship_price_min = candidate
        endif
      endif
    endfor
  endif
  # Fallback for products without a bundle_unit: cheapest 1 Month allocation, then
  # the regular price_min.
  if autoship_price_min == nil
    for variant in product_resource.variants
      for allocation in variant.selling_plan_allocations
        if allocation.selling_plan.name contains '1 Month'
          if autoship_price_min == nil or allocation.price < autoship_price_min
            assign autoship_price_min = allocation.price
          endif
        endif
      endfor
    endfor
  endif
  if autoship_price_min == nil
    assign autoship_price_min = product_resource.price_min
  endif
-%}

  <product-price>
    {% if multi_unit_quantity > 1 %}
      <span class="price">{{ multi_unit_quantity }} Pack from {{ autoship_price_min | money }}</span>
    {% else %}
      <span class="price">From {{ autoship_price_min | money }}</span>
    {% endif %}
  </product-price>
